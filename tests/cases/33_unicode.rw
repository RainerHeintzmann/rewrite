# Unicode names: UTF-8 characters are letters, and LaTeX-like names as in
# Julia (\alpha, \_1) are replaced on input; the output prints the
# characters, and grids are aligned by characters, not bytes.
INC "inc/all"
SYM a, b : real
SYM α, \beta, x\_1 : real
α + 2*\beta
REWR Dt(sin(\alpha^2), α) : All
α = 3
α*2
TYPEOF α
TYPEOF x₁
SYM \theta : real
[[\theta, 1], [22, \theta^2]]
# a name followed by a letter is no name: \alphax stays
PRT "\alphax and \alpha and \hbar\n"
# Unicode operators are tokens of their own, also between numbers and
# names; inc/alg gives them their meaning with ALIAS (2026)
3×4, 12÷4−1, 2·5, 3\times 4
2≤3, 3≥4, 2≠2, (1≤2)∧(2≤1), (1≤2)∨(2≤1), ¬(1≤2)
√16, \sqrt(9), π
REWR Dt(x^2−3×x,x) : All
REWR (a≤b) : All
SYM x² : real
x² = 4
x²×2
ALIAS "⊕" = "+"
2⊕3
