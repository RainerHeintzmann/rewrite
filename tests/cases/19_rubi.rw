# Integration with the rules translated automatically from Rubi
# (inc/integration/rubi, made by tools/rubi2rewrite.py).
# Each integral is printed, then checked numerically:
# |D(result,x) - integrand| at x = 0.7 must be below 1e-7 (prints true).
INC "inc/all"
TERM FF,GG,HH : real
SYM yy : real
x = yy
FF = REWR Int(x^2,x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = x^2
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(1/(2*x+3),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = 1/(2*x+3)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(x*exp(2*x),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = x*exp(2*x)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(1/(1+x^2),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = 1/(1+x^2)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(ln(x),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = ln(x)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(x*sin(x),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = x*sin(x)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(sqrt(1-x^2),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = sqrt(1-x^2)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(1/sqrt(1-x^2),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = 1/sqrt(1-x^2)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(sin(x)^2,x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = sin(x)^2
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(sin(3*x)^4,x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = sin(3*x)^4
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(x/(1+x^4),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = x/(1+x^4)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(sqrt(x)/(1+x),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = sqrt(x)/(1+x)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(1/(1+x^3),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = 1/(1+x^3)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(x*sqrt(1+x),x) : RubiIntegrate
FF
GG = REWR D(FF,x) : All
HH = x*sqrt(1+x)
x = 0.7
abs(GG-HH) < 1e-7
x = yy
FF = REWR Int(x^2/(2+3*x)^1.5,x) : RubiIntegrate
