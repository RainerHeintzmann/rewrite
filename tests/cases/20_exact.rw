# Exact numbers (inc/exact): sorts integer and rational with GMP, subsorts
# integer < rational < real (SUBSORT), integer literals (INTNUM).
INC "inc/all"
# ---- arithmetic stays exact
1/3 + 1/6
2/4
3*(1/3)
(2/3)^-2
2^-3
2^100
25!
7 - 10
-(1/2)
abs(-7/3)
numer(6/4), denom(6/4)
mod(-7,3), quot(-7,3)
# ---- comparisons
7/2 > 3
1/3 == 2/6
2 == 2.0
# ---- widening to real
1/3 + 0.5
sin(1/2)
2^(1/2)
# ---- division by zero stays a term
1/0
# ---- assignment to a real constant and loops
SYM z : real
z = 3/4
z
z*4
SYM sumk : real
sumk = 0
SYM kk : real
FOR kk = 1 TO 4 DO sumk = sumk + kk
sumk
# ---- rules for real apply to the exact sorts (LIFT)
TERM T1 : real
SYM yy : real
x = yy
T1 = REWR x*1 + 0*x + (1/2)*x : All
T1
T1 = REWR Dt(x^3/3,x) : All
T1
# ---- sorts with a known sign (nonneg, positive) and natural numbers
2+3, 2-5, 2^10, 2^-1
SYM tn : nonneg
SYM tp : positive
T1 = REWR sqrt(tn^2) + (tn^2)^(1/2) : All
T1
T1 = REWR sqrt(x^2) : All
T1
T1 = REWR ln(tp*x) : All
T1
T1 = REWR ln(x*yy) : All
T1
T1 = REWR abs(tn) : All
T1
tn = 9
sqrt(tn), tn+1
# ---- exact roots: perfect powers are numbers, the rest stays a term
#      in Mathematica's normal form; a real number makes it numeric
T1 = REWR x*4^(1/2) + x*8^(1/3) : All
T1
T1 = REWR x*8^(1/2) : All
T1
T1 = REWR x*(4/3)^(1/2) : All
T1
T1 = REWR x*2^(3/2) : All
T1
T1 = REWR x*(2^(1/2))^2 : All
T1
T1 = REWR x*2^(1/2)*0.5 : All
T1
T1 = REWR Dt(x^2*(2+3^(1/2)),x) : All
T1
