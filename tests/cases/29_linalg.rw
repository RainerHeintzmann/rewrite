# Symbolic matrices on lists (inc/linalg, symmat.c): transpose, dot,
# identity, det, linsolve, inverse with Bareiss' fraction-free elimination,
# and arithmetic on lists element by element (thread, Listable).
INC "inc/all"
SYM a, b, n : real
FUNC never : real >> real
ALG raw
PAT X : real
SPEC raw : never(X) = X
SYM g,p,qq,r,ss,t,u,v,w : real
TERM AA : matrix
# ---- structure
REWR transpose([[a,b,g],[1,2,3]]) : raw
REWR identity(3) : raw
REWR dot([[a,b],[g,n]],[[p,qq],[r,ss]]) : raw
REWR dot([[a,b],[g,n]],[x,y]) : raw
REWR dot([a,b],[x,y]) : raw
# ---- determinants
REWR det([[1,2],[3,4]]) : raw
REWR det([[a,b],[g,n]]) : raw
REWR det([[a,b,g],[n,p,qq],[r,ss,t]]) : raw
REWR det([[1,2],[2,4]]) : raw
REWR det([[1,x,x^2],[1,y,y^2],[1,z,z^2]]) : raw
REWR det([[a,b,g,n],[p,qq,r,ss],[t,u,v,w],[x,y,z,1]]) : raw
# ---- linear systems and inverses (exact: a polynomial gcd in one atom cancels)
REWR linsolve([[2,1],[1,3]],[3,5]) : raw
REWR linsolve([[2,1,-1,3],[1,-2,4,0],[3,1,1,-1],[1,1,1,1]],[1,2,3,4]) : raw
REWR linsolve([[a,b],[g,n]],[p,qq]) : raw
REWR linsolve([[a,1,1],[1,a,1],[1,1,a]],[1,1,1]) : raw
REWR linsolve([[2*a,0],[0,4*b]],[2,6]) : raw
REWR linsolve([[1,1],[1,-1]],[a,b]) : raw
REWR inverse([[a,b],[g,n]]) : raw
REWR inverse([[1,2,3],[0,1,4],[5,6,0]]) : raw
REWR inverse([[1,a],[a,1]]) : raw
# singular: stays unevaluated
REWR linsolve([[1,2],[2,4]],[1,1]) : raw
# ---- with the imaginary unit
REWR det([[1,im],[im,1]]) : raw
REWR linsolve([[a,im*b],[-im*b,a]],[1,0]) : raw
REWR dot([[1,im],[im,1]],inverse([[1,im],[im,1]])) : raw
# ---- element by element; the characteristic polynomial
AA = [[2,1],[1,2]]
REWR det(AA - x*identity(2)) : raw
REWR [1,2]*x + [a,b] : Listable
REWR sin([x,2*x]) : Listable
REWR 2*AA + [[a,0],[0,a]] : Listable
REWR dot(AA, [x,y]) - [3,3] : Listable
# ---- the arithmetic of explicit vectors and matrices, also without REWR
[1,2] + [a,b]
x*[1,2] - [x,x]
[[1,2],[3,4]] * [[0,1],[1,0]]
[[1,2],[3,4]] * [x,y]
[x,y] * [[1,2],[3,4]]
[[1,2],[3,4]]^2
[[a,b],[g,n]]^(-1)
2*[[1,2],[3,4]] + [[1,0],[0,1]]
AA^0
# a vector transposed is a covector (a row): the sorts choose the inner
# product (a number), the outer product (a matrix), row times matrix
transpose([1,2,3])
transpose([1,2,3]) * [4,5,6]
[1,2,3] * transpose([4,5,6])
[p,qq] * transpose([p,qq]) + [[1,0],[0,1]]
transpose([1,2]) * [[1,2],[3,4]]
2*transpose([1,2]) + transpose([3,4])
transpose(transpose([1,2]))
transpose(range(12))
transpose([p+1,qq])
# symbolic vectors: transpose(u)*v is a scalar and commutes with matrices
SYM uu,vv : vector
SYM MM : matrix
transpose(uu)*vv
uu*transpose(vv)
REWR transpose(MM*uu) : MatrixRules
REWR MM*(transpose(uu)*vv) : MatrixRules
# ---- printing by the shape: grid at the top, inline inside a term,
# slices for depth 3; SHOW [ without ATT prints the plain term again
AA
REWR [[[1,2],[3,4]],[[5,6],[7,8]]] : raw
REWR [1,[2,3]] : raw
SHOW [
AA
SHOW [ ATT show_list
