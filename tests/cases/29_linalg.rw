# Symbolic matrices on lists (inc/linalg, symmat.c): transpose, dot,
# identity, det, linsolve, inverse with Bareiss' fraction-free elimination,
# and arithmetic on lists element by element (thread, Listable).
INC "inc/all"
INC "inc/integration/all"
INC "inc/list"
INC "inc/linalg"
FUNC never : real >> real
ALG raw
SPEC raw : never(X) = X
CONST g,p,qq,r,ss,t,u,v,w : real
TERM AA : real
# ---- structure
REWR transpose(list(list(a,b,g),list(1,2,3))) : raw
REWR identity(3) : raw
REWR dot(list(list(a,b),list(g,n)),list(list(p,qq),list(r,ss))) : raw
REWR dot(list(list(a,b),list(g,n)),list(x,y)) : raw
REWR dot(list(a,b),list(x,y)) : raw
# ---- determinants
REWR det(list(list(1,2),list(3,4))) : raw
REWR det(list(list(a,b),list(g,n))) : raw
REWR det(list(list(a,b,g),list(n,p,qq),list(r,ss,t))) : raw
REWR det(list(list(1,2),list(2,4))) : raw
REWR det(list(list(1,x,x^2),list(1,y,y^2),list(1,z,z^2))) : raw
REWR det(list(list(a,b,g,n),list(p,qq,r,ss),list(t,u,v,w),list(x,y,z,1))) : raw
# ---- linear systems and inverses (exact: a polynomial gcd in one atom cancels)
REWR linsolve(list(list(2,1),list(1,3)),list(3,5)) : raw
REWR linsolve(list(list(2,1,-1,3),list(1,-2,4,0),list(3,1,1,-1),list(1,1,1,1)),list(1,2,3,4)) : raw
REWR linsolve(list(list(a,b),list(g,n)),list(p,qq)) : raw
REWR linsolve(list(list(a,1,1),list(1,a,1),list(1,1,a)),list(1,1,1)) : raw
REWR linsolve(list(list(2*a,0),list(0,4*b)),list(2,6)) : raw
REWR linsolve(list(list(1,1),list(1,-1)),list(a,b)) : raw
REWR inverse(list(list(a,b),list(g,n))) : raw
REWR inverse(list(list(1,2,3),list(0,1,4),list(5,6,0))) : raw
REWR inverse(list(list(1,a),list(a,1))) : raw
# singular: stays unevaluated
REWR linsolve(list(list(1,2),list(2,4)),list(1,1)) : raw
# ---- with the imaginary unit
REWR det(list(list(1,im),list(im,1))) : raw
REWR linsolve(list(list(a,im*b),list(-im*b,a)),list(1,0)) : raw
REWR dot(list(list(1,im),list(im,1)),inverse(list(list(1,im),list(im,1)))) : raw
# ---- element by element; the characteristic polynomial
AA = list(list(2,1),list(1,2))
REWR det(AA - x*identity(2)) : raw
REWR list(1,2)*x + list(a,b) : Listable
REWR sin(list(x,2*x)) : Listable
REWR 2*AA + list(list(a,0),list(0,a)) : Listable
REWR dot(AA, list(x,y)) - list(3,3) : Listable
# ---- printing by the shape: grid at the top, inline inside a term,
# slices for depth 3; SHOW list without ATT prints list(..) again
AA
REWR list(list(list(1,2),list(3,4)),list(list(5,6),list(7,8))) : raw
REWR list(1,list(2,3)) : raw
SHOW list
AA
SHOW list ATT show_list
