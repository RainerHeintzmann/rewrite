# Regression tests for crashes fixed in 2026.
INC "inc/all"
INC "inc/rvector"
INC "inc/rmatrix"
# Assigning 0 or 1 and then assigning again freed static memory.
SYM r0 : real
r0 = 0
r0 = 1
r0 = 5
r0
r0 = 0
r0 = 0
r0
# A vector function with an argument that cannot be calculated
# freed a NULL vector during cleanup.
SYM vx : rvector
vx = [1,2,3]
SYM novec : rvector
SYM nb : real
nb = abs(novec+vx)
"survived"
# A TERM without a term in REWR crashed (2026): now an error message.
TERM tq : real
REWR Dt(tq,x) : All
tq
# A rule that makes the term deeper on every step overflowed the C stack
# (2026): REWR stops at the depth MAXDEPTH, MAXSTEPS limits the rewrites.
MAXSTEPS
MAXDEPTH
MAXDEPTH 40
FUNC lin : real >> real
PAT Lc : real
ALG Lin
SPEC Lin : IF NIN(x, Lc) lin(Lc) = Lc*lin(1)
REWR lin(5) : (Lin)
MAXDEPTH 1000
MAXSTEPS 10
REWR lin(5) : (Lin)
MAXSTEPS 100000
MAXDEPTH 0
"survived"
