# Equations (inc/solve): rules in the style of PRESS. Isolation, polynomial
# methods, attraction of logarithms, a new unknown, removal of square roots;
# the solutions are checked; linear systems with Bareiss' elimination.
INC "inc/all"
INC "inc/integration/all"
INC "inc/list"
INC "inc/solve"
# ---- polynomials
REWR solve(2*x + 3 == 7, x) : Solve
REWR solve(x^2 - 3*x + 2 == 0, x) : Solve
REWR solve(x^2 + 1 == 0, x) : Solve
REWR solve(x^2 + 4*x + 7 == 0, x) : Solve
REWR solve(a*x^2 + b*x + n == 0, x) : Solve
REWR solve(x^3 - 6*x^2 + 11*x - 6 == 0, x) : Solve
REWR solve(x^4 - 5*x^2 + 4 == 0, x) : Solve
REWR solve(x^3 == 2, x) : Solve
REWR solve(1/x + 1/(x+1) == 1, x) : Solve
# ---- isolation
REWR solve((x+1)^3 == 8, x) : Solve
REWR solve(exp(2*x+1) == 5, x) : Solve
REWR solve(sin(x) == 1/2, x) : Solve
REWR solve(arctan(2*x) == a, x) : Solve
REWR solve(a*sqrt(x - n) == b, x) : Solve
# ---- a new unknown, attraction, radicals
REWR solve(exp(2*x) - 3*exp(x) + 2 == 0, x) : Solve
REWR solve(sin(x)^2 - sin(x) == 0, x) : Solve
REWR solve(x + sqrt(x) - 6 == 0, x) : Solve
REWR solve(ln(x) + ln(x+1) == ln(6), x) : Solve
REWR solve(sqrt(x+1) == x - 1, x) : Solve
# ---- no solution: the empty list; no method: unevaluated
REWR solve(sqrt(x) == -1, x) : Solve
REWR solve(x == x + 1, x) : Solve
REWR solve(x^5 + x + 1 == 0, x) : Solve
# ---- the cubic and quartic formulas (the number of the checked roots)
REWR length(solve(x^3 + x + 1 == 0, x)) : Solve
REWR length(solve(x^4 + x + 1 == 0, x)) : Solve
REWR solve(x^3 + a*x == b, x) : Solve
# ---- linear systems; nonlinear systems by substitution and resultants
REWR solve([x + y == 3, x - y == 1], [x, y]) : Solve
REWR solve([a*x + b*y == 1, x - y == n], [x, y]) : Solve
REWR solve([x*y == 1, x == 2], [x, y]) : Solve
REWR solve([x^2 + y^2 == 5, x - y == 1], [x, y]) : Solve
REWR solve([x^2 + y^2 == 1, x^2 - y == 1], [x, y]) : Solve
REWR solve([x^2 + y^2 == 4, x*y == 1], [x, y]) : Solve
REWR solve([x + y + z == 6, x*y == 2, z == 3], [x, y, z]) : Solve
REWR solve([exp(x) == y, y - 2 == 0], [x, y]) : Solve
