# Lists (inc/list): [a,b,c] (sort vector), the empty list nil, nested
# lists (a list of vectors is a matrix); list(a,b) is the old name.
INC "inc/all"
INC "inc/exact"
INC "inc/list"
TERM LL : vector
TERM MM : matrix
CONST yy,aa,kk : real
x = yy
LL = [3, aa, x^2]
length(LL)
REWR part(LL, 2) : All
REWR part(LL, -1) : All
REWR first(LL) : All
REWR rest(LL) : All
REWR most(LL) : All
REWR append(LL, 7) : All
REWR prepend(LL, 0) : All
REWR join(LL, [1,2], nil) : All
REWR reverse(LL) : All
REWR range(5) : All
REWR range(2, 10, 3) : All
REWR range(1/2, 2, 1/2) : All
# a list of lists: part with two indices
MM = [[1,2], [3,4]]
REWR part(MM, 2, 1) : All
REWR part(part(MM, 1), 2) : All
# table and select (HOLD): the variable must be declared
REWR table(aa^kk, kk, [1,2,3]) : All
REWR table(kk^2, kk, 4) : All
REWR select(range(10), kk, kk > 6) : All
total(range(100))
REWR total(LL) : All
listq(LL)
listq(aa)
length(nil)
REWR rest([1]) : All
# no list or index out of range: unevaluated
REWR part(LL, 7) : All
REWR first(aa) : All
# the old name
REWR list(1, aa, [2]) : All
length(list(1, 2))
# a list is no value of a real constant: an error, aa is not changed
aa = [1, 2]
