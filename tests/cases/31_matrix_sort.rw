# The sorts algebra (inc/alg) and matrix (inc/list): symbolic matrices with a
# product that does not commute, the rules MatrixRules, explicit matrices
# [[..],[..]] mixed with symbolic ones, and matrix equations (MatrixSolve).
INC "inc/all"
SYM MA,MB,MC,MX : matrix
SYM g : real
# rules for numbers do not see matrix products: A*B - B*A stays
REWR transpose(MA*MB) : MatrixRules
REWR inverse(MA*MB*MC) : MatrixRules
REWR det(MA*inverse(MB)*transpose(MC)) : MatrixRules
REWR MA*MB*inverse(MB)*MC : MatrixRules
REWR MA*(MB+MC) - MA*MB : MatrixRules
REWR MA*MB - MB*MA : MatrixRules
REWR transpose(2*MA*g*MB) : MatrixRules
REWR [[1,2],[3,4]] * [[0,1],[1,0]] : MatrixRules
REWR det([[a,b],[g,n]]) : MatrixRules
REWR inverse([[1,2],[3,4]]) : MatrixRules
REWR 2*[[1,2],[3,4]] + [[1,0],[0,1]] : MatrixRules
REWR MA*[[1,2],[3,4]]*Id : MatrixRules
REWR 2*MA*[x,y] : MatrixRules
REWR msolve(MA*MX == MB, MX) : (MatrixSolve, MatrixRules)
REWR msolve(MX*MA + MC == MB, MX) : (MatrixSolve, MatrixRules)
REWR msolve(transpose(MA*MX) == MB, MX) : (MatrixSolve, MatrixRules)
