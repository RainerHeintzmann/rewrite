# SYMBOLIC "role" = "symbol": the helpers of symfn.c recognize and build
# terms with roles ("+", "cos", "pi", ...). By default a role is the symbol
# of the same name; a library with other names maps them.
INC "inc/all"
INC "inc/helpers"
TERM T : real
SYM yy : real
x = yy
FUNC kos : real >> real ATT r_cos
# without roles kos is unknown to the helpers: no power reduction
T = REWR expandtrigreduce(kos(x)^2,x) : All
T
T = REWR expandtrigreduce(sin(x)^2,x) : All
T
# kos plays the role of the cosine: recognized and built
SYMBOLIC "cos" = "kos"
T = REWR expandtrigreduce(kos(x)^2,x) : All
T
T = REWR expandtrigreduce(sin(x)^2,x) : All
T
# cos is now no cosine for the helpers
T = REWR expandtrigreduce(cos(x)^2,x) : All
T
# back to the names
SYMBOLIC
T = REWR expandtrigreduce(cos(x)^2,x) : All
T
