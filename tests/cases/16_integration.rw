x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int((a+b*x)^3,x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = (a+b*x)^3
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int(x^2*cos(a*x),x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = x^2*cos(a*x)
x = 0.7
abs(GG-HH) < 1e-9
x = yy
