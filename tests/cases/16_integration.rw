FF = REWR Int(x^3*(1+x)^2,x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = x^3*(1+x)^2
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
