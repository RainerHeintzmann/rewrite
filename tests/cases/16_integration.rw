GG = REWR D(FF,x) : All
HH = x*(a+b*x)^2
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int((x+1)^2*(x+2),x) : Integrate
FF
a = 2
