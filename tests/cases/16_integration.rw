GG = REWR D(FF,x) : All
HH = x^2*cos(x)
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int(x^3*sin(2*x),x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = x^3*sin(2*x)
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int((x+1)*cos(x),x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = (x+1)*cos(x)
x = 0.7
abs(GG-HH) < 1e-9
x = yy
a = yy
b = yy
FF = REWR Int(sin(x)+cos(x)+x,x) : Integrate
FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = sin(x)+cos(x)+x
x = 0.7
abs(GG-HH) < 1e-9
x = yy
