FF
a = 2
b = 0.5
GG = REWR D(FF,x) : All
HH = (2*x+1)^3*(x-1)^2
x = 0.7
abs(GG-HH) < 1e-9
# not (yet) covered: the remaining integral is returned unchanged
x = yy
REWR Int(sqrt(x)*sin(x),x) : Integrate
REWR Int(sin(x)^2,x) : Integrate
REWR Int(1/(x^2+1),x) : Integrate
