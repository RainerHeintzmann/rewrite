# IF/ELSE, WHILE, FOR and blocks.
INC "inc/all"
SYM n : real
n = 5
IF (n > 3) "big" ELSE "small"
IF (n < 3) "big" ELSE "small"
n = 1
WHILE (n < 100) n = n*2
n
FOR n = 1 TO 5 STEP 2 DO PRT n
""
FOR n = 3 TO 1 STEP -1 DO n
{ SYM s4 : real
  s4 = 2
  PRT s4 }
""
# A constant declared inside a loop body must work in every pass
# (used to fail from the second pass on).
FOR n = 1 TO 3 DO { SYM s : real
                      s = n*10
                      PRT s }
""
