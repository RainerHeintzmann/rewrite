"*TITLE*  Reduce-graph"
"*XLABEL*  Parameter R"
"*YLABEL*  Iterationen"

P1 = 4*z*x*(1- z)

FOR x = 0.4 TO 1 STEP .01 DO 	{
	z = .2
		FOR y = 1 TO 50 STEP 1 DO {z = P1}
		FOR y = 1 TO 10 STEP 1 DO { z = P1 
			x,z 
		}
	}
z = x
