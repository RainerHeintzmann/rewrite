# inc/solve (2026)
# Equations solved with rules in the style of PRESS (Bundy and Welham 1981:
# methods chosen by the form of the equation, here an ordered rule list):
#
#   REWR solve(x^2 - 3*x + 2 == 0, x) : Solve     # [1, 2]
#
# solve(lhs == rhs, x) gives the list of the solutions (the empty list nil
# if there is none); it stays unevaluated if no method applies. The methods
# for f = lhs - rhs = 0, in this order:
#   isolation      x occurs once: the functions around it are inverted
#   polynomials    degree 1 and 2, x^n = c, polynomials in x^2, rational roots
#   attraction     several logarithms with x combined: ln(u)+ln(v) = ln(u*v)
#   new unknown    f a polynomial in g(x) (exp(x), x^(1/2), sin(x), ...):
#                  solved for y = g(x), then g(x) = y isolated
#   radicals       a + b*c^(1/2) = 0 squared: a^2 - b^2*c = 0
# A system of linear equations, solve([eq1, eq2], [x, y]), gives the
# list of the values of x and y (Bareiss' elimination, inc/linalg).
# Trigonometric equations give the principal solutions (as Mathematica's
# Solve without the integer constant). Squaring can add solutions; all
# solutions are checked (numerically where possible) and those that make
# the equation undefined or false are removed.
# Needs inc/all (with inc/helpers and the imaginary unit im of the complex
# roots) and inc/list:
#     INC "inc/all"
#     INC "inc/list"
#     INC "inc/solve"

FUNC  solve     : bool,number >> number                  # solve(lhs == rhs, x)
OTHER solve     : algebra,algebra >> algebra             # solve([eqs], [unknowns]): systems
FUNC  sol       : number,number >> number                # the solutions of f = 0
FUNC  iso       : number,number,number >> number         # the solutions of u = r, x only in u
FUNC  isomap    : number,number,number >> number         # iso(g, r, x) for each r of a list
FUNC  solker    : number,number >> number                # with a new unknown
FUNC  ker       : number,number,number >> number         # ker(p, y, g): f = p(y), y = g(x)
FUNC  union     : number,number >> number                # two solution lists
OTHER union     : algebra,algebra >> algebra             # two lists of tuples (systems)
FUNC  solcheck  : number,number,number >> number         # the solutions checked in f = 0
SYM yker      : number                                 # the new unknown

FUNC  occurs    : number,number >> real    ATT SYMBOLIC occurs     # occurrences of x in u (a number)
FUNC  eqnorm    : number,number >> number  ATT SYMBOLIC eqnorm     # numerator over a common denominator
FUNC  polyroots : number,number >> number  ATT SYMBOLIC polyroots  # roots of a polynomial
FUNC  nroots    : number,number >> number  ATT SYMBOLIC nroots     # the n roots of y^n = r
FUNC  kernel    : number,number >> number  ATT SYMBOLIC kernel     # ker(p, y, g)
FUNC  unradical : number,number >> number  ATT SYMBOLIC unradical  # a + b*c^(1/2) -> a^2 - b^2*c
FUNC  attract   : number,number >> number  ATT SYMBOLIC attract    # ln(u) + ln(v) -> ln(u*v)
FUNC  attractq  : number,number >> bool    ATT SYMBOLIC attractq
FUNC  kernelq   : number,number >> bool    ATT SYMBOLIC kernelq
FUNC  radicalq  : number,number >> bool    ATT SYMBOLIC radicalq
FUNC  isoeach   : number,number,number >> number ATT SYMBOLIC isoeach
FUNC  solfilter : number,number,number >> number ATT SYMBOLIC solfilter
FUNC  linsys    : algebra,algebra >> algebra ATT SYMBOLIC linsys     # linear system: the values of the unknowns
FUNC  linsysq   : algebra,algebra >> bool ATT SYMBOLIC linsysq    # a solvable linear system
# nonlinear systems: the steps (rules below) and their C functions
FUNC  syssol    : algebra,algebra >> algebra                # syssol([f1,..], [x,..]): list of tuples
FUNC  systuple  : algebra >> algebra
FUNC  sysback   : algebra,algebra,algebra,algebra,algebra >> algebra
FUNC  sysext    : algebra,algebra,algebra,algebra,algebra >> algebra
FUNC  sysy      : algebra,algebra,algebra,algebra >> algebra
FUNC  syscheck  : algebra,algebra,algebra >> algebra
FUNC  sysnorm   : algebra >> algebra          ATT SYMBOLIC sysnorm    # [lhs == rhs, ..] -> [lhs - rhs, ..]
FUNC  sysstep   : algebra,algebra >> algebra   ATT SYMBOLIC sysstep    # substitution or resultant
FUNC  sysstepq  : algebra,algebra >> bool     ATT SYMBOLIC sysstepq
FUNC  systuplec : algebra >> algebra          ATT SYMBOLIC systuplec
FUNC  sysbackc  : algebra,algebra,algebra,algebra,algebra >> algebra ATT SYMBOLIC sysbackc
FUNC  sysextc   : algebra,algebra,algebra,algebra,algebra >> algebra ATT SYMBOLIC sysextc
FUNC  sysyc     : algebra,algebra,algebra,algebra >> algebra ATT SYMBOLIC sysyc
FUNC  syscheckc : algebra,algebra,algebra >> algebra ATT SYMBOLIC syscheckc
FUNC  resultant : number,number,number >> number ATT SYMBOLIC resultant  # resultant(f, g, y): y eliminated

PAT _Sf,_Sg,_Su,_Sv,_Sr,_Sx,_Sa,_Sn,_Sp,_Sy,_Sl,_Sm : number
PAT _Tf,_Tg,_Tv,_Ta,_Tn,_Ty,_Tl,_Tm : algebra                 # systems: lists of tuples are matrices

COMM +,*
ALG Solve
# ---- the equation
SPEC    Solve : solve(_Su == _Sv, _Sx) = solcheck(sol(_Su - _Sv, _Sx), _Su - _Sv, _Sx)
ADDSPEC Solve : IF (linsysq(_Tl, _Tm)) solve(_Tl, _Tm) = linsys(_Tl, _Tm)
# a nonlinear system: substitution of an unknown that occurs linearly,
# else (two polynomial equations) the resultant; the tuples are checked
ADDSPEC Solve : IF (listq(_Tl)), (listq(_Tm)) solve(_Tl, _Tm) = syscheck(syssol(sysnorm(_Tl), _Tm), sysnorm(_Tl), _Tm)
ADDSPEC Solve : IF (sysstepq(_Tl, _Tm)) syssol(_Tl, _Tm) = sysstep(_Tl, _Tm)
ADDSPEC Solve : IF (listq(_Tl)) systuple(_Tl) = systuplec(_Tl)
ADDSPEC Solve : IF (listq(_Tl)) sysback(_Tl, _Tm, _Tv, _Tn, _Ta) = sysbackc(_Tl, _Tm, _Tv, _Tn, _Ta)
ADDSPEC Solve : IF (listq(_Tl)) sysext(_Tl, _Tm, _Ty, _Tf, _Tg) = sysextc(_Tl, _Tm, _Ty, _Tf, _Tg)
ADDSPEC Solve : IF (listq(_Tm)) sysy(_Tl, _Tm, _Tf, _Ty) = sysyc(_Tl, _Tm, _Tf, _Ty)
ADDSPEC Solve : IF (listq(_Tl)) syscheck(_Tl, _Tf, _Tm) = syscheckc(_Tl, _Tf, _Tm)
ADDSPEC Solve : IF (listq(_Sl)) solcheck(_Sl, _Sf, _Sx) = solfilter(_Sl, _Sf, _Sx)
ADDSPEC Solve : IF (listq(_Sl)), (listq(_Sm)) union(_Sl, _Sm) = join(_Sl, _Sm)
ADDSPEC Solve : IF (listq(_Tl)), (listq(_Tm)) union(_Tl, _Tm) = join(_Tl, _Tm)
ADDSPEC Solve : IF (listq(_Sl)) isomap(_Sg, _Sl, _Sx) = isoeach(_Sg, _Sl, _Sx)
# ---- the methods, in this order
ADDSPEC Solve : IF (occurs(_Sf, _Sx) == 1) sol(_Sf, _Sx) = iso(_Sf, 0, _Sx)
# x cancels: no solution if a nonzero constant is left
ADDSPEC Solve : IF (occurs(eqnorm(_Sf, _Sx), _Sx) == 0), (neq(eqnorm(_Sf, _Sx), 0)) sol(_Sf, _Sx) = nil
ADDSPEC Solve : IF (polyq(eqnorm(_Sf, _Sx), _Sx)), (listq(polyroots(eqnorm(_Sf, _Sx), _Sx))) sol(_Sf, _Sx) = polyroots(eqnorm(_Sf, _Sx), _Sx)
ADDSPEC Solve : IF (attractq(_Sf, _Sx)) sol(_Sf, _Sx) = sol(attract(_Sf, _Sx), _Sx)
ADDSPEC Solve : IF (kernelq(_Sf, _Sx)) sol(_Sf, _Sx) = solker(kernel(_Sf, _Sx), _Sx)
ADDSPEC Solve : solker(ker(_Sp, _Sy, _Sg), _Sx) = isomap(_Sg, sol(_Sp, _Sy), _Sx)
ADDSPEC Solve : IF (radicalq(_Sf, _Sx)) sol(_Sf, _Sx) = sol(unradical(_Sf, _Sx), _Sx)
# ---- isolation: u = r with x only in u
ADDSPEC Solve : iso(_Sx, _Sr, _Sx) = [normform(_Sr)]
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Su + _Sa, _Sr, _Sx) = iso(_Su, _Sr - _Sa, _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Su - _Sa, _Sr, _Sx) = iso(_Su, _Sr + _Sa, _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Sa - _Su, _Sr, _Sx) = iso(_Su, _Sa - _Sr, _Sx)
ADDSPEC Solve : iso(- _Su, _Sr, _Sx) = iso(_Su, - _Sr, _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Sa * _Su, _Sr, _Sx) = iso(_Su, _Sr / _Sa, _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Su / _Sa, _Sr, _Sx) = iso(_Su, _Sr * _Sa, _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Sa / _Su, _Sr, _Sx) = iso(_Su, _Sa / _Sr, _Sx)
ADDSPEC Solve : iso(mi(_Su), _Sr, _Sx) = iso(_Su, mi(_Sr), _Sx)
ADDSPEC Solve : IF (freeq(_Sn, _Sx)), (integerq(_Sn)), (_Sn > 1) iso(_Su ^ _Sn, _Sr, _Sx) = isomap(_Su, nroots(_Sr, _Sn), _Sx)
ADDSPEC Solve : IF (freeq(_Sn, _Sx)), (integerq(_Sn)), (_Sn < -1) iso(_Su ^ _Sn, _Sr, _Sx) = isomap(_Su, nroots(mi(_Sr), - _Sn), _Sx)
ADDSPEC Solve : IF (freeq(_Sn, _Sx)) iso(_Su ^ _Sn, _Sr, _Sx) = iso(_Su, _Sr ^ mi(_Sn), _Sx)
ADDSPEC Solve : IF (freeq(_Sa, _Sx)) iso(_Sa ^ _Su, _Sr, _Sx) = iso(_Su, ln(_Sr) / ln(_Sa), _Sx)
ADDSPEC Solve : iso(sqrt(_Su), _Sr, _Sx) = iso(_Su, _Sr ^ 2, _Sx)
ADDSPEC Solve : iso(exp(_Su), _Sr, _Sx) = iso(_Su, ln(_Sr), _Sx)
ADDSPEC Solve : iso(ln(_Su), _Sr, _Sx) = iso(_Su, exp(_Sr), _Sx)
ADDSPEC Solve : iso(sin(_Su), _Sr, _Sx) = isomap(_Su, [arcsin(_Sr), pi - arcsin(_Sr)], _Sx)
ADDSPEC Solve : iso(cos(_Su), _Sr, _Sx) = isomap(_Su, [arccos(_Sr), - arccos(_Sr)], _Sx)
ADDSPEC Solve : iso(tan(_Su), _Sr, _Sx) = iso(_Su, arctan(_Sr), _Sx)
ADDSPEC Solve : iso(cot(_Su), _Sr, _Sx) = iso(_Su, arccot(_Sr), _Sx)
ADDSPEC Solve : iso(sec(_Su), _Sr, _Sx) = isomap(_Su, [arcsec(_Sr), - arcsec(_Sr)], _Sx)
ADDSPEC Solve : iso(csc(_Su), _Sr, _Sx) = isomap(_Su, [arccsc(_Sr), pi - arccsc(_Sr)], _Sx)
ADDSPEC Solve : iso(sinh(_Su), _Sr, _Sx) = iso(_Su, arcsinh(_Sr), _Sx)
ADDSPEC Solve : iso(cosh(_Su), _Sr, _Sx) = isomap(_Su, [arccosh(_Sr), - arccosh(_Sr)], _Sx)
ADDSPEC Solve : iso(tanh(_Su), _Sr, _Sx) = iso(_Su, arctanh(_Sr), _Sx)
ADDSPEC Solve : iso(coth(_Su), _Sr, _Sx) = iso(_Su, arccoth(_Sr), _Sx)
ADDSPEC Solve : iso(sech(_Su), _Sr, _Sx) = isomap(_Su, [arcsech(_Sr), - arcsech(_Sr)], _Sx)
ADDSPEC Solve : iso(csch(_Su), _Sr, _Sx) = iso(_Su, arccsch(_Sr), _Sx)
ADDSPEC Solve : iso(arcsin(_Su), _Sr, _Sx) = iso(_Su, sin(_Sr), _Sx)
ADDSPEC Solve : iso(arccos(_Su), _Sr, _Sx) = iso(_Su, cos(_Sr), _Sx)
ADDSPEC Solve : iso(arctan(_Su), _Sr, _Sx) = iso(_Su, tan(_Sr), _Sx)
ADDSPEC Solve : iso(arccot(_Su), _Sr, _Sx) = iso(_Su, cot(_Sr), _Sx)
ADDSPEC Solve : iso(arcsec(_Su), _Sr, _Sx) = iso(_Su, sec(_Sr), _Sx)
ADDSPEC Solve : iso(arccsc(_Su), _Sr, _Sx) = iso(_Su, csc(_Sr), _Sx)
ADDSPEC Solve : iso(arcsinh(_Su), _Sr, _Sx) = iso(_Su, sinh(_Sr), _Sx)
ADDSPEC Solve : iso(arccosh(_Su), _Sr, _Sx) = iso(_Su, cosh(_Sr), _Sx)
ADDSPEC Solve : iso(arctanh(_Su), _Sr, _Sx) = iso(_Su, tanh(_Sr), _Sx)
ADDSPEC Solve : iso(arccoth(_Su), _Sr, _Sx) = iso(_Su, coth(_Sr), _Sx)
ADDSPEC Solve : iso(arcsech(_Su), _Sr, _Sx) = iso(_Su, sech(_Sr), _Sx)
ADDSPEC Solve : iso(arccsch(_Su), _Sr, _Sx) = iso(_Su, csch(_Sr), _Sx)
# x still more than once inside: the whole equation u - r = 0 again
ADDSPEC Solve : IF (occurs(_Su, _Sx) > 1) iso(_Su, _Sr, _Sx) = sol(_Su - _Sr, _Sx)
COMM

# help for ?name
HELP "solve" "solve(lhs == rhs, x)   the list of the solutions of the equation for x"
HELP "solve" "solve([eq1, eq2], [x, y])   a system of equations: the list of the solutions"
HELP "solve" "  with the rule set Solve:  REWR solve(x^2 - 3*x + 2 == 0, x) : Solve"
HELP "Solve" "REWR solve(..) : Solve   solves equations (isolation, polynomials, new unknown, ..)"
