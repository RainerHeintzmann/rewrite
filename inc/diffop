# +++++++++++++++ Operators +++++++++++++++
SORT doperator   # differential op.
SORT vdoperator  # vector differential op.

PAT DOP1 : doperator
PAT DOP2 : doperator
PAT DOP3 : doperator
PAT VDOP1 : vdoperator
PAT VDOP2 : vdoperator
PAT VDOP3 : vdoperator

SYM \/ : vdoperator # Nabla
SYM /\ : doperator # Laplace

OTHER * : real,doperator    >> doperator # not commutative !
OTHER * : real,vdoperator   >> vdoperator # not commutative !
OTHER * : doperator,real    >> real 
OTHER * : doperator,vector  >> vector 
OTHER * : vdoperator,real   >> vector 
OTHER * : vdoperator,vector >> real 
OTHER * : doperator,doperator  >> doperator
OTHER * : vdoperator,doperator >> vdoperator
OTHER * : doperator,vdoperator  >> vdoperator
OTHER * : vdoperator,vdoperator  >> doperator

OTHER + : doperator,doperator    >> doperator
OTHER + : vdoperator,vdoperator  >> vdoperator


ALG Oper
SPEC    Oper : \/ * \/ = /\  #  caution : backslash
ADDSPEC Oper : \/ *(\/ * A) = 0
ADDSPEC Oper : VDOP1+VDOP1=2*VDOP1
ADDSPEC Oper : A*VDOP1+VDOP1=(A+1)*VDOP1
ADDSPEC Oper : VDOP1+A*VDOP1=(A+1)*VDOP1
ADDSPEC Oper : A*VDOP1+B*VDOP1=(A+B)*VDOP1

