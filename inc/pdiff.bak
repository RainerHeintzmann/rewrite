
# ++++++++++++++++++++++++ DIFFERENTIALRECHNUNG ++++++++++++++++++++++++++
FUNC Dp    : real,real      >> real           # Partielle Ableitung
FUNC Dpn   : real,real,real >> real           # n.-te Partielle Ableitung

ALG pdiff

SPEC        pdiff : 1*X=X,X*1=X
ADDSPEC     pdiff : 0*X=0,X*0=0,X+0=X,0+X=X
ADDSPEC     pdiff : X^1=X,1^X=1,X^0=1,0^X=0

ADDSPEC     pdiff : Dpn(X,Y,0) = X
ADDSPEC     pdiff : Dpn(X,Y,N) = Dpn(Dp(X,Y),Y,N - 1)

ADDSPEC     pdiff : Dp(X,X) = 1         		# spezielle Konstanten
ADDSPEC     pdiff : NIN (X,Y) Dp(Y,X) = 0    # entscheidender Unterschied !!!

ADDSPEC     pdiff : Dp(ai X,Y) = ai Dp(X,Y)
ADDSPEC     pdiff : Dp(mi X,Y) = ai mi X^2*Dp(X,Y)
ADDSPEC     pdiff : Dp(ln X,Z) = mi X * Dp(X,Z)
ADDSPEC     pdiff : Dp(e^X,Z)  = e^X * Dp(X,Z)
ADDSPEC     pdiff : Dp(sin X,Z)= cos X * Dp(X,Z)
ADDSPEC     pdiff : Dp(cos X,Z)= ai  sin X * Dp(X,Z)

ADDSPEC     pdiff : NIN (X,Y) Dp(D(X,Y),X) = 0      # Variable ist unabhaengig

ADDSPEC     pdiff : Dp(N*X,Z)=N*Dp(X,Z)             # wird so schneller
ADDSPEC     pdiff : Dp(X*Y,Z)=Dp(X,Z)*Y+Dp(Y,Z)*X   # Allg. Differenziationsregeln
ADDSPEC     pdiff : Dp(X+Y,Z)=Dp(X,Z)+Dp(Y,Z)
ADDSPEC     pdiff : Dp(X^N,X)=N*X^(N - 1)      	    # wird so schneller
ADDSPEC     pdiff : Dp(X^Y,Z)=Dp(X,Z)*Y*X^(Y+ai 1)+Dp(Y,Z)*ln X*X^Y

