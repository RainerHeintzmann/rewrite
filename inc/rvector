# inc/rvector: numerical real vectors (C arrays of doubles), for fast
# numerics. The brackets are the lists of inc/list: a list of numbers is
# converted into an rvector where one is expected (SUBSORT below), e.g.
#     SYM v : rvector
#     v = [1,2,3]
#     [1,0,0]*v              # scalar product
# Needs inc/all:
#     INC "inc/all"
#     INC "inc/rvector"
SORT rvector
ATT rvector  show_vec,cmp_vec,cpy_vec,del_vec
SUBSORT vector,rvector ATT constr_vec               # [1,2,3] as an rvector

FUNC vecs  : rvector ++ >> real ATT vec_write          # display of many vectors

OTHER + : rvector,rvector >> rvector  ATT vec_add      # vector addition
OTHER * : rvector,rvector >> real     ATT vec_mul      # scalar product
OTHER * : real,rvector >> rvector     ATT real_mul_vec # real times vector
OTHER * : rvector,real >> rvector     ATT vec_mul_real # vector times real

OTHER / : rvector,real >> rvector     ATT vec_div_real # vector divided by real

OTHER - : rvector >> rvector          ATT minus_vec    # -1*Vector 
OTHER - : rvector,rvector >> rvector  ATT vec_min_vec  # vector minus vector

OTHER abs : rvector >> real ATT vec_abs                # magnitude

FUNC _x_  : rvector,rvector >> rvector LA3 ATT vec_x_vec # square
FUNC sqr  : rvector >> real ATT vec_sqr              # square
FUNC elem : rvector,real >> real ATT elem_vec        # Vector,Pos
OTHER part : rvector,real,real >> rvector ATT vec_part # Part of the Vector From..To
FUNC zerovec : real      >> rvector ATT zero_vec     # Dimension
FUNC onevec : real,real >> rvector ATT one_vec     # Dimension,Pos
FUNC gen : real,real,real  >> rvector ATT gen_vec    # from,to,steps
FUNC chvec : rvector,real,real >> rvector ATT ch_vec # vector,pos,value
FUNC vecms : rvector >> real ATT vec_ms              # variance
FUNC vecrms : rvector >> real ATT vec_rms            # standard deviation
FUNC vecmiddle : rvector >> real ATT vec_middle      # mean
OTHER [ : rvector,real >> real ATT elem_vec          # Vector[Pos]

# elementwise ::

OTHER sin : rvector >> rvector       ATT sin_vec  # elementwise
OTHER sinh : rvector >> rvector      ATT sinh_vec  # elementwise
OTHER arcsin : rvector  >> rvector   ATT asin_vec  # elementwise
OTHER cos : rvector  >> rvector      ATT cos_vec  # elementwise
OTHER cosh : rvector  >> rvector     ATT cosh_vec  # elementwise
OTHER arccos : rvector  >> rvector   ATT acos_vec  # elementwise
OTHER tan : rvector  >> rvector      ATT tan_vec  # elementwise
OTHER tanh : rvector  >> rvector     ATT tanh_vec  # elementwise
OTHER arctan : rvector  >> rvector   ATT atan_vec  # elementwise
FUNC  eabs : rvector  >> rvector     ATT abs_vec  # elementwise
OTHER ln : rvector  >> rvector       ATT log_vec  # elementwise
OTHER exp : rvector  >> rvector      ATT exp_vec  # elementwise
OTHER ! : rvector  >> rvector        ATT factorial_vec  # elementwise
FUNC  esqr : rvector  >> rvector     ATT sqr_vec  # elementwise
OTHER sqrt : rvector  >> rvector     ATT sqrt_vec  # elementwise

FUNC  _plus : real,rvector  >> rvector LA2  ATT eplus2_vec  # elementwise
OTHER _plus : rvector,real  >> rvector      ATT eplus1_vec  # elementwise
FUNC  _minus : real,rvector  >> rvector LA2  ATT emin2_vec  # elementwise
OTHER _minus : rvector,real  >> rvector      ATT emin1_vec  # elementwise

FUNC _pow : rvector,real  >> rvector RA  ATT epow_vec  # elementwise
FUNC _mul : rvector,rvector  >> rvector LA3  ATT emul_vec  # elementwise
FUNC _div : rvector,rvector  >> rvector LA3  ATT ediv_vec  # elementwise

# help for ?name
HELP "rvector" "rvector   numerical vectors (C arrays): SYM v : rvector, v = [1,2,3], [1,0,0]*v"
HELP "rmatrix" "rmatrix   numerical matrices (inc/rmatrix): zeromat, onemat, chmat, trans"
