# units:

SYM  _E,_P,_T,_G,_M,_k,_h,_da,_d,_c,_m,_my,_mu,_n,_p,_f,_a,_Ang,_eV : real

# special constants : (for numerical values : physnum)

SYM c      : real    #                    speed of light in vacuum
SYM G      : real    # gravitational constant
SYM e0     : real    # elementary charge
SYM me     : real    # electron mass
SYM mp     : real    # proton mass
SYM g      : real    # gravitational acceleration
SYM R      : real    # universal gas constant
SYM Na     : real    # Avogadro constant
SYM k,kb   : real    # Boltzmann constant
SYM h      : real    # Planck constant
SYM hq     : real    # Planck constant
SYM ep0    : real    # electric constant
SYM my0,mu0 : real    # magnetic constant
SYM TK     : real    # 0 C = TK (273.15) K
SYM bel    : real    # scattering length of the electron (e0*e0/(4*pi*ep0*me*c*c))

SYM u      : real    # atomic mass unit

