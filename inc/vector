SORT vector
PAT  _A_v : vector
PAT  _B_v : vector
PAT  _C_v : vector
PAT  _X_v : vector
PAT  _Y_v : vector
PAT  _Z_v : vector

SYM 1_v : vector                   # ones vector
SYM e1 : vector                    # 1st unit vector
SYM e2 : vector                    # 2nd unit vector
SYM e3 : vector                    # 3rd unit vector

OTHER +  : vector,vector >> vector   # vector addition
OTHER -  : vector,vector >> vector   # vector subtraction
OTHER -  : vector >> vector          # additive inverse
OTHER *  : vector,vector >> real     # scalar product
OTHER *  : vector,real >> vector     # real times vector
OTHER *  : real,vector >> vector     # real times vector
OTHER ^  : vector,real >> real       # e.g. a_v ^ 2
OTHER D  : vector,real >> vector     # e.g. D(a_v,t)
OTHER Dp : real,vector >> real       # e.g. D(a_v,t)

FUNC vec  : real,real,real >> vector # definition of a 3-vector
BRA  [ ]  : real ++ >> vector # definition of an n-vector
FUNC grad : real >> vector           # cross product
FUNC _x_   : vector,vector >> vector  LA4 # cross product (same precedence as ^,inx)

SORT matrix
PAT  _A_m : matrix
PAT  _B_m : matrix
PAT  _C_m : matrix
PAT  _X_m : matrix
PAT  _Y_m : matrix
PAT  _Z_m : matrix

SYM E : matrix                    # identity matrix
SYM 0_m : matrix						# zero matrix

OTHER + : matrix,matrix >> matrix   # matrix addition
OTHER * : matrix,matrix >> matrix   # matrix multiplication
OTHER * : real,matrix >> matrix     # real times matrix
OTHER * : matrix,real >> matrix     # real times matrix
OTHER * : matrix,vector >> vector   # e.g. system of equations

FUNC det  : matrix >> real
FUNC ohne : real,real,matrix >> matrix # remove column,row (for det)
FUNC entwz : real,matrix >> matrix 		# fully expand along row
FUNC trans : matrix >> matrix RU    # transposed
FUNC mat : vector,vector,vector >> matrix # definition of a 3*3 matrix
FUNC elem : real,real,real >> matrix # row,column,value

ALG Vector
SPEC    Vector : _A_v+(_B_v+_C_v)=_A_v+_B_v+_C_v
ADDSPEC Vector : _A*(_A_v*_B)=_A*_A_v*_B
ADDSPEC Vector : _A_v*_A=_A*_A_v
ADDSPEC Vector : _A_v - _B_v = _A_v + - _B_v
ADDSPEC Vector : _A_v _x_ (_B_v _x_ _C_v)=_B_v*(_A_v*_C_v)+ - (_C_v*(_A_v*_B_v))
ADDSPEC Vector : grad _A = vec(Dp(_A,e1),Dp(_A,e2),Dp(_A,e3))

# explicit vectors
ADDSPEC Vector : vec(_A,_B,_C)*vec(_X,_Y,_Z)=_A*_X+_B*_Y+_C*_Z
ADDSPEC Vector : vec(_A,_B,_C)^2=_A^2+_B^2+_C^2
# ADDSPEC Vector : A*vec(X,Y,Z)=vec(A*X,A*Y,A*Z)
ADDSPEC Vector : _N*vec(_X,_Y,_Z)=vec(_N*_X,_N*_Y,_N*_Z)
ADDSPEC Vector : vec(_A,_B,_C)+vec(_X,_Y,_Z)=vec(_A+_X,_B+_Y,_C+_Z)
ADDSPEC Vector : - vec(_A,_B,_C)=vec(-_A,-_B,-_C)
ADDSPEC Vector : vec(_A,_B,_C) _x_ vec(_X,_Y,_Z)=vec(_B*_Z+ -_Y*_C,_C*_X+ -_Z*_A,_A*_Y+ -_X*_B)
ADDSPEC Vector : 1_v=vec(1,1,1)

ADDSPEC Vector : mat(_A_v,_B_v,_C_v)*_X_v=vec(_A_v*_X_v,_B_v*_X_v,_C_v*_X_v)

ALG Matrix

SPEC    Matrix : elem(_A,_B,_X)*elem(_B,_Z,_Y)=elem(_A,_Z,_X*_Y)
ADDSPEC Matrix : elem(_N,_K,_X)+elem(_N,_K,_Y)=elem(_N,_K,_X+_Y)
ADDSPEC Matrix : _A_m+elem(_N,_K,_X)+elem(_N,_K,_Y)=_A_m+elem(_N,_K,_X+_Y)
ADDSPEC Matrix : (_A_m+_B_m)*_C_m=_A_m*_C_m+_B_m*_C_m
ADDSPEC Matrix : _C_m*(_A_m+_B_m)=_C_m*_A_m+_C_m*_B_m
ADDSPEC Matrix : _C_m+(_A_m+_B_m)=_C_m+_A_m+_B_m
ADDSPEC Matrix : det (_A_m+_B_m)=det _A_m+ det _B_m

ALG wegdamit
SPEC    wegdamit : elem(_X,_Y,_Z)*elem(_A,_B,_C)=0_m
ADDSPEC wegdamit : 0_m+_A_m=_A_m
ADDSPEC wegdamit : _A_m+0_m=_A_m

ALG mso1
SPEC    mso1 : IF (_K>_N) elem(_K,_A,_X)+elem(_N,_B,_Y)=elem(_N,_B,_Y)+elem(_K,_A,_X)
ADDSPEC mso1 : IF (_K>_N) _A_m+elem(_K,_A,_X)+elem(_N,_B,_Y)=_A_m+elem(_N,_B,_Y)+elem(_K,_A,_X)
ADDSPEC mso1 : _A_m+(_B_m+_C_m)=_A_m+_B_m+_C_m

ALG mso2
SPEC    mso2 : IF (_K>_N) elem(_A,_K,_X)+elem(_A,_N,_Y)=elem(_A,_N,_Y)+elem(_A,_K,_X)
ADDSPEC mso2 : IF (_K>_N) _A_m+elem(_A,_K,_X)+elem(_A,_N,_Y)=_A_m+elem(_A,_N,_Y)+elem(_A,_K,_X)
ADDSPEC mso2 : _A_m+(_B_m+_C_m)=_A_m+_B_m+_C_m

ALG det1
SPEC    det1 : det(_A_m+elem(_N,_K,_X))=det(entwz(_N,_A_m+elem(_N,_K,_X)))
ADDSPEC det1 : det(entwz(_N,_A_m+elem(_N,_K,_X)))=_X*sgn(-1^(_N+_K))*det(entwz(_N- 1,ohne(_N,_K,_A_m)))+det(entwz(_N,_A_m))
ADDSPEC det1 : IF (_N>_K) det(entwz(_N,_A_m+elem(_K,_C,_Y)))=0
ADDSPEC det1 : IF (_N>_K) det(entwz(_N,elem(_K,_C,_Y)))=0
ADDSPEC det1 : det(entwz(_N,elem(_N,_K,_X)))=_X*sgn(-1^(_N+_K))
ADDSPEC det1 : ohne(_A,_B,_A_m+_B_m)=ohne(_A,_B,_A_m)+ohne(_A,_B,_B_m)
ADDSPEC det1 : ohne(_A,_B,elem(_A,_Y,_Z))=0_m
ADDSPEC det1 : ohne(_A,_B,elem(_X,_B,_Z))=0_m
# ADDSPEC det1 : IF (LB(A,X) && LB(B,Y)) ohne(A,B,elem(X,Y,Z))=elem(X,Y,Z) # better: Notequal
# ADDSPEC det1 : IF (LB(A,X) && LB(Y,B)) ohne(A,B,elem(X,Y,Z))=elem(X,Y,Z)
# ADDSPEC det1 : IF (LB(X,A) && LB(B,Y)) ohne(A,B,elem(X,Y,Z))=elem(X,Y,Z)
# ADDSPEC det1 : IF (LB(X,A) && LB(Y,B)) ohne(A,B,elem(X,Y,Z))=elem(X,Y,Z)
ADDSPEC det1 : 0_m+_A_m=_A_m
ADDSPEC det1 : _A_m+0_m=_A_m
ADDSPEC det1 : det 0_m=0


ALG mamul
SPEC mamul : Matrix,wegdamit,mso1,mso2,Matrix
