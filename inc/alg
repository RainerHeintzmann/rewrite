ALG substint
SPEC substint : IF NIN(_x,X) I(A,B,C,X) = _erg DO {_erg=REWR I(A,B,Sub(C,X,_x),_x) : Subst}

ALG integr
SPEC        integr : I(A,B,X+Y,Z) = I(A,B,X,Z)+I(A,B,Y,Z)
ADDSPEC     integr : IF NIN (Y,C) I(A,B,C*X,Y) = C*I(A,B,X,Y)
ADDSPEC     integr :           I(A,B,-X,Y) = - I(A,B,X,Y)

ADDSPEC     integr : I(A,A,X,Y) = 0
ADDSPEC     integr : IF NIN (Z,C) I(A,B,C,Z)   = C*(B+(-A))

ADDSPEC     integr : IF NIN (X,Y) I(A,B,Y^X,X) = (Y^B + (-(Y^A))) * mi (ln Y)
ADDSPEC     integr : IF NIN (X,Y) I(A,B,sin X,X) = - (cos B+(-cos A))
ADDSPEC     integr : IF NIN (X,Y) I(A,B,cos X,X) = sin B +(-sin A)


ADDSPEC     integr : IF NIN (Z,C + Y) I(A,B,(X+C)^Y,X) = I(A+C,B+C,X^Y,X)
ADDSPEC     integr : IF NIN (Z,C + Y) I(A,B,(C+X)^Y,X) = I(A+C,B+C,X^Y,X)

ADDSPEC     integr :                 I(A,B,mi X,X)   = ln B +(- ln A)

ADDSPEC     integr : IF NIN (X,Y)    I(A,B,X^Y,X)    = mi(Y+1)*(B^(Y+1)+(-(A^(Y+1))))
ADDSPEC     integr :                 I(A,B,X,X)      = .5*(B^2+(-(A^2)))


# +++++++++++ Algebra for *, - standard +++++++++++++++++++++++++++++++++++++++
ALG zu1
SPEC        zu1 : mi X *mi Y = mi (X*Y)
ADDSPEC     zu1 : mi X * Y = Y * mi X
ADDSPEC     zu1 : mi mi X  = X
ADDSPEC     zu1 : (- X) * Y = -(X*Y)
ADDSPEC     zu1 : X *(- Y) = -(X*Y)
ADDSPEC     zu1 : (-X)+(-Y) = -(X+Y)  # prevents cooperation with Group
ADDSPEC     zu1 : (-X) + Y =  Y+(-X)
ADDSPEC     zu1 : - - X  = X

ADDSPEC     zu1 : (mi X)^Y  = mi (X^Y)
ADDSPEC     zu1 : X^(-Y)  = mi (X^Y)

ADDSPEC     zu1 : X*Y*Z=X*(Y*Z)  # associative law
ADDSPEC     zu1 : X+Y+Z=X+(Y+Z)  # associative law

