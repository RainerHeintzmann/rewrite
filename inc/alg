# +++++++++++++++++++++ General groups +++++++++++++++++++++++
ALG Group
SPEC    Group : 0g+_Xg=_Xg
ADDSPEC Group : _Xg+0g=_Xg
ADDSPEC Group : (- _Xg)+_Xg = 0g
ADDSPEC Group : _Xg+(-_Xg)  = 0g
ADDSPEC Group : - - _Xg  = _Xg
ADDSPEC Group : - (_Yg+_Xg) = (-_Xg)+ (-_Yg)   # - additive, move inwards
ADDSPEC Group : _Xg+(_Yg+_Zg)=_Xg+_Yg+_Zg        # associative law
ADDSPEC Group : _Xg-_Yg=_Xg+(-_Yg)             # no -

# +++ Alphabetical sorting in Abelian groups ++++++++++++++

ALG AGroup
ADDSPEC AGroup : IF LB(_Xag,_Yag) _Xag+_Yag = _Yag+_Xag
ADDSPEC AGroup : IF LB(_Yag,_Zag) _Xag+_Yag+_Zag = _Xag+_Zag+_Yag

# +++++++++++++++++++++ General rings +++++++++++++++++++++++
ALG Ring
SPEC    Ring : 0r*_Xr=0r                # zero element in the ring
ADDSPEC Ring : _Xr*0r=0r
ADDSPEC Ring : (-_Xr)*_Yr = -(_Xr*_Yr)
ADDSPEC Ring : _Xr*(-_Yr) = -(_Xr*_Yr)    # all - multiplicative, move to the front
ADDSPEC Ring : mi -_Xr = -mi _Xr     # - outside mi
ADDSPEC Ring : _Xr*(_Yr+_Zr)=_Xr*_Yr+_Xr*_Zr 
ADDSPEC Ring : (_Xr+_Yr)*_Zr=_Xr*_Zr+_Yr*_Zr  # distributive law
# automatic : ADDSPEC Ring : Xr/Yr=Xr*mi Yr          # no - and no /

# +++++++++++++++++++++ Linearity ++++++++++++++++++++++++++++
ALG Linear
SPEC    Linear : _lFre(-_A)= -_lFre(_A)
ADDSPEC Linear : _lFre(-_A,_B)= -_lFre(_A,_B)
ADDSPEC Linear : _lFre(-_A,_B,_C)= -_lFre(_A,_B,_C)
ADDSPEC Linear : _lFre(-_A,_B,_C,_X)= -_lFre(_A,_B,_C,_X)
ADDSPEC Linear : _lFre(-_A,_B,_C,_X,_Y)= -_lFre(_A,_B,_C,_X,_Y)
ADDSPEC Linear : _lFre(_N*_A)=_N*_lFre(_A)
ADDSPEC Linear : _lFre(_N*_A,_B)=_N*_lFre(_A,_B)
ADDSPEC Linear : _lFre(_N*_A,_B,_C)=_N*_lFre(_A,_B,_C)
ADDSPEC Linear : _lFre(_N*_A,_B,_C,_X)=_N*_lFre(_A,_B,_C,_X)
ADDSPEC Linear : _lFre(_N*_A,_B,_C,_X,_Y)=_N*_lFre(_A,_B,_C,_X,_Y)
ADDSPEC Linear : _lFre(_A+_B)=_lFre(_A)+_lFre(_B)
ADDSPEC Linear : _lFre(_A+_B,_C)=_lFre(_A,_C)+_lFre(_B,_C)
ADDSPEC Linear : _lFre(_A+_B,_C,_X)=_lFre(_A,_C,_X)+_lFre(_B,_C,_X)
ADDSPEC Linear : _lFre(_A+_B,_C,_X,_Y)=_lFre(_A,_C,_X,_Y)+_lFre(_B,_C,_X,_Y)
ADDSPEC Linear : _lFre(_A+_B,_C,_X,_Y,_Z)=_lFre(_A,_C,_X,_Y,_Z)+_lFre(_B,_C,_X,_Y,_Z)

# +++++++++++++++++++++ Specifications of the algebras ++++++++++++++++++++++++
ALG Real
SPEC    Real : 1^_X   = 1              # rules of ^ (exponentiation)
ADDSPEC Real : 0^_X   = 0
ADDSPEC Real : IF (is_int(_X)) (_A*_B)^_X=_A^_X*_B^_X   # 2026: only for integer X or A > 0
ADDSPEC Real : IF (_A > 0) (_A*_B)^_X=_A^_X*_B^_X       # (otherwise wrong for negative A, B)
ADDSPEC Real : _X^1   = _X
ADDSPEC Real : _X^0   = 1
ADDSPEC Real : _X^(-_Y)  = mi (_X^_Y)
ADDSPEC Real : IF (is_int(_Z)) (_X^_Y)^_Z=_X^(_Y*_Z)   # 2026: was X^Y^Z (= X^(Y^Z), wrong);
ADDSPEC Real : IF (_X > 0) (_X^_Y)^_Z=_X^(_Y*_Z)       # (x^2)^0.5 is not x
ADDSPEC Real : _X^(_Y+_Z)=_X^_Y*_X^_Z
ADDSPEC Real : IF (is_int(_N/2)) (-_X)^_N=_X^_N
ADDSPEC Real : IF (is_int((_N- 1)/2)) (-_X)^_N= -(_X^_N)

ADDSPEC Real : ln e  = 1
ADDSPEC Real : IF (_X > 0) ln (_X*_Y)=ln _X + ln _Y   # 2026: was ln(X+Y)=ln X * ln Y (wrong);
ADDSPEC Real : IF (_Y > 0) ln (_X*_Y)=ln _X + ln _Y   # only correct with a positive factor
ADDSPEC Real : exp(ln _X) = _X                      # 2026 added: exp(-ln x) = 1/x
ADDSPEC Real : exp(-ln _X) = mi _X
ADDSPEC Real : exp(_N*ln _X) = _X^_N

ADDSPEC Real : sin(-_A) = -sin _A
ADDSPEC Real : cos(-_A) =  cos _A

ADDSPEC Real : sin(pi) = 0
ADDSPEC Real : cos(pi) = -1
ADDSPEC Real : IF (is_int(_N)) sin(_N*pi) = 0
ADDSPEC Real : IF (is_int((_N-.5)/2)) sin(_N*pi) =  1
ADDSPEC Real : IF (is_int((_N+.5)/2)) sin(_N*pi) = -1
ADDSPEC Real : IF (is_int(_N-.5)) cos(_N*pi) = 0
ADDSPEC Real : IF (is_int(_N/2))  cos(_N*pi) = 1
ADDSPEC Real : IF (is_int((_N+1)/2)) cos(_N*pi) = -1

# ++++++++++++++++++ Sums  +++++++++++++++++++++++++++++++++++++
ALG SumClosed
SPEC    SumClosed : IF NIN(_X,_Y) Sum(_X,_A,_B,_Y)=(_B-_A+1)*_Y
ADDSPEC SumClosed : IF NIN(_X,_Y) Sum(_X,_A,_B,_Y*_Z)=_Y*Sum(_X,_A,_B,_Z)
ADDSPEC SumClosed : IF NIN(_X,_Y) Sum(_X,_A,_B,_Z*_Y)=_Y*Sum(_X,_A,_B,_Z)
ADDSPEC SumClosed : Sum(_X,_A,_B,_Y+_Z)=Sum(_X,_A,_B,_Y)+Sum(_X,_A,_B,_Z)
ADDSPEC SumClosed : Sum(_X,_A,_B,-_Y)= -Sum(_X,_A,_B,_Y)

ADDSPEC SumClosed : Sum(_X,_A,_B,_X)=.5*_B^2+.5*_B+.5*_A*_A+ -(.5*_A)

ALG SumUnroll
SPEC    SumUnroll : IF (_K>_N) Sum(_X,_N,_K,_Y)=Sub(_Y,_X,_K)+Sum(_X,_N,_K- 1,_Y)
ADDSPEC SumUnroll :         Sum(_X,_N,_N,_Y)=Sub(_Y,_X,_N)

