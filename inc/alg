# +++++++++++++++++++++ Allgemeine Gruppen +++++++++++++++++++++++
ALG Group
SPEC    Group : 0g+Xg=Xg
ADDSPEC Group : Xg+0g=Xg
ADDSPEC Group : (- Xg)+Xg = 0g
ADDSPEC Group : Xg+(-Xg)  = 0g
ADDSPEC Group : - - Xg  = Xg
ADDSPEC Group : - (Yg+Xg) = (-Xg)+ (-Yg)   # - additiv nach innen
ADDSPEC Group : Xg+(Yg+Zg)=Xg+Yg+Zg        # Assoziativgesetz
ADDSPEC Group : Xg-Yg=Xg+(-Yg)             # kein -

# +++ Alphabetisches Sortieren in Abelschen Gruppen ++++++++++++++

ALG AGroup
ADDSPEC AGroup : IF LB(Xag,Yag) Xag+Yag = Yag+Xag
ADDSPEC AGroup : IF LB(Yag,Zag) Xag+Yag+Zag = Xag+Zag+Yag

# +++++++++++++++++++++ Allgemeine Ringe +++++++++++++++++++++++
ALG Ring
SPEC    Ring : 0r*Xr=0r                # Nullelement im Ring
ADDSPEC Ring : Xr*0r=0r
ADDSPEC Ring : (-Xr)*Yr = -(Xr*Yr)
ADDSPEC Ring : Xr*(-Yr) = -(Xr*Yr)    # alle - multiplikativ nach vorne
ADDSPEC Ring : mi -Xr = -mi Xr     # - ausserhalb mi
ADDSPEC Ring : Xr*(Yr+Zr)=Xr*Yr+Xr*Zr 
ADDSPEC Ring : (Xr+Yr)*Zr=Xr*Zr+Yr*Zr  # Distributivgesetz
# automatisch : ADDSPEC Ring : Xr/Yr=Xr*mi Yr          # kein - und kein / 

# +++++++++++++++++++++ Linearitaet ++++++++++++++++++++++++++++
ALG Linear
SPEC    Linear : _lFre(-A)= -_lFre(A)
ADDSPEC Linear : _lFre(-A,B)= -_lFre(A,B)
ADDSPEC Linear : _lFre(-A,B,C)= -_lFre(A,B,C)
ADDSPEC Linear : _lFre(-A,B,C,X)= -_lFre(A,B,C,X)
ADDSPEC Linear : _lFre(-A,B,C,X,Y)= -_lFre(A,B,C,X,Y)
ADDSPEC Linear : _lFre(N*A)=N*_lFre(A)
ADDSPEC Linear : _lFre(N*A,B)=N*_lFre(A,B)
ADDSPEC Linear : _lFre(N*A,B,C)=N*_lFre(A,B,C)
ADDSPEC Linear : _lFre(N*A,B,C,X)=N*_lFre(A,B,C,X)
ADDSPEC Linear : _lFre(N*A,B,C,X,Y)=N*_lFre(A,B,C,X,Y)
ADDSPEC Linear : _lFre(A+B)=_lFre(A)+_lFre(B)
ADDSPEC Linear : _lFre(A+B,C)=_lFre(A,C)+_lFre(B,C)
ADDSPEC Linear : _lFre(A+B,C,X)=_lFre(A,C,X)+_lFre(B,C,X)
ADDSPEC Linear : _lFre(A+B,C,X,Y)=_lFre(A,C,X,Y)+_lFre(B,C,X,Y)
ADDSPEC Linear : _lFre(A+B,C,X,Y,Z)=_lFre(A,C,X,Y,Z)+_lFre(B,C,X,Y,Z)

# +++++++++++++++++++++ Spezifikationen der Algebren ++++++++++++++++++++++++
ALG Real
SPEC    Real : 1^X   = 1              # Regeln des ^ (Potenzieren)
ADDSPEC Real : 0^X   = 0
ADDSPEC Real : (A*B)^X=A^X*B^X
ADDSPEC Real : X^1   = X
ADDSPEC Real : X^0   = 1
ADDSPEC Real : X^(-Y)  = mi (X^Y)
ADDSPEC Real : (X^Y)^Z=X^(Y*Z)        # 2026: war X^Y^Z (= X^(Y^Z), falsch)
ADDSPEC Real : X^(Y+Z)=X^Y*X^Z
ADDSPEC Real : IF (is_int(N/2)) (-X)^N=X^N
ADDSPEC Real : IF (is_int((N- 1)/2)) (-X)^N= -(X^N)

ADDSPEC Real : ln e  = 1
ADDSPEC Real : ln (X*Y)=ln X + ln Y   # 2026: war ln(X+Y)=ln X * ln Y (falsch)

ADDSPEC Real : sin(-A) = -sin A
ADDSPEC Real : cos(-A) =  cos A

ADDSPEC Real : sin(pi) = 0
ADDSPEC Real : cos(pi) = -1
ADDSPEC Real : IF (is_int(N)) sin(N*pi) = 0
ADDSPEC Real : IF (is_int((N-.5)/2)) sin(N*pi) =  1
ADDSPEC Real : IF (is_int((N+.5)/2)) sin(N*pi) = -1
ADDSPEC Real : IF (is_int(N-.5)) cos(N*pi) = 0
ADDSPEC Real : IF (is_int(N/2))  cos(N*pi) = 1
ADDSPEC Real : IF (is_int((N+1)/2)) cos(N*pi) = -1

# ++++++++++++++++++ Summen  +++++++++++++++++++++++++++++++++++++
ALG Summe
SPEC    Summe : IF NIN(X,Y) Sum(X,A,B,Y)=(B-A+1)*Y
ADDSPEC Summe : IF NIN(X,Y) Sum(X,A,B,Y*Z)=Y*Sum(X,A,B,Z)
ADDSPEC Summe : IF NIN(X,Y) Sum(X,A,B,Z*Y)=Y*Sum(X,A,B,Z)
ADDSPEC Summe : Sum(X,A,B,Y+Z)=Sum(X,A,B,Y)+Sum(X,A,B,Z)
ADDSPEC Summe : Sum(X,A,B,-Y)= -Sum(X,A,B,Y)

ADDSPEC Summe : Sum(X,A,B,X)=.5*B^2+.5*B+.5*A*A+ -(.5*A)

ALG Summen
SPEC    Summen : IF (M>N) Sum(X,N,M,Y)=Sub(Y,X,M)+Sum(X,N,M- 1,Y)
ADDSPEC Summen :         Sum(X,N,N,Y)=Sub(Y,X,N)

# ++++++++++++++++++ Komplexe Zahlen +++++++++++++++++++++++++++++++++++++
i=Cpx(0,1)
ALG Compl
SPEC  Compl : Cpx(X,Y) = X+i*Y
ADDSPEC Compl : D(Xc,Y+i*Z) = i*D(Xc,Z)+D(Xc,Y)
ADDSPEC Compl : D(Xc,i*Z+Y) = i*D(Xc,Z)+D(Xc,Y)

# ++++++++++++++++++ ordnen der Terme multiplikativ ++++++++++++++++++++++++
# Achtung : -2 * x
ALG Mulord
SPEC        Mulord : X*X = X^2
ADDSPEC     Mulord : X^N*X = X^(N+1)
ADDSPEC     Mulord : X^N*X^M = X^(N+M)
ADDSPEC     Mulord : Y*X*X = Y*X^2
ADDSPEC     Mulord : Y*X^N*X = Y*X^(N+1)
ADDSPEC     Mulord : Y*X^N*X^M = Y*X^(N+M)

# ++++++++++++++++++ ordnen der Terme additiv ++++++++++++++++++++++++++++++
ALG Addord
SPEC        Addord : X+X = 2*X
ADDSPEC     Addord : N*X+X = (N+1)*X
ADDSPEC     Addord : N*X+M*X = (N+M)*X
ADDSPEC     Addord : Y+X+X = Y+2*X
ADDSPEC     Addord : Y+N*X+X = Y+(N+1)*X
ADDSPEC     Addord : Y+N*X+M*X = Y+(N+M)*X

# ++++++++++++++++++++++++ DIFFERENTIALRECHNUNG ++++++++++++++++++++++++++
ALG diff
SPEC        diff : D(e,X) = 0         # Rheinfolge wichtig (erst e pruefen dann X ersetzen)
ADDSPEC     diff : D(pi,X)= 0
ADDSPEC     diff : D(_x,X)= 0
ADDSPEC     diff : D(N,X) = 0         # Zahlen sind konstant
ADDSPEC     diff : D(X,X) = 1         # spezielle Konstanten

ADDSPEC     diff : Dn(X,Y,0) = X
ADDSPEC     diff : Dn(X,Y,N) = Dn(D(X,Y),Y,N-1)

ADDSPEC     diff : D(mi X,Y) = - D(X,Y)*mi(X^2)
ADDSPEC     diff : D(ln X,Z) = D(X,Z)*mi X
ADDSPEC     diff : D(lg X,Z) = D(X,Z)*mi (X*ln 10)
ADDSPEC     diff : D(sin X,Z)= D(X,Z)*cos X
ADDSPEC     diff : D(arcsin X,Z)= D(X,Z)*mi((1+(-(X^2)))^.5)   # 2026: war (1+X^2)
ADDSPEC     diff : D(cos X,Z)   = - D(X,Z)*sin X
ADDSPEC     diff : D(arccos X,Z)= - D(X,Z)*mi((1+(-(X^2)))^.5) # 2026: war (1+X^2)
ADDSPEC     diff : D(tan X,Z)   = D(X,Z)*mi(cos(X)^2)
ADDSPEC     diff : D(arctan X,Z)= D(X,Z)*mi(1+X^2)
ADDSPEC     diff : D(exp X,Z)   = D(X,Z)*exp X                  # 2026 ergaenzt
ADDSPEC     diff : D(sqrt X,Z)  = D(X,Z)*mi(2*sqrt X)           # 2026 ergaenzt
ADDSPEC     diff : D(sinh X,Z)  = D(X,Z)*cosh X                 # 2026 ergaenzt
ADDSPEC     diff : D(cosh X,Z)  = D(X,Z)*sinh X                 # 2026 ergaenzt
ADDSPEC     diff : D(tanh X,Z)  = D(X,Z)*mi(cosh(X)^2)          # 2026 ergaenzt
ADDSPEC     diff : D(abs X,Z)   = D(X,Z)*X*mi(abs X)            # 2026 ergaenzt (X ungleich 0)
ADDSPEC     diff : D(csc X,Z)     = - D(X,Z)*cot(X)*csc(X)      # 2026 ergaenzt
ADDSPEC     diff : D(sec X,Z)     = D(X,Z)*tan(X)*sec(X)        # 2026 ergaenzt
ADDSPEC     diff : D(cot X,Z)     = - D(X,Z)*csc(X)^2           # 2026 ergaenzt
ADDSPEC     diff : D(arccot X,Z)  = - D(X,Z)*mi(1+X^2)          # 2026 ergaenzt
ADDSPEC     diff : D(coth X,Z)    = - D(X,Z)*csch(X)^2          # 2026 ergaenzt
ADDSPEC     diff : D(sech X,Z)    = - D(X,Z)*tanh(X)*sech(X)    # 2026 ergaenzt
ADDSPEC     diff : D(csch X,Z)    = - D(X,Z)*coth(X)*csch(X)    # 2026 ergaenzt
ADDSPEC     diff : D(arcsinh X,Z) = D(X,Z)*mi((1+X^2)^.5)       # 2026 ergaenzt
ADDSPEC     diff : D(arccosh X,Z) = D(X,Z)*mi((X^2+(-1))^.5)    # 2026 ergaenzt
ADDSPEC     diff : D(arctanh X,Z) = D(X,Z)*mi(1+(-(X^2)))       # 2026 ergaenzt
ADDSPEC     diff : D(arccoth X,Z) = D(X,Z)*mi(1+(-(X^2)))       # 2026 ergaenzt
ADDSPEC     diff : D(polylog(N,X),Z)  = D(X,Z)*polylog(N+(-1),X)*mi(X)                  # 2026 ergaenzt
ADDSPEC     diff : D(productlog X,Z)  = D(X,Z)*productlog(X)*mi(X*(1+productlog(X)))  # 2026 ergaenzt

ADDSPEC     diff : D(X*Y,Z)=D(X,Z)*Y+D(Y,Z)*X   # Allg. Differenziationsregeln
ADDSPEC     diff : IF NIN (Z,X) D(_Fre(X),Z)=D(X,Z)*D(_Fre(X),X)  # Kettenregel

ADDSPEC     diff : D(e^X,Z)  = D(X,Z)*e^X
ADDSPEC     diff : D(X^N,X)=N*X^(N-1)      # wird so schneller
ADDSPEC     diff : D(X^Y,Z)=D(X,Z)*Y*X^(Y+(-1))+D(Y,Z)*ln X*X^Y

ADDSPEC     diff : D(I(A,B,C,_x),Z)=Sub(C,_x,B)*D(B,Z)-Sub(C,_x,A)*D(A,Z)+I(A,B,D(C,Z),_x) # Leibnitz

ADDSPEC     diff : Tay(X,Y,Z,0) = Sub(X,Y,Z)
ADDSPEC     diff : Tay(X,Y,Z,N) = Tay(X,Y,Z,N-1)+Sub(Dn(X,Y,N),Y,Z)*mi(N!)*(Y+(-Z))^N 

# ++++++++++++++++++++++++ Substitution ++++++++++++++++++++++++++
ALG Subst
SPEC        Subst : Sub(X,X,A) = A
ADDSPEC     Subst : IF NIN(Z,X) Sub(X,Z,A) = X
ADDSPEC     Subst : Sub(X+Y,Z,A) = Sub(X,Z,A) + Sub(Y,Z,A)
ADDSPEC     Subst : Sub(X*Y,Z,A) = Sub(X,Z,A) * Sub(Y,Z,A)
ADDSPEC     Subst : Sub(X^Y,Z,A) = Sub(X,Z,A) ^ Sub(Y,Z,A)
ADDSPEC     Subst : Sub(sin X,Z,A) = sin Sub(X,Z,A) 
ADDSPEC     Subst : Sub(cos X,Z,A) = cos Sub(X,Z,A) 
ADDSPEC     Subst : Sub(ln X,Z,A) = ln Sub(X,Z,A) 
ADDSPEC     Subst : Sub(-X,Z,A) = - Sub(X,Z,A) 
ADDSPEC     Subst : Sub(mi X,Z,A) = mi Sub(X,Z,A) 

# ++++++++++++++++++++++++ INTERALE ++++++++++++++++++++++++++++++++++++++
ALG substint
SPEC substint : IF NIN(_x,X) I(A,B,C,X) = _erg DO {_erg=REWR I(A,B,Sub(C,X,_x),_x) : Subst}

ALG integr
SPEC        integr : I(A,B,X+Y,Z) = I(A,B,X,Z)+I(A,B,Y,Z)
ADDSPEC     integr : IF NIN (Y,C) I(A,B,C*X,Y) = C*I(A,B,X,Y)
ADDSPEC     integr :           I(A,B,-X,Y) = - I(A,B,X,Y)

ADDSPEC     integr : I(A,A,X,Y) = 0
ADDSPEC     integr : IF NIN (Z,C) I(A,B,C,Z)   = C*(B+(-A))

ADDSPEC     integr : IF NIN (X,Y) I(A,B,Y^X,X) = (Y^B + (-(Y^A))) * mi (ln Y)
ADDSPEC     integr : IF NIN (X,Y) I(A,B,sin X,X) = - (cos B+(-cos A))
