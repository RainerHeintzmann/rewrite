LIFT (Avk+Avk,Avk+Avk,Avk+Avk,Avk-Avk,Avk-Avk,Avk-Avk,Avk*Avk,Avk*Avk,Avk*Avk,Avk/Avk,Avk/Avk,Avk/Avk,-Avk,mi(Avk),0vk,1vk) \
 TO (Ac+Ac,Ac+A,A+Ac,Ac-Ac,Ac-A,A-Ac,Ac*Ac,Ac*A,A*Ac,Ac/Ac,Ac/A,A/Ac,-Ac,mi(Ac),0c,1c)

maxreal=  1e38
minreal= -1e38

# +++++++++++++++++++++ General groups +++++++++++++++++++++++
ALG Group
SPEC    Group : 0g+Xg=Xg
ADDSPEC Group : Xg+0g=Xg
ADDSPEC Group : (- Xg)+Xg = 0g
ADDSPEC Group : Xg+(-Xg)  = 0g
ADDSPEC Group : - - Xg  = Xg
ADDSPEC Group : - (Yg+Xg) = (-Xg)+ (-Yg)   # - additive, move inwards
ADDSPEC Group : Xg+(Yg+Zg)=Xg+Yg+Zg        # associative law
ADDSPEC Group : Xg-Yg=Xg+(-Yg)             # no -

# +++ Alphabetical sorting in Abelian groups ++++++++++++++

ALG AGroup
ADDSPEC AGroup : IF LB(Xag,Yag) Xag+Yag = Yag+Xag
ADDSPEC AGroup : IF LB(Yag,Zag) Xag+Yag+Zag = Xag+Zag+Yag

# +++++++++++++++++++++ General rings +++++++++++++++++++++++
ALG Ring
SPEC    Ring : 0r*Xr=0r                # zero element in the ring
ADDSPEC Ring : Xr*0r=0r
ADDSPEC Ring : (-Xr)*Yr = -(Xr*Yr)
ADDSPEC Ring : Xr*(-Yr) = -(Xr*Yr)    # all - multiplicative, move to the front
ADDSPEC Ring : mi -Xr = -mi Xr     # - outside mi
ADDSPEC Ring : Xr*(Yr+Zr)=Xr*Yr+Xr*Zr 
ADDSPEC Ring : (Xr+Yr)*Zr=Xr*Zr+Yr*Zr  # distributive law
# automatic : ADDSPEC Ring : Xr/Yr=Xr*mi Yr          # no - and no /

# +++++++++++++++++++++ Linearity ++++++++++++++++++++++++++++
ALG Linear
SPEC    Linear : _lFre(-A)= -_lFre(A)
ADDSPEC Linear : _lFre(-A,B)= -_lFre(A,B)
ADDSPEC Linear : _lFre(-A,B,C)= -_lFre(A,B,C)
ADDSPEC Linear : _lFre(-A,B,C,X)= -_lFre(A,B,C,X)
ADDSPEC Linear : _lFre(-A,B,C,X,Y)= -_lFre(A,B,C,X,Y)
ADDSPEC Linear : _lFre(N*A)=N*_lFre(A)
ADDSPEC Linear : _lFre(N*A,B)=N*_lFre(A,B)
ADDSPEC Linear : _lFre(N*A,B,C)=N*_lFre(A,B,C)
ADDSPEC Linear : _lFre(N*A,B,C,X)=N*_lFre(A,B,C,X)
ADDSPEC Linear : _lFre(N*A,B,C,X,Y)=N*_lFre(A,B,C,X,Y)
ADDSPEC Linear : _lFre(A+B)=_lFre(A)+_lFre(B)
ADDSPEC Linear : _lFre(A+B,C)=_lFre(A,C)+_lFre(B,C)
ADDSPEC Linear : _lFre(A+B,C,X)=_lFre(A,C,X)+_lFre(B,C,X)
ADDSPEC Linear : _lFre(A+B,C,X,Y)=_lFre(A,C,X,Y)+_lFre(B,C,X,Y)
ADDSPEC Linear : _lFre(A+B,C,X,Y,Z)=_lFre(A,C,X,Y,Z)+_lFre(B,C,X,Y,Z)

# +++++++++++++++++++++ Specifications of the algebras ++++++++++++++++++++++++
ALG Real
SPEC    Real : 1^X   = 1              # rules of ^ (exponentiation)
ADDSPEC Real : 0^X   = 0
ADDSPEC Real : IF (is_int(X)) (A*B)^X=A^X*B^X   # 2026: only for integer X or A > 0
ADDSPEC Real : IF (A > 0) (A*B)^X=A^X*B^X       # (otherwise wrong for negative A, B)
ADDSPEC Real : X^1   = X
ADDSPEC Real : X^0   = 1
ADDSPEC Real : X^(-Y)  = mi (X^Y)
ADDSPEC Real : IF (is_int(Z)) (X^Y)^Z=X^(Y*Z)   # 2026: was X^Y^Z (= X^(Y^Z), wrong);
ADDSPEC Real : IF (X > 0) (X^Y)^Z=X^(Y*Z)       # (x^2)^0.5 is not x
ADDSPEC Real : X^(Y+Z)=X^Y*X^Z
ADDSPEC Real : IF (is_int(N/2)) (-X)^N=X^N
ADDSPEC Real : IF (is_int((N- 1)/2)) (-X)^N= -(X^N)

ADDSPEC Real : ln e  = 1
ADDSPEC Real : IF (X > 0) ln (X*Y)=ln X + ln Y   # 2026: was ln(X+Y)=ln X * ln Y (wrong);
ADDSPEC Real : IF (Y > 0) ln (X*Y)=ln X + ln Y   # only correct with a positive factor

ADDSPEC Real : sin(-A) = -sin A
ADDSPEC Real : cos(-A) =  cos A

ADDSPEC Real : sin(pi) = 0
ADDSPEC Real : cos(pi) = -1
ADDSPEC Real : IF (is_int(N)) sin(N*pi) = 0
ADDSPEC Real : IF (is_int((N-.5)/2)) sin(N*pi) =  1
ADDSPEC Real : IF (is_int((N+.5)/2)) sin(N*pi) = -1
ADDSPEC Real : IF (is_int(N-.5)) cos(N*pi) = 0
ADDSPEC Real : IF (is_int(N/2))  cos(N*pi) = 1
ADDSPEC Real : IF (is_int((N+1)/2)) cos(N*pi) = -1

# ++++++++++++++++++ Sums  +++++++++++++++++++++++++++++++++++++
ALG Summe
SPEC    Summe : IF NIN(X,Y) Sum(X,A,B,Y)=(B-A+1)*Y
ADDSPEC Summe : IF NIN(X,Y) Sum(X,A,B,Y*Z)=Y*Sum(X,A,B,Z)
ADDSPEC Summe : IF NIN(X,Y) Sum(X,A,B,Z*Y)=Y*Sum(X,A,B,Z)
ADDSPEC Summe : Sum(X,A,B,Y+Z)=Sum(X,A,B,Y)+Sum(X,A,B,Z)
ADDSPEC Summe : Sum(X,A,B,-Y)= -Sum(X,A,B,Y)

ADDSPEC Summe : Sum(X,A,B,X)=.5*B^2+.5*B+.5*A*A+ -(.5*A)

ALG Summen
SPEC    Summen : IF (M>N) Sum(X,N,M,Y)=Sub(Y,X,M)+Sum(X,N,M- 1,Y)
ADDSPEC Summen :         Sum(X,N,N,Y)=Sub(Y,X,N)

# ++++++++++++++++++ Complex numbers +++++++++++++++++++++++++++++++++++++
i=Cpx(0,1)
ALG Compl
SPEC  Compl : Cpx(X,Y) = X+i*Y
ADDSPEC Compl : D(Xc,Y+i*Z) = i*D(Xc,Z)+D(Xc,Y)
ADDSPEC Compl : D(Xc,i*Z+Y) = i*D(Xc,Z)+D(Xc,Y)

# ++++++++++++++++++ ordering of terms, multiplicative ++++++++++++++++++++++++
# caution : -2 * x
ALG Mulord
SPEC        Mulord : X*X = X^2
ADDSPEC     Mulord : X^N*X = X^(N+1)
ADDSPEC     Mulord : X^N*X^M = X^(N+M)
ADDSPEC     Mulord : Y*X*X = Y*X^2
ADDSPEC     Mulord : Y*X^N*X = Y*X^(N+1)
ADDSPEC     Mulord : Y*X^N*X^M = Y*X^(N+M)

# ++++++++++++++++++ ordering of terms, additive ++++++++++++++++++++++++++++++
ALG Addord
SPEC        Addord : X+X = 2*X
ADDSPEC     Addord : N*X+X = (N+1)*X
ADDSPEC     Addord : N*X+M*X = (N+M)*X
ADDSPEC     Addord : Y+X+X = Y+2*X
ADDSPEC     Addord : Y+N*X+X = Y+(N+1)*X
ADDSPEC     Addord : Y+N*X+M*X = Y+(N+M)*X

# ++++++++++++++++++++++++ DIFFERENTIAL CALCULUS ++++++++++++++++++++++++++
ALG diff
SPEC        diff : D(e,X) = 0         # order matters (first check e, then replace X)
ADDSPEC     diff : D(pi,X)= 0
ADDSPEC     diff : D(_x,X)= 0
ADDSPEC     diff : D(N,X) = 0         # numbers are constant
ADDSPEC     diff : D(X,X) = 1         # special constants

ADDSPEC     diff : Dn(X,Y,0) = X
ADDSPEC     diff : Dn(X,Y,N) = Dn(D(X,Y),Y,N-1)

ADDSPEC     diff : D(mi X,Y) = - D(X,Y)*mi(X^2)
ADDSPEC     diff : D(ln X,Z) = D(X,Z)*mi X
ADDSPEC     diff : D(lg X,Z) = D(X,Z)*mi (X*ln 10)
ADDSPEC     diff : D(sin X,Z)= D(X,Z)*cos X
ADDSPEC     diff : D(arcsin X,Z)= D(X,Z)*mi((1+(-(X^2)))^.5)   # 2026: was (1+X^2)
ADDSPEC     diff : D(cos X,Z)   = - D(X,Z)*sin X
ADDSPEC     diff : D(arccos X,Z)= - D(X,Z)*mi((1+(-(X^2)))^.5) # 2026: was (1+X^2)
ADDSPEC     diff : D(tan X,Z)   = D(X,Z)*mi(cos(X)^2)
ADDSPEC     diff : D(arctan X,Z)= D(X,Z)*mi(1+X^2)
ADDSPEC     diff : D(exp X,Z)   = D(X,Z)*exp X                  # 2026 added
ADDSPEC     diff : D(sqrt X,Z)  = D(X,Z)*mi(2*sqrt X)           # 2026 added
ADDSPEC     diff : D(sinh X,Z)  = D(X,Z)*cosh X                 # 2026 added
ADDSPEC     diff : D(cosh X,Z)  = D(X,Z)*sinh X                 # 2026 added
ADDSPEC     diff : D(tanh X,Z)  = D(X,Z)*mi(cosh(X)^2)          # 2026 added
ADDSPEC     diff : D(abs X,Z)   = D(X,Z)*X*mi(abs X)            # 2026 added (X not equal to 0)
ADDSPEC     diff : D(csc X,Z)     = - D(X,Z)*cot(X)*csc(X)      # 2026 added
ADDSPEC     diff : D(sec X,Z)     = D(X,Z)*tan(X)*sec(X)        # 2026 added
ADDSPEC     diff : D(cot X,Z)     = - D(X,Z)*csc(X)^2           # 2026 added
ADDSPEC     diff : D(arccot X,Z)  = - D(X,Z)*mi(1+X^2)          # 2026 added
ADDSPEC     diff : D(coth X,Z)    = - D(X,Z)*csch(X)^2          # 2026 added
ADDSPEC     diff : D(sech X,Z)    = - D(X,Z)*tanh(X)*sech(X)    # 2026 added
ADDSPEC     diff : D(csch X,Z)    = - D(X,Z)*coth(X)*csch(X)    # 2026 added
ADDSPEC     diff : D(arcsinh X,Z) = D(X,Z)*mi((1+X^2)^.5)       # 2026 added
ADDSPEC     diff : D(arccosh X,Z) = D(X,Z)*mi((X^2+(-1))^.5)    # 2026 added
ADDSPEC     diff : D(arctanh X,Z) = D(X,Z)*mi(1+(-(X^2)))       # 2026 added
ADDSPEC     diff : D(arccoth X,Z) = D(X,Z)*mi(1+(-(X^2)))       # 2026 added
ADDSPEC     diff : D(polylog(N,X),Z)  = D(X,Z)*polylog(N+(-1),X)*mi(X)                  # 2026 added
ADDSPEC     diff : D(productlog X,Z)  = D(X,Z)*productlog(X)*mi(X*(1+productlog(X)))  # 2026 added
# 2026: derivatives of the special functions (w.r.t. the argument that depends on Z)
ADDSPEC     diff : D(arcsec X,Z)  = D(X,Z)*mi(X^2*(1+(-(mi(X^2))))^.5)
ADDSPEC     diff : D(arccsc X,Z)  = - D(X,Z)*mi(X^2*(1+(-(mi(X^2))))^.5)
