LIFT (_lFre(A,A),_lFre(A,A,A,A),_lFre(A,A,A,A),_lFre(A,A,A,A),_lFre(A,A,A),_lFre(A,A,A,A)) TO (D(A,A),I(A,A,A,A),Tay(A,A,A,A),Tay(Ac,Ac,Ac,A),Dn(A,A,A),Sum(A,A,A,A))

LIFT (Ag+Ag,Ag-Ag,-Ag,0g) TO (Aag+Aag,Aag-Aag,-Aag,0ag)
