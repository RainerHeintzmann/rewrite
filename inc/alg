SPEC  Compl : Cpx(_X,_Y) = _X+im*_Y
ADDSPEC Compl : D(_Xc,_Y+im*_Z) = im*D(_Xc,_Z)+D(_Xc,_Y)
ADDSPEC Compl : D(_Xc,im*_Z+_Y) = im*D(_Xc,_Z)+D(_Xc,_Y)

# ++++++++++++++++++ ordering of terms, multiplicative ++++++++++++++++++++++++
# caution : -2 * x
ALG Mulord
SPEC        Mulord : _X*_X = _X^2
ADDSPEC     Mulord : _X^_N*_X = _X^(_N+1)
ADDSPEC     Mulord : _X^_N*_X^_K = _X^(_N+_K)
ADDSPEC     Mulord : _Y*_X*_X = _Y*_X^2
ADDSPEC     Mulord : _Y*_X^_N*_X = _Y*_X^(_N+1)
ADDSPEC     Mulord : _Y*_X^_N*_X^_K = _Y*_X^(_N+_K)

# ++++++++++++++++++ ordering of terms, additive ++++++++++++++++++++++++++++++
ALG Addord
SPEC        Addord : _X+_X = 2*_X
ADDSPEC     Addord : _N*_X+_X = (_N+1)*_X
ADDSPEC     Addord : _N*_X+_K*_X = (_N+_K)*_X
ADDSPEC     Addord : _Y+_X+_X = _Y+2*_X
ADDSPEC     Addord : _Y+_N*_X+_X = _Y+(_N+1)*_X
ADDSPEC     Addord : _Y+_N*_X+_K*_X = _Y+(_N+_K)*_X

# ++++++++++++++++++++++++ DIFFERENTIAL CALCULUS ++++++++++++++++++++++++++
ALG diff
SPEC        diff : D(e,_Xnu) = 0         # order matters (first check e, then replace X)
ADDSPEC     diff : D(pi,_Xnu)= 0
ADDSPEC     diff : D(im,_Xnu)= 0         # 2026
ADDSPEC     diff : D(_x,_Xnu)= 0
ADDSPEC     diff : D(_N,_Xnu) = 0         # numbers are constant
ADDSPEC     diff : D(_Xnu,_Xnu) = 1         # special constants
# 2026: linearity for terms of sort number (Linear of the real terms
# works through _lFre)
ADDSPEC     diff : D(_Xnu+_Ynu,_Znu) = D(_Xnu,_Znu)+D(_Ynu,_Znu)
ADDSPEC     diff : D(_Xnu-_Ynu,_Znu) = D(_Xnu,_Znu)-D(_Ynu,_Znu)
ADDSPEC     diff : D(-_Xnu,_Znu) = -D(_Xnu,_Znu)

ADDSPEC     diff : Dn(_X,_Y,0) = _X
ADDSPEC     diff : Dn(_X,_Y,_N) = Dn(D(_X,_Y),_Y,_N-1)

ADDSPEC     diff : D(mi _Xnu,_Ynu) = - D(_Xnu,_Ynu)*mi(_Xnu^2)
ADDSPEC     diff : D(ln _Xnu,_Znu) = D(_Xnu,_Znu)*mi _Xnu
ADDSPEC     diff : D(lg _Xnu,_Znu) = D(_Xnu,_Znu)*mi (_Xnu*ln 10)
ADDSPEC     diff : D(sin _Xnu,_Znu)= D(_Xnu,_Znu)*cos _Xnu
ADDSPEC     diff : D(arcsin _Xnu,_Znu)= D(_Xnu,_Znu)*mi((1+(-(_Xnu^2)))^.5)   # 2026: was (1+X^2)
ADDSPEC     diff : D(cos _Xnu,_Znu)   = - D(_Xnu,_Znu)*sin _Xnu
ADDSPEC     diff : D(arccos _Xnu,_Znu)= - D(_Xnu,_Znu)*mi((1+(-(_Xnu^2)))^.5) # 2026: was (1+X^2)
ADDSPEC     diff : D(tan _Xnu,_Znu)   = D(_Xnu,_Znu)*mi(cos(_Xnu)^2)
ADDSPEC     diff : D(arctan _Xnu,_Znu)= D(_Xnu,_Znu)*mi(1+_Xnu^2)
ADDSPEC     diff : D(exp _Xnu,_Znu)   = D(_Xnu,_Znu)*exp _Xnu                  # 2026 added
ADDSPEC     diff : D(sqrt _Xnu,_Znu)  = D(_Xnu,_Znu)*mi(2*sqrt _Xnu)           # 2026 added
ADDSPEC     diff : D(sinh _Xnu,_Znu)  = D(_Xnu,_Znu)*cosh _Xnu                 # 2026 added
ADDSPEC     diff : D(cosh _Xnu,_Znu)  = D(_Xnu,_Znu)*sinh _Xnu                 # 2026 added
ADDSPEC     diff : D(tanh _Xnu,_Znu)  = D(_Xnu,_Znu)*mi(cosh(_Xnu)^2)          # 2026 added
ADDSPEC     diff : D(abs _Xnu,_Znu)   = D(_Xnu,_Znu)*_Xnu*mi(abs _Xnu)            # 2026 added (X not equal to 0)
ADDSPEC     diff : D(csc _Xnu,_Znu)     = - D(_Xnu,_Znu)*cot(_Xnu)*csc(_Xnu)      # 2026 added
ADDSPEC     diff : D(sec _Xnu,_Znu)     = D(_Xnu,_Znu)*tan(_Xnu)*sec(_Xnu)        # 2026 added
ADDSPEC     diff : D(cot _Xnu,_Znu)     = - D(_Xnu,_Znu)*csc(_Xnu)^2           # 2026 added
ADDSPEC     diff : D(arccot _Xnu,_Znu)  = - D(_Xnu,_Znu)*mi(1+_Xnu^2)          # 2026 added
ADDSPEC     diff : D(coth _Xnu,_Znu)    = - D(_Xnu,_Znu)*csch(_Xnu)^2          # 2026 added
ADDSPEC     diff : D(sech _Xnu,_Znu)    = - D(_Xnu,_Znu)*tanh(_Xnu)*sech(_Xnu)    # 2026 added
ADDSPEC     diff : D(csch _Xnu,_Znu)    = - D(_Xnu,_Znu)*coth(_Xnu)*csch(_Xnu)    # 2026 added
ADDSPEC     diff : D(arcsinh _Xnu,_Znu) = D(_Xnu,_Znu)*mi((1+_Xnu^2)^.5)       # 2026 added
ADDSPEC     diff : D(arccosh _Xnu,_Znu) = D(_Xnu,_Znu)*mi((_Xnu^2+(-1))^.5)    # 2026 added
ADDSPEC     diff : D(arctanh _Xnu,_Znu) = D(_Xnu,_Znu)*mi(1+(-(_Xnu^2)))       # 2026 added
ADDSPEC     diff : D(arccoth _Xnu,_Znu) = D(_Xnu,_Znu)*mi(1+(-(_Xnu^2)))       # 2026 added
ADDSPEC     diff : D(polylog(_N,_Xnu),_Znu)  = D(_Xnu,_Znu)*polylog(_N+(-1),_Xnu)*mi(_Xnu)                  # 2026 added
ADDSPEC     diff : D(productlog _Xnu,_Znu)  = D(_Xnu,_Znu)*productlog(_Xnu)*mi(_Xnu*(1+productlog(_Xnu)))  # 2026 added
# 2026: derivatives of the special functions (w.r.t. the argument that depends on Z)
ADDSPEC     diff : D(arcsec _Xnu,_Znu)  = D(_Xnu,_Znu)*mi(_Xnu^2*(1+(-(mi(_Xnu^2))))^.5)
ADDSPEC     diff : D(arccsc _Xnu,_Znu)  = - D(_Xnu,_Znu)*mi(_Xnu^2*(1+(-(mi(_Xnu^2))))^.5)
ADDSPEC     diff : D(arcsech _Xnu,_Znu) = - D(_Xnu,_Znu)*mi(_Xnu*(1+(-(_Xnu^2)))^.5)
ADDSPEC     diff : D(arccsch _Xnu,_Znu) = - D(_Xnu,_Znu)*mi(_Xnu^2*(1+mi(_Xnu^2))^.5)
ADDSPEC     diff : D(erf _Xnu,_Znu)     = D(_Xnu,_Znu)*2*mi(pi^.5)*exp(-(_Xnu^2))
ADDSPEC     diff : D(erfc _Xnu,_Znu)    = - D(_Xnu,_Znu)*2*mi(pi^.5)*exp(-(_Xnu^2))
ADDSPEC     diff : D(erfi _Xnu,_Znu)    = D(_Xnu,_Znu)*2*mi(pi^.5)*exp(_Xnu^2)
ADDSPEC     diff : D(fresnels _Xnu,_Znu) = D(_Xnu,_Znu)*sin(pi*_Xnu^2*.5)
ADDSPEC     diff : D(fresnelc _Xnu,_Znu) = D(_Xnu,_Znu)*cos(pi*_Xnu^2*.5)
ADDSPEC     diff : D(sinint _Xnu,_Znu)  = D(_Xnu,_Znu)*sin(_Xnu)*mi(_Xnu)
ADDSPEC     diff : D(cosint _Xnu,_Znu)  = D(_Xnu,_Znu)*cos(_Xnu)*mi(_Xnu)
ADDSPEC     diff : D(sinhint _Xnu,_Znu) = D(_Xnu,_Znu)*sinh(_Xnu)*mi(_Xnu)
ADDSPEC     diff : D(coshint _Xnu,_Znu) = D(_Xnu,_Znu)*cosh(_Xnu)*mi(_Xnu)
ADDSPEC     diff : D(expint _Xnu,_Znu)  = D(_Xnu,_Znu)*exp(_Xnu)*mi(_Xnu)
ADDSPEC     diff : D(logint _Xnu,_Znu)  = D(_Xnu,_Znu)*mi(ln _Xnu)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(expinte(_Ynu,_Xnu),_Znu) = - D(_Xnu,_Znu)*expinte(_Ynu+(-1),_Xnu)
ADDSPEC     diff : D(Gamma _Xnu,_Znu)   = D(_Xnu,_Znu)*Gamma(_Xnu)*polygamma(0,_Xnu)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(Gamma(_Ynu,_Xnu),_Znu) = - D(_Xnu,_Znu)*_Xnu^(_Ynu+(-1))*exp(-_Xnu)
ADDSPEC     diff : D(loggamma _Xnu,_Znu) = D(_Xnu,_Znu)*polygamma(0,_Xnu)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(polygamma(_Ynu,_Xnu),_Znu) = D(_Xnu,_Znu)*polygamma(_Ynu+1,_Xnu)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(zeta(_Ynu,_Xnu),_Znu) = - D(_Xnu,_Znu)*_Ynu*zeta(_Ynu+1,_Xnu)
ADDSPEC     diff : D(elliptice _Xnu,_Znu) = D(_Xnu,_Znu)*(elliptice(_Xnu)+(-(elliptick(_Xnu))))*mi(2*_Xnu)
ADDSPEC     diff : D(elliptick _Xnu,_Znu) = D(_Xnu,_Znu)*(elliptice(_Xnu)+(-((1+(-_Xnu))*elliptick(_Xnu))))*mi(2*_Xnu*(1+(-_Xnu)))
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(ellipticf(_Xnu,_Ynu),_Znu) = D(_Xnu,_Znu)*mi((1+(-(_Ynu*sin(_Xnu)^2)))^.5)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(elliptice(_Xnu,_Ynu),_Znu) = D(_Xnu,_Znu)*(1+(-(_Ynu*sin(_Xnu)^2)))^.5
ADDSPEC     diff : IF NIN(_Znu,_Anu,_Ynu) D(ellipticpi(_Anu,_Xnu,_Ynu),_Znu) = D(_Xnu,_Znu)*mi((1+(-(_Anu*sin(_Xnu)^2)))*(1+(-(_Ynu*sin(_Xnu)^2)))^.5)
ADDSPEC     diff : IF NIN(_Znu,_Anu,_Bnu,_Cnu) D(hyp2f1(_Anu,_Bnu,_Cnu,_Xnu),_Znu) = D(_Xnu,_Znu)*_Anu*_Bnu*mi(_Cnu)*hyp2f1(_Anu+1,_Bnu+1,_Cnu+1,_Xnu)
ADDSPEC     diff : IF NIN(_Znu,_Ynu) D(besselj(_Ynu,_Xnu),_Znu) = D(_Xnu,_Znu)*(besselj(_Ynu+(-1),_Xnu)+(-(besselj(_Ynu+1,_Xnu))))*.5

ADDSPEC     diff : D(_Xnu*_Ynu,_Znu)=D(_Xnu,_Znu)*_Ynu+D(_Ynu,_Znu)*_Xnu   # general differentiation rules
ADDSPEC     diff : D(_Xnu/_Ynu,_Znu)=D(_Xnu,_Znu)/_Ynu-_Xnu*D(_Ynu,_Znu)/_Ynu^2   # 2026 added: quotient rule
ADDSPEC     diff : IF NIN (_Z,_X) D(_Fre(_X),_Z)=D(_X,_Z)*D(_Fre(_X),_X)  # chain rule

ADDSPEC     diff : D(e^_Xnu,_Znu)  = D(_Xnu,_Znu)*e^_Xnu
ADDSPEC     diff : D(_Xnu^_N,_Xnu)=_N*_Xnu^(_N-1)      # this is faster
ADDSPEC     diff : D(_Xnu^_Ynu,_Znu)=D(_Xnu,_Znu)*_Ynu*_Xnu^(_Ynu+(-1))+D(_Ynu,_Znu)*ln _Xnu*_Xnu^_Ynu

ADDSPEC     diff : D(I(_A,_B,_C,_x),_Z)=Sub(_C,_x,_B)*D(_B,_Z)-Sub(_C,_x,_A)*D(_A,_Z)+I(_A,_B,D(_C,_Z),_x) # Leibnitz

# Tay(u,x,a,n), the Taylor polynomial: the rules Taylor of inc/helpers (they use deriv)

# ++++++++++++++++++++++++ Substitution ++++++++++++++++++++++++++
ALG Subst
SPEC        Subst : Sub(_X,_X,_A) = _A
ADDSPEC     Subst : IF NIN(_Z,_X) Sub(_X,_Z,_A) = _X
ADDSPEC     Subst : Sub(_X+_Y,_Z,_A) = Sub(_X,_Z,_A) + Sub(_Y,_Z,_A)
ADDSPEC     Subst : Sub(_X*_Y,_Z,_A) = Sub(_X,_Z,_A) * Sub(_Y,_Z,_A)
ADDSPEC     Subst : Sub(_X^_Y,_Z,_A) = Sub(_X,_Z,_A) ^ Sub(_Y,_Z,_A)
ADDSPEC     Subst : Sub(sin _X,_Z,_A) = sin Sub(_X,_Z,_A) 
ADDSPEC     Subst : Sub(cos _X,_Z,_A) = cos Sub(_X,_Z,_A) 
ADDSPEC     Subst : Sub(ln _X,_Z,_A) = ln Sub(_X,_Z,_A) 
ADDSPEC     Subst : Sub(-_X,_Z,_A) = - Sub(_X,_Z,_A) 
ADDSPEC     Subst : Sub(mi _X,_Z,_A) = mi Sub(_X,_Z,_A) 

# ++++++++++++++++++++++++ INTEGRALS ++++++++++++++++++++++++++++++++++++++
ALG substint
SPEC substint : IF NIN(_x,_X) I(_A,_B,_C,_X) = _erg DO {_erg=REWR I(_A,_B,Sub(_C,_X,_x),_x) : Subst}

ALG integr
SPEC        integr : I(_A,_B,_X+_Y,_Z) = I(_A,_B,_X,_Z)+I(_A,_B,_Y,_Z)
ADDSPEC     integr : IF NIN (_Y,_C) I(_A,_B,_C*_X,_Y) = _C*I(_A,_B,_X,_Y)
ADDSPEC     integr :           I(_A,_B,-_X,_Y) = - I(_A,_B,_X,_Y)

ADDSPEC     integr : I(_A,_A,_X,_Y) = 0
ADDSPEC     integr : IF NIN (_Z,_C) I(_A,_B,_C,_Z)   = _C*(_B+(-_A))

ADDSPEC     integr : IF NIN (_X,_Y) I(_A,_B,_Y^_X,_X) = (_Y^_B + (-(_Y^_A))) * mi (ln _Y)
ADDSPEC     integr : IF NIN (_X,_Y) I(_A,_B,sin _X,_X) = - (cos _B+(-cos _A))
ADDSPEC     integr : IF NIN (_X,_Y) I(_A,_B,cos _X,_X) = sin _B +(-sin _A)


ADDSPEC     integr : IF NIN (_Z,_C + _Y) I(_A,_B,(_X+_C)^_Y,_X) = I(_A+_C,_B+_C,_X^_Y,_X)
ADDSPEC     integr : IF NIN (_Z,_C + _Y) I(_A,_B,(_C+_X)^_Y,_X) = I(_A+_C,_B+_C,_X^_Y,_X)

ADDSPEC     integr :                 I(_A,_B,mi _X,_X)   = ln _B +(- ln _A)

ADDSPEC     integr : IF NIN (_X,_Y)    I(_A,_B,_X^_Y,_X)    = mi(_Y+1)*(_B^(_Y+1)+(-(_A^(_Y+1))))
ADDSPEC     integr :                 I(_A,_B,_X,_X)      = .5*(_B^2+(-(_A^2)))


# +++++++++++ Algebra for *, - standard +++++++++++++++++++++++++++++++++++++++
ALG Combine1
SPEC        Combine1 : mi _X *mi _Y = mi (_X*_Y)
# mi _X * _Y = _Y * mi _X: in inc/helpers (its condition needs matchq)
ADDSPEC     Combine1 : mi mi _X  = _X
ADDSPEC     Combine1 : (- _X) * _Y = -(_X*_Y)
ADDSPEC     Combine1 : _X *(- _Y) = -(_X*_Y)
ADDSPEC     Combine1 : (-_X)+(-_Y) = -(_X+_Y)  # prevents cooperation with Group
ADDSPEC     Combine1 : (-_X) + _Y =  _Y+(-_X)
ADDSPEC     Combine1 : - - _X  = _X

ADDSPEC     Combine1 : (mi _X)^_Y  = mi (_X^_Y)
ADDSPEC     Combine1 : _X^(-_Y)  = mi (_X^_Y)

ADDSPEC     Combine1 : _X*_Y*_Z=_X*(_Y*_Z)  # associative law
ADDSPEC     Combine1 : _X+_Y+_Z=_X+(_Y+_Z)  # associative law

# +++++++++++ Algebra for further simplifying and combining ++++++++++++
ALG more
SPEC        more : _X*(_Y*_Z)=_X*_Y*_Z
ADDSPEC     more : _X+(_Y+_Z)=_X+_Y+_Z  # associative law
ADDSPEC     more : _X*(_Y/_Z)=_X*_Y/_Z  # associative law
ADDSPEC     more : _X+(_Y-_Z)=_X+_Y-_Z  # associative law

ADDSPEC     more : _X^_Y*_X^_Z=_X^(_Y+_Z)
ADDSPEC     more : _X^_Y*_X=_X^(_Y+1)
ADDSPEC     more : _X*_X^_Y=_X^(_Y+1)
ADDSPEC     more : _X+_X=2*_X

ADDSPEC     more : _X * mi _Y=_X/_Y
ADDSPEC     more : _X+(-_Y)=_X-_Y  

ADDSPEC     more : 0+_X   = _X         # special constants
ADDSPEC     more : _X+0   = _X
ADDSPEC     more : _X*0   = 0
ADDSPEC     more : 0*_X   = 0
ADDSPEC     more : 1*_X   = _X
ADDSPEC     more : _X*1   = _X
# ++++++++++++++++++++++++ NUMERICS ++++++++++++++++++++++++++
ADDSPEC     more : _X+_N = _N+_X
ADDSPEC     more : _X*_N = _N*_X

ALG NoMi
SPEC    NoMi : mi _X=1/_X

ALG GrRi 
SPEC GrRi : Group,Ring

ALG Std
SPEC Std : (Real,GrRi),Mulord,Addord # integrate calculation rules into Real ?

ALG Doit
SPEC Doit : SumClosed,SumUnroll,Subst

ALG Combine
SPEC Combine : Combine1,more

ALG All 
SPEC All : Std,Doit,(Linear,Compl,diff,GrRi),AGroup,integr,(Subst,GrRi),Std,Combine,NoMi

