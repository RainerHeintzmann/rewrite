LIFT (Ar+Ar,Ar-Ar,Ar*Ar,Ar/Ar,-Ar,mi(Ar),0r,1r) TO (Ak+Ak,Ak-Ak,Ak*Ak,Ak/Ak,-Ak,mi(Ak),0k,1k)
LIFT (Ak+Ak,Ak-Ak,Ak*Ak,Ak/Ak,-Ak,mi(Ak),0k,1k) TO (Avk+Avk,Avk-Avk,Avk*Avk,Avk/Avk,-Avk,mi(Avk),0vk,1vk)
