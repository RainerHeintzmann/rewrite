im=Cpx(0,1)
ALG Compl
SPEC  Compl : Cpx(X,Y) = X+im*Y
ADDSPEC Compl : D(Xc,Y+im*Z) = im*D(Xc,Z)+D(Xc,Y)
ADDSPEC Compl : D(Xc,im*Z+Y) = im*D(Xc,Z)+D(Xc,Y)

# ++++++++++++++++++ ordering of terms, multiplicative ++++++++++++++++++++++++
# caution : -2 * x
ALG Mulord
SPEC        Mulord : X*X = X^2
ADDSPEC     Mulord : X^N*X = X^(N+1)
ADDSPEC     Mulord : X^N*X^M = X^(N+M)
ADDSPEC     Mulord : Y*X*X = Y*X^2
ADDSPEC     Mulord : Y*X^N*X = Y*X^(N+1)
ADDSPEC     Mulord : Y*X^N*X^M = Y*X^(N+M)

# ++++++++++++++++++ ordering of terms, additive ++++++++++++++++++++++++++++++
ALG Addord
SPEC        Addord : X+X = 2*X
ADDSPEC     Addord : N*X+X = (N+1)*X
ADDSPEC     Addord : N*X+M*X = (N+M)*X
ADDSPEC     Addord : Y+X+X = Y+2*X
ADDSPEC     Addord : Y+N*X+X = Y+(N+1)*X
ADDSPEC     Addord : Y+N*X+M*X = Y+(N+M)*X

# ++++++++++++++++++++++++ DIFFERENTIAL CALCULUS ++++++++++++++++++++++++++
ALG diff
SPEC        diff : D(e,Xnu) = 0         # order matters (first check e, then replace X)
ADDSPEC     diff : D(pi,Xnu)= 0
ADDSPEC     diff : D(im,Xnu)= 0         # 2026
ADDSPEC     diff : D(_x,Xnu)= 0
ADDSPEC     diff : D(N,Xnu) = 0         # numbers are constant
ADDSPEC     diff : D(Xnu,Xnu) = 1         # special constants
# 2026: linearity for terms of sort number (Linear of the real terms
# works through _lFre)
ADDSPEC     diff : D(Xnu+Ynu,Znu) = D(Xnu,Znu)+D(Ynu,Znu)
ADDSPEC     diff : D(Xnu-Ynu,Znu) = D(Xnu,Znu)-D(Ynu,Znu)
ADDSPEC     diff : D(-Xnu,Znu) = -D(Xnu,Znu)

ADDSPEC     diff : Dn(X,Y,0) = X
ADDSPEC     diff : Dn(X,Y,N) = Dn(D(X,Y),Y,N-1)

ADDSPEC     diff : D(mi Xnu,Ynu) = - D(Xnu,Ynu)*mi(Xnu^2)
ADDSPEC     diff : D(ln Xnu,Znu) = D(Xnu,Znu)*mi Xnu
ADDSPEC     diff : D(lg Xnu,Znu) = D(Xnu,Znu)*mi (Xnu*ln 10)
ADDSPEC     diff : D(sin Xnu,Znu)= D(Xnu,Znu)*cos Xnu
ADDSPEC     diff : D(arcsin Xnu,Znu)= D(Xnu,Znu)*mi((1+(-(Xnu^2)))^.5)   # 2026: was (1+X^2)
ADDSPEC     diff : D(cos Xnu,Znu)   = - D(Xnu,Znu)*sin Xnu
ADDSPEC     diff : D(arccos Xnu,Znu)= - D(Xnu,Znu)*mi((1+(-(Xnu^2)))^.5) # 2026: was (1+X^2)
ADDSPEC     diff : D(tan Xnu,Znu)   = D(Xnu,Znu)*mi(cos(Xnu)^2)
ADDSPEC     diff : D(arctan Xnu,Znu)= D(Xnu,Znu)*mi(1+Xnu^2)
ADDSPEC     diff : D(exp Xnu,Znu)   = D(Xnu,Znu)*exp Xnu                  # 2026 added
ADDSPEC     diff : D(sqrt Xnu,Znu)  = D(Xnu,Znu)*mi(2*sqrt Xnu)           # 2026 added
ADDSPEC     diff : D(sinh Xnu,Znu)  = D(Xnu,Znu)*cosh Xnu                 # 2026 added
ADDSPEC     diff : D(cosh Xnu,Znu)  = D(Xnu,Znu)*sinh Xnu                 # 2026 added
ADDSPEC     diff : D(tanh Xnu,Znu)  = D(Xnu,Znu)*mi(cosh(Xnu)^2)          # 2026 added
ADDSPEC     diff : D(abs Xnu,Znu)   = D(Xnu,Znu)*Xnu*mi(abs Xnu)            # 2026 added (X not equal to 0)
ADDSPEC     diff : D(csc Xnu,Znu)     = - D(Xnu,Znu)*cot(Xnu)*csc(Xnu)      # 2026 added
ADDSPEC     diff : D(sec Xnu,Znu)     = D(Xnu,Znu)*tan(Xnu)*sec(Xnu)        # 2026 added
ADDSPEC     diff : D(cot Xnu,Znu)     = - D(Xnu,Znu)*csc(Xnu)^2           # 2026 added
ADDSPEC     diff : D(arccot Xnu,Znu)  = - D(Xnu,Znu)*mi(1+Xnu^2)          # 2026 added
ADDSPEC     diff : D(coth Xnu,Znu)    = - D(Xnu,Znu)*csch(Xnu)^2          # 2026 added
ADDSPEC     diff : D(sech Xnu,Znu)    = - D(Xnu,Znu)*tanh(Xnu)*sech(Xnu)    # 2026 added
ADDSPEC     diff : D(csch Xnu,Znu)    = - D(Xnu,Znu)*coth(Xnu)*csch(Xnu)    # 2026 added
ADDSPEC     diff : D(arcsinh Xnu,Znu) = D(Xnu,Znu)*mi((1+Xnu^2)^.5)       # 2026 added
ADDSPEC     diff : D(arccosh Xnu,Znu) = D(Xnu,Znu)*mi((Xnu^2+(-1))^.5)    # 2026 added
ADDSPEC     diff : D(arctanh Xnu,Znu) = D(Xnu,Znu)*mi(1+(-(Xnu^2)))       # 2026 added
ADDSPEC     diff : D(arccoth Xnu,Znu) = D(Xnu,Znu)*mi(1+(-(Xnu^2)))       # 2026 added
ADDSPEC     diff : D(polylog(N,Xnu),Znu)  = D(Xnu,Znu)*polylog(N+(-1),Xnu)*mi(Xnu)                  # 2026 added
ADDSPEC     diff : D(productlog Xnu,Znu)  = D(Xnu,Znu)*productlog(Xnu)*mi(Xnu*(1+productlog(Xnu)))  # 2026 added
# 2026: derivatives of the special functions (w.r.t. the argument that depends on Z)
ADDSPEC     diff : D(arcsec Xnu,Znu)  = D(Xnu,Znu)*mi(Xnu^2*(1+(-(mi(Xnu^2))))^.5)
ADDSPEC     diff : D(arccsc Xnu,Znu)  = - D(Xnu,Znu)*mi(Xnu^2*(1+(-(mi(Xnu^2))))^.5)
ADDSPEC     diff : D(arcsech Xnu,Znu) = - D(Xnu,Znu)*mi(Xnu*(1+(-(Xnu^2)))^.5)
ADDSPEC     diff : D(arccsch Xnu,Znu) = - D(Xnu,Znu)*mi(Xnu^2*(1+mi(Xnu^2))^.5)
ADDSPEC     diff : D(erf Xnu,Znu)     = D(Xnu,Znu)*2*mi(pi^.5)*exp(-(Xnu^2))
ADDSPEC     diff : D(erfc Xnu,Znu)    = - D(Xnu,Znu)*2*mi(pi^.5)*exp(-(Xnu^2))
ADDSPEC     diff : D(erfi Xnu,Znu)    = D(Xnu,Znu)*2*mi(pi^.5)*exp(Xnu^2)
ADDSPEC     diff : D(fresnels Xnu,Znu) = D(Xnu,Znu)*sin(pi*Xnu^2*.5)
ADDSPEC     diff : D(fresnelc Xnu,Znu) = D(Xnu,Znu)*cos(pi*Xnu^2*.5)
ADDSPEC     diff : D(sinint Xnu,Znu)  = D(Xnu,Znu)*sin(Xnu)*mi(Xnu)
ADDSPEC     diff : D(cosint Xnu,Znu)  = D(Xnu,Znu)*cos(Xnu)*mi(Xnu)
ADDSPEC     diff : D(sinhint Xnu,Znu) = D(Xnu,Znu)*sinh(Xnu)*mi(Xnu)
ADDSPEC     diff : D(coshint Xnu,Znu) = D(Xnu,Znu)*cosh(Xnu)*mi(Xnu)
ADDSPEC     diff : D(expint Xnu,Znu)  = D(Xnu,Znu)*exp(Xnu)*mi(Xnu)
ADDSPEC     diff : D(logint Xnu,Znu)  = D(Xnu,Znu)*mi(ln Xnu)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(expinte(Ynu,Xnu),Znu) = - D(Xnu,Znu)*expinte(Ynu+(-1),Xnu)
ADDSPEC     diff : D(Gamma Xnu,Znu)   = D(Xnu,Znu)*Gamma(Xnu)*polygamma(0,Xnu)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(Gamma(Ynu,Xnu),Znu) = - D(Xnu,Znu)*Xnu^(Ynu+(-1))*exp(-Xnu)
ADDSPEC     diff : D(loggamma Xnu,Znu) = D(Xnu,Znu)*polygamma(0,Xnu)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(polygamma(Ynu,Xnu),Znu) = D(Xnu,Znu)*polygamma(Ynu+1,Xnu)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(zeta(Ynu,Xnu),Znu) = - D(Xnu,Znu)*Ynu*zeta(Ynu+1,Xnu)
ADDSPEC     diff : D(elliptice Xnu,Znu) = D(Xnu,Znu)*(elliptice(Xnu)+(-(elliptick(Xnu))))*mi(2*Xnu)
ADDSPEC     diff : D(elliptick Xnu,Znu) = D(Xnu,Znu)*(elliptice(Xnu)+(-((1+(-Xnu))*elliptick(Xnu))))*mi(2*Xnu*(1+(-Xnu)))
ADDSPEC     diff : IF NIN(Znu,Ynu) D(ellipticf(Xnu,Ynu),Znu) = D(Xnu,Znu)*mi((1+(-(Ynu*sin(Xnu)^2)))^.5)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(elliptice(Xnu,Ynu),Znu) = D(Xnu,Znu)*(1+(-(Ynu*sin(Xnu)^2)))^.5
ADDSPEC     diff : IF NIN(Znu,Anu,Ynu) D(ellipticpi(Anu,Xnu,Ynu),Znu) = D(Xnu,Znu)*mi((1+(-(Anu*sin(Xnu)^2)))*(1+(-(Ynu*sin(Xnu)^2)))^.5)
ADDSPEC     diff : IF NIN(Znu,Anu,Bnu,Cnu) D(hyp2f1(Anu,Bnu,Cnu,Xnu),Znu) = D(Xnu,Znu)*Anu*Bnu*mi(Cnu)*hyp2f1(Anu+1,Bnu+1,Cnu+1,Xnu)
ADDSPEC     diff : IF NIN(Znu,Ynu) D(besselj(Ynu,Xnu),Znu) = D(Xnu,Znu)*(besselj(Ynu+(-1),Xnu)+(-(besselj(Ynu+1,Xnu))))*.5

ADDSPEC     diff : D(Xnu*Ynu,Znu)=D(Xnu,Znu)*Ynu+D(Ynu,Znu)*Xnu   # general differentiation rules
ADDSPEC     diff : D(Xnu/Ynu,Znu)=D(Xnu,Znu)/Ynu-Xnu*D(Ynu,Znu)/Ynu^2   # 2026 added: quotient rule
ADDSPEC     diff : IF NIN (Z,X) D(_Fre(X),Z)=D(X,Z)*D(_Fre(X),X)  # chain rule

ADDSPEC     diff : D(e^Xnu,Znu)  = D(Xnu,Znu)*e^Xnu
ADDSPEC     diff : D(Xnu^N,Xnu)=N*Xnu^(N-1)      # this is faster
ADDSPEC     diff : D(Xnu^Ynu,Znu)=D(Xnu,Znu)*Ynu*Xnu^(Ynu+(-1))+D(Ynu,Znu)*ln Xnu*Xnu^Ynu

ADDSPEC     diff : D(I(A,B,C,_x),Z)=Sub(C,_x,B)*D(B,Z)-Sub(C,_x,A)*D(A,Z)+I(A,B,D(C,Z),_x) # Leibnitz

ADDSPEC     diff : Tay(X,Y,Z,0) = Sub(X,Y,Z)
ADDSPEC     diff : Tay(X,Y,Z,N) = Tay(X,Y,Z,N-1)+Sub(Dn(X,Y,N),Y,Z)*mi(N!)*(Y+(-Z))^N 

# ++++++++++++++++++++++++ Substitution ++++++++++++++++++++++++++
ALG Subst
SPEC        Subst : Sub(X,X,A) = A
ADDSPEC     Subst : IF NIN(Z,X) Sub(X,Z,A) = X
ADDSPEC     Subst : Sub(X+Y,Z,A) = Sub(X,Z,A) + Sub(Y,Z,A)
ADDSPEC     Subst : Sub(X*Y,Z,A) = Sub(X,Z,A) * Sub(Y,Z,A)
ADDSPEC     Subst : Sub(X^Y,Z,A) = Sub(X,Z,A) ^ Sub(Y,Z,A)
ADDSPEC     Subst : Sub(sin X,Z,A) = sin Sub(X,Z,A) 
ADDSPEC     Subst : Sub(cos X,Z,A) = cos Sub(X,Z,A) 
ADDSPEC     Subst : Sub(ln X,Z,A) = ln Sub(X,Z,A) 
ADDSPEC     Subst : Sub(-X,Z,A) = - Sub(X,Z,A) 
ADDSPEC     Subst : Sub(mi X,Z,A) = mi Sub(X,Z,A) 

# ++++++++++++++++++++++++ INTEGRALS ++++++++++++++++++++++++++++++++++++++
ALG substint
SPEC substint : IF NIN(_x,X) I(A,B,C,X) = _erg DO {_erg=REWR I(A,B,Sub(C,X,_x),_x) : Subst}

ALG integr
SPEC        integr : I(A,B,X+Y,Z) = I(A,B,X,Z)+I(A,B,Y,Z)
ADDSPEC     integr : IF NIN (Y,C) I(A,B,C*X,Y) = C*I(A,B,X,Y)
ADDSPEC     integr :           I(A,B,-X,Y) = - I(A,B,X,Y)

ADDSPEC     integr : I(A,A,X,Y) = 0
ADDSPEC     integr : IF NIN (Z,C) I(A,B,C,Z)   = C*(B+(-A))

ADDSPEC     integr : IF NIN (X,Y) I(A,B,Y^X,X) = (Y^B + (-(Y^A))) * mi (ln Y)
ADDSPEC     integr : IF NIN (X,Y) I(A,B,sin X,X) = - (cos B+(-cos A))
ADDSPEC     integr : IF NIN (X,Y) I(A,B,cos X,X) = sin B +(-sin A)


ADDSPEC     integr : IF NIN (Z,C + Y) I(A,B,(X+C)^Y,X) = I(A+C,B+C,X^Y,X)
ADDSPEC     integr : IF NIN (Z,C + Y) I(A,B,(C+X)^Y,X) = I(A+C,B+C,X^Y,X)

ADDSPEC     integr :                 I(A,B,mi X,X)   = ln B +(- ln A)

ADDSPEC     integr : IF NIN (X,Y)    I(A,B,X^Y,X)    = mi(Y+1)*(B^(Y+1)+(-(A^(Y+1))))
ADDSPEC     integr :                 I(A,B,X,X)      = .5*(B^2+(-(A^2)))


# +++++++++++ Algebra for *, - standard +++++++++++++++++++++++++++++++++++++++
ALG Combine1
SPEC        Combine1 : mi X *mi Y = mi (X*Y)
ADDSPEC     Combine1 : mi X * Y = Y * mi X
ADDSPEC     Combine1 : mi mi X  = X
ADDSPEC     Combine1 : (- X) * Y = -(X*Y)
ADDSPEC     Combine1 : X *(- Y) = -(X*Y)
ADDSPEC     Combine1 : (-X)+(-Y) = -(X+Y)  # prevents cooperation with Group
ADDSPEC     Combine1 : (-X) + Y =  Y+(-X)
ADDSPEC     Combine1 : - - X  = X

ADDSPEC     Combine1 : (mi X)^Y  = mi (X^Y)
ADDSPEC     Combine1 : X^(-Y)  = mi (X^Y)

ADDSPEC     Combine1 : X*Y*Z=X*(Y*Z)  # associative law
ADDSPEC     Combine1 : X+Y+Z=X+(Y+Z)  # associative law

# +++++++++++ Algebra for further simplifying and combining ++++++++++++
ALG more
SPEC        more : X*(Y*Z)=X*Y*Z
ADDSPEC     more : X+(Y+Z)=X+Y+Z  # associative law
ADDSPEC     more : X*(Y/Z)=X*Y/Z  # associative law
ADDSPEC     more : X+(Y-Z)=X+Y-Z  # associative law

ADDSPEC     more : X^Y*X^Z=X^(Y+Z)
ADDSPEC     more : X^Y*X=X^(Y+1)
ADDSPEC     more : X*X^Y=X^(Y+1)
ADDSPEC     more : X+X=2*X

ADDSPEC     more : X * mi Y=X/Y
ADDSPEC     more : X+(-Y)=X-Y  

ADDSPEC     more : 0+X   = X         # special constants
ADDSPEC     more : X+0   = X
ADDSPEC     more : X*0   = 0
ADDSPEC     more : 0*X   = 0
ADDSPEC     more : 1*X   = X
ADDSPEC     more : X*1   = X
# ++++++++++++++++++++++++ NUMERICS ++++++++++++++++++++++++++
ADDSPEC     more : X+N = N+X
ADDSPEC     more : X*N = N*X

