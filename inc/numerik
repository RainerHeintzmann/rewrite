SYM _step  : real
SYM _n     : real
SYM _steps : real
SYM _myerg : real
SYM _tmp1   : real
SYM _tmp2   : real
SYM _tmp3   : real
SYM _best  : real
SYM _bestx : real

TERM num : real

FUNC fmin   : real,real,real,real >> real # fmin(-1,1,x^2,x)    find minimum
FUNC fmax   : real,real,real,real >> real # fmax(-1,1,- x^2,x) find maximum
FUNC flext  : real,real,real      >> real # flmax(1,- x^2,x) find local extremum
FUNC flzero : real,real,real      >> real # flmax(1,x^2,x)    find local zero
FUNC newton : real,real,real,real >> real # newton(start,f,f',x) find local zero

ALG num1
SPEC    num1 : IF NIN(_x,_B) I(_X,_Y,_A,_B)=I(_X,_Y,Sub(_A,_B,_x),_x)
ADDSPEC num1 : IF NIN(_x,_B) newton(_X,_A,_C,_B)=newton(_X,Sub(_A,_B,_x),Sub(_C,_B,_x),_x)
ADDSPEC num1 : IF NIN(_x,_B) flzero(_X,_A,_B)=newton(_X,Sub(_A,_B,_x),Dt(Sub(_A,_B,_x),_x),_x)
ADDSPEC num1 : IF NIN(_x,_B) flext(_X,_A,_B)=flzero(_X,Dt(Sub(_A,_B,_x),_x),_x)
ADDSPEC num1 : IF NIN(_x,_B) fmin(_X,_Y,_A,_B)=fmin(_X,_Y,Sub(_A,_B,_x),_x)
ADDSPEC num1 : IF NIN(_x,_B) fmax(_X,_Y,_A,_B)=fmin(_X,_Y,- _A,_B)

ALG calc
SPEC    calc : I(_N,_K,_A,_x)=_myerg DO { _myerg=0;_tmp1=0;_tmp2=0 # Simpson
        FOR _n=_N+_step/2 TO _K-_step STEP _step DO { _x=_n;_tmp1=_tmp1+_A	
        _x=_n+_step/2
				_tmp2=_tmp2+_A }
				_x=_K-_step/2
				_tmp1=_tmp1+_A
				_x=_N;_myerg=_A+4*_tmp1+2*_tmp2
				_x=_K;_myerg=(_myerg+_A)*_step/2/3
				_x=nothing }

ADDSPEC calc : fmin(_N,_K,_A,_x)=_myerg DO {_myerg=0;_bestx=nothing;_best=maxreal
        FOR _x=_N TO _K STEP _step DO IF (_best>_A) { _best=_A;_bestx=_x }
        _myerg=_bestx}

ADDSPEC calc : newton(_N,_A,_B,_x) = _myerg DO { _x=_N
        FOR _n=1 TO _steps DO { _x=_x-_A/_B }; _myerg=_x; _x=nothing }

ALG numerik
SPEC numerik : (num1,Subst),All

_step =.1
_steps=10
