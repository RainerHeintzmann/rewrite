#                     simulation of synchrotron radiation
# Inputs :
#

SYM pose : rvector # position of the electron
# SYM pos2 : rvector # position of the observer (to be set)

SYM pe : rvector   # momentum of the electron
SYM e12a,e12b,e12c,vel : rvector  # position of observer, apparent relative unit vector
SYM l12 : real                     # distance
SYM t12a,t12b,t12c,dummy,dt,s0,m0 : real          # time at the observer

TERM E,B,d2dt2_e,Be : rvector # E=electric field,B = corresp. magnetic field,force,2nd deriv. (posrel), magnetic field for electron
TERM t12 : real

d2dt2_e = 2*((e12b-e12a)/(t12b-t12a)-(e12c-e12b)/(t12c-t12b))/(t12c-t12a)


t12= .5*(t12b+.5*(t12a+t12c)) # corresponding time

E = (- e0) / (4*pi*ep0*c^2) * d2dt2_e
B = - (e12b _x_ E/c)

# motion of the electron : (approximation : no energy loss) d/dt pe = q*VxB

Be = [0,0,4*sin(15*elem(pose,0)+0.6*pi)]  # Wiggler 4 Tesla, period approx. 40cm

m0=me # pos2 = [200,0,10]
e12a= [0,0,0] ;e12b= [0,0,0] ;e12c= [0,0,0]
pose = [0,0,0] ; pe = [3*_G*_eV/c,0,0]
dt= 1e-10
s0=sqr(pos2-pose) ^.5

t12a= -2*dt ;t12b= -dt ;t12c= 0

"*TITLE*  Relativistic Electron"
"*XLABEL*  posx [m]"
"*YLABEL*  posy bzw B"

FOR t = 0 TO 30  DO 	{

vel=pe/(m0*m0+sqr(pe/c))^.5 # caution, m(vel new) !
pe=pe+dt*e0*vel _x_ Be # dt * F
pose=pose+vel*dt
e12a=e12b ; e12b=e12c
t12a=t12b ; t12b=t12c
e12c=pos2 - pose
l12 = (sqr(e12c))^.5
t12c = l12/c
e12c=e12c/l12 # unit vector

elem(pose,0),elem(pose,1),elem(Be,2)/1000,(dt*t+t12)*c-s0,elem(B,2)*1e19
}
