# inc/linalg (2026)
# Matrices: explicit ones are lists of rows (inc/list), [[a,b],[c,d]], a
# vector is a list [a,b]. The functions are symbolic C functions
# (symmat.c); they stay unevaluated if an argument does not fit.
# det, linsolve and inverse use Bareiss' fraction-free elimination: the
# entries may be any terms, the results are polynomials in them, divided
# by the determinant at the end.
# Needs inc/all and inc/list:
#     INC "inc/all"
#     INC "inc/list"
#     INC "inc/linalg"

FUNC  transpose : matrix >> matrix   ATT SYMBOLIC transpose      # rows become columns
FUNC  dot       : number,number >> number ATT SYMBOLIC dot       # vector.vector
OTHER dot       : matrix,matrix >> matrix ATT SYMBOLIC dot       # the matrix product
OTHER dot       : matrix,vector >> vector ATT SYMBOLIC dot
OTHER dot       : vector,matrix >> vector ATT SYMBOLIC dot
FUNC  identity  : number >> matrix   ATT SYMBOLIC identity       # identity(n): the n x n unit matrix
FUNC  det       : matrix >> number   ATT SYMBOLIC det            # determinant
FUNC  linsolve  : matrix,vector >> vector ATT SYMBOLIC linsolve  # x with m.x = b
OTHER linsolve  : matrix,matrix >> matrix ATT SYMBOLIC linsolve  # b a matrix
FUNC  inverse   : matrix >> matrix   ATT SYMBOLIC inverse        # inverse matrix
FUNC  thread    : number >> number   ATT SYMBOLIC thread         # arithmetic on lists element by element
OTHER thread    : algebra >> algebra ATT SYMBOLIC thread
FUNC  threadq   : number >> bool     ATT SYMBOLIC threadq        # thread would change u
OTHER threadq   : algebra >> bool    ATT SYMBOLIC threadq

# Functions of lists element by element, as Mathematica's Listable
# functions: REWR sin([a,b]) : Listable gives [sin(a), sin(b)]. The
# arithmetic of lists does this by itself (inc/list), and the matrix
# functions above thread their arguments: det(m - x*identity(2)) is the
# characteristic polynomial of m.
ALG Listable
SPEC    Listable : IF (threadq(_Xnu)) _Xnu = thread(_Xnu)
ADDSPEC Listable : IF (threadq(_Xal)) _Xal = thread(_Xal)

# ---------------- symbolic matrices (2026) ----------------
# The sort matrix (inc/list) is below algebra (inc/alg): its product is
# not commutative, so the rules for numbers (commutative *, the
# integration) do not apply to it, while the rules for algebra do.
# SYM A,B : matrix are symbolic matrices, REWR transpose(A*B) :
# MatrixRules gives transpose(B)*transpose(A). Explicit matrices are
# calculated at once.
PAT _Ma,_Mb,_Mc,_Mc2 : matrix
SYM Id,Zm : matrix                       # the identity and the zero matrix
FUNC  sortleq   : algebra,algebra >> bool ATT SYMBOLIC sortleq # the sort of u is that of v or below
# numbers commute with matrices, vectors do not: not(sortleq(Xnu, nil)),
# Xnu is no vector (nil is the empty vector)

# ---------------- covectors (2026) ----------------
# transpose(v) of a vector is a covector, a row vector (as Julia's
# Transpose): it stays a term, and the sorts choose the products:
# transpose(u)*v is a number (the inner product), u*transpose(v) a matrix
# (the outer product), transpose(u)*m a covector. Explicit lists are
# calculated with dot; symbolic vectors (SYM u : vector) stay. transpose
# is linear, so sums and multiples of covectors are taken back to vectors.
SORT covector
SUBSORT covector,algebra
PAT _Va,_Vb : vector
ALG Covec
OTHER transpose : vector >> covector                      # stays a term
OTHER transpose : covector >> vector      ATT RULES Covec
OTHER *         : covector,vector >> number   ATT RULES Covec
OTHER *         : vector,covector >> matrix   ATT RULES Covec
OTHER *         : covector,matrix >> covector ATT RULES Covec
OTHER *         : number,covector >> covector ATT RULES Covec
OTHER +         : covector,covector >> covector ATT RULES Covec
OTHER -         : covector,covector >> covector ATT RULES Covec
OTHER -         : covector >> covector    ATT RULES Covec
SPEC    Covec : transpose(transpose(_Va)) = _Va
ADDSPEC Covec : IF (listq(_Va)), (listq(_Vb)) transpose(_Va)*_Vb = dot(_Va,_Vb)
ADDSPEC Covec : IF (listq(_Va)), (listq(_Vb)) _Va*transpose(_Vb) = dot(transpose([_Va]),[_Vb])
ADDSPEC Covec : IF (listq(_Va)), (listq(_Ma)) transpose(_Va)*_Ma = transpose(_Va*_Ma)
ADDSPEC Covec : IF (not(sortleq(_Xnu, nil))) _Xnu*transpose(_Va) = transpose(_Xnu*_Va)
ADDSPEC Covec : transpose(_Va)+transpose(_Vb) = transpose(_Va+_Vb)
ADDSPEC Covec : transpose(_Va)-transpose(_Vb) = transpose(_Va-_Vb)
ADDSPEC Covec : -transpose(_Va) = transpose(-_Va)
# printed as a row [1 2 3] (up to 10 entries) when it is the whole output
SHOW transpose ATT show_covec

ALG MatrixRules
# products associated to the left, so that A*B*inverse(B) cancels
SPEC    MatrixRules : _Ma*(_Mb*_Mc) = _Ma*_Mb*_Mc
ADDSPEC MatrixRules : _Ma*(_Mb+_Mc) = _Ma*_Mb+_Ma*_Mc
ADDSPEC MatrixRules : (_Ma+_Mb)*_Mc = _Ma*_Mc+_Mb*_Mc
# numbers commute with matrices and go to the front
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) _Ma*_Xnu = _Xnu*_Ma
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) (_Xnu*_Ma)*_Mb = _Xnu*(_Ma*_Mb)
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) _Ma*(_Xnu*_Mb) = _Xnu*(_Ma*_Mb)
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))), (not(sortleq(_Ynu, nil))) _Xnu*(_Ynu*_Ma) = (_Xnu*_Ynu)*_Ma
# identity, zero, inverse
ADDSPEC MatrixRules : _Ma*Id = _Ma
ADDSPEC MatrixRules : Id*_Ma = _Ma
ADDSPEC MatrixRules : _Ma+Zm = _Ma
ADDSPEC MatrixRules : Zm+_Ma = _Ma
ADDSPEC MatrixRules : _Ma*Zm = Zm
ADDSPEC MatrixRules : Zm*_Ma = Zm
ADDSPEC MatrixRules : _Ma-_Ma = Zm
ADDSPEC MatrixRules : _Ma+_Ma = 2*_Ma
ADDSPEC MatrixRules : (_Ma+_Mb)-_Ma = _Mb
ADDSPEC MatrixRules : (_Ma+_Mb)-_Mb = _Ma
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))), (not(sortleq(_Ynu, nil))) _Xnu*_Ma+_Ynu*_Ma = (_Xnu+_Ynu)*_Ma
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) _Ma+_Xnu*_Ma = (1+_Xnu)*_Ma
ADDSPEC MatrixRules : _Ma*inverse(_Ma) = Id
ADDSPEC MatrixRules : inverse(_Ma)*_Ma = Id
ADDSPEC MatrixRules : _Ma*_Mb*inverse(_Mb) = _Ma
ADDSPEC MatrixRules : _Ma*inverse(_Mb)*_Mb = _Ma
# transpose, inverse and determinant of products: the order reverses
ADDSPEC MatrixRules : transpose(transpose(_Ma)) = _Ma
ADDSPEC MatrixRules : transpose(_Ma*_Mb) = transpose(_Mb)*transpose(_Ma)
ADDSPEC MatrixRules : transpose(_Ma*_Va) = transpose(_Va)*transpose(_Ma)
ADDSPEC MatrixRules : transpose(_Ma+_Mb) = transpose(_Ma)+transpose(_Mb)
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) transpose(_Xnu*_Ma) = _Xnu*transpose(_Ma)
ADDSPEC MatrixRules : transpose(Id) = Id
ADDSPEC MatrixRules : inverse(inverse(_Ma)) = _Ma
ADDSPEC MatrixRules : inverse(_Ma*_Mb) = inverse(_Mb)*inverse(_Ma)
ADDSPEC MatrixRules : IF (not(sortleq(_Xnu, nil))) inverse(_Xnu*_Ma) = mi(_Xnu)*inverse(_Ma)
ADDSPEC MatrixRules : inverse(Id) = Id
ADDSPEC MatrixRules : det(_Ma*_Mb) = det(_Ma)*det(_Mb)
ADDSPEC MatrixRules : det(transpose(_Ma)) = det(_Ma)
ADDSPEC MatrixRules : det(inverse(_Ma)) = mi(det(_Ma))
ADDSPEC MatrixRules : det(Id) = 1

# ---- matrix equations: solve(A*X == B, X) gives X = inverse(A)*B; the
# unknown is isolated from the left or from the right, as the product does
# not commute (the matrices it is divided by must be invertible)
OTHER ==        : matrix,matrix >> bool
FUNC  mfreeq    : algebra,algebra >> bool ATT SYMBOLIC freeq  # freeq of inc/helpers
FUNC  msolve    : bool,matrix >> matrix          # the solution of a matrix equation
FUNC  isom      : matrix,matrix,matrix >> matrix # u = r with the unknown x only in u
ALG MatrixSolve
SPEC    MatrixSolve : msolve(_Ma == _Mb, _Mc) = isom(_Ma - _Mb, Zm, _Mc)
ADDSPEC MatrixSolve : isom(_Mc, _Ma, _Mc) = _Ma
ADDSPEC MatrixSolve : IF (mfreeq(_Mb, _Mc)) isom(_Ma - _Mb, _Mc2, _Mc) = isom(_Ma, _Mc2 + _Mb, _Mc)
ADDSPEC MatrixSolve : IF (mfreeq(_Mb, _Mc)) isom(_Ma + _Mb, _Mc2, _Mc) = isom(_Ma, _Mc2 - _Mb, _Mc)
ADDSPEC MatrixSolve : IF (mfreeq(_Ma, _Mc)) isom(_Ma + _Mb, _Mc2, _Mc) = isom(_Mb, _Mc2 - _Ma, _Mc)
ADDSPEC MatrixSolve : IF (mfreeq(_Ma, _Mc)) isom(_Ma * _Mb, _Mc2, _Mc) = isom(_Mb, inverse(_Ma) * _Mc2, _Mc)
ADDSPEC MatrixSolve : IF (mfreeq(_Mb, _Mc)) isom(_Ma * _Mb, _Mc2, _Mc) = isom(_Ma, _Mc2 * inverse(_Mb), _Mc)
ADDSPEC MatrixSolve : IF (not(sortleq(_Xnu, nil))) isom(_Xnu * _Ma, _Mc2, _Mc) = isom(_Ma, mi(_Xnu) * _Mc2, _Mc)
ADDSPEC MatrixSolve : isom(transpose(_Ma), _Mc2, _Mc) = isom(_Ma, transpose(_Mc2), _Mc)
ADDSPEC MatrixSolve : isom(inverse(_Ma), _Mc2, _Mc) = isom(_Ma, inverse(_Mc2), _Mc)
ADDSPEC MatrixSolve : isom(- _Ma, _Mc2, _Mc) = isom(_Ma, - _Mc2, _Mc)

# help for ?name
HELP "det" "det(m)   the determinant of the matrix m (fraction-free elimination)"
HELP "inverse" "inverse(m)   the inverse matrix; also m^(-1)"
HELP "linsolve" "linsolve(m,b)   the solution x of m.x = b (b a vector or a matrix)"
HELP "transpose" "transpose(m)   rows become columns; transpose(v) of a vector is a covector:"
HELP "transpose" "  transpose(u)*v the inner product (a number), u*transpose(v) the outer product"
HELP "dot" "dot(a,b)   the matrix product, matrix times vector, or the scalar product"
HELP "identity" "identity(n)   the n x n unit matrix"
HELP "thread" "thread(u)   functions of lists element by element: sin([a,b]) = [sin(a), sin(b)]"
HELP "MatrixRules" "REWR t : MatrixRules   the rules for symbolic matrices (SYM A : matrix)"
HELP "MatrixSolve" "REWR msolve(A*X == B, X) : (MatrixSolve, MatrixRules)   solves for the matrix X"
