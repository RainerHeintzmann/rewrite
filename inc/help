# inc/help (2026): the help texts for ?name (loaded by inc/all).
# HELP "name" "text" adds a line to the help of name; a line that begins
# with ? shows it:  ?REWR   ?Int   ? alone lists the names. inc/list,
# inc/linalg, inc/solve and inc/rvector have their own help lines.

HELP "?" "rewrite: term rewriting with rule sets, see README.md and examples/."
HELP "?" "  ?name          help on a keyword, function or name (?REWR, ?Int, ?sin)"
HELP "?" "  TYPEOF term    the sort of a term;  TYPEOF f  the variants of a function"
HELP "?" "  REWR t : All   simplifies t;  REWR Int(x*sin(x),x) : RubiIntegrate"
HELP "?" "  QUIT           ends rewrite"

# ---- declarations
HELP "SORT" "SORT name [,name ..]            declares a sort (a data type), e.g. SORT real"
HELP "SUBSORT" "SUBSORT a,b [ATT conv]          every a is also a b (integer < rational);"
HELP "SUBSORT" "                                 conv converts a value; without ATT, b has no values"
HELP "REALNUM" "REALNUM sort                     the sort of number literals like 1.5 (values: double)"
HELP "INTNUM" "INTNUM sort ATT read            the sort of whole number literals like 3 (inc/exact)"
HELP "ATT" "ATT sort show,cmp,cpy,del        the C functions for the values of a sort"
HELP "ATT" "FUNC f : ... ATT name            f is calculated by the C function name"
HELP "ATT" "FUNC f : ... ATT SYMBOLIC name   f is a C function on terms (symfn.c)"
HELP "ATT" "FUNC f : ... ATT RULES alg       f is defined by the rule set alg"
HELP "SYM" "SYM name [,..] : sort            a symbol: stands for itself or holds a numerical"
HELP "SYM" "                                 value of its sort (x = 3; x = nothing removes it)"
HELP "TERM" "TERM name [,..] : sort           a name for a stored term (a list, an expression)"
HELP "PAT" "PAT name [,..] : sort            a pattern variable: matches any term in a rule"
HELP "NUMPAT" "NUMPAT name [,..] : sort         a pattern variable that only matches numbers"
HELP "FUNC" "FUNC f : s1,s2 >> s [LA1..LA5|RA|RU] [ATT ...]"
HELP "FUNC" "                                 declares a function or operator: argument sorts,"
HELP "FUNC" "                                 result sort, precedence; s++ for any number of args"
HELP "OTHER" "OTHER f : sorts >> sort [ATT ..]  another variant of f for other argument sorts"
HELP "BRA" "BRA [ ] : sorts >> sort          a function written with brackets, e.g. [a,b]"
HELP "LA1" "LA1 .. LA5   left-associative operators, LA5 binds strongest (+ is LA2, * LA3)"
HELP "RA" "RA   a right-associative operator (^)"
HELP "RU" "RU   a right-unary operator (!)"
HELP "SHOW" "SHOW f ATT name   prints terms with f by the C print function name; SHOW f: plainly"
HELP "SYMBOLIC" "SYMBOLIC 'role' = 'symbol'   the C helpers use symbol for the role ('+', 'cos', 'list')"
HELP "HOLD" "ATT SYMBOLIC HOLD name   the C function gets its arguments unevaluated"
HELP "RULES" "ATT RULES alg,(..)   the function is defined by these rule sets"
HELP "HELP" "HELP 'name' 'text'   adds a line to the help of name, shown by ?name"
HELP "TYPEOF" "TYPEOF term   the sort of the term; for a name its kind (SYM, TERM, PAT) and value"
HELP "TYPEOF" "TYPEOF f      the variants of the function f with their argument and result sorts"

# ---- rules
HELP "ALG" "ALG name   declares a rule set (an algebra)"
HELP "SPEC" "SPEC alg : left = right     the rule set alg has (only) this rule"
HELP "SPEC" "SPEC alg : alg1, (alg2, ..) alg is a list of rule sets; (..) are applied repeatedly"
HELP "ADDSPEC" "ADDSPEC alg : [IF cond, ..] left = right   adds a rule (with conditions) to alg"
HELP "IF" "in a rule: IF (cond), NIN(x,a), .. left = right   the rule applies if all conditions hold"
HELP "IF" "as a statement: IF (cond) block [ELSE block]"
HELP "IN" "IN(a,b)    condition: the term a occurs in b"
HELP "NIN" "NIN(x,a,b) condition: x occurs in none of a, b"
HELP "LB" "LB(a,b)    condition: a is lower than or equal to b in the order of terms"
HELP "REWR" "REWR term : alg [,alg ..]   rewrites term with the rule sets and prints the result"
HELP "REWR" "t = REWR term : alg         stores the result in the TERM t"
HELP "REWR" "rule sets: All (simplification), Integrate, RubiIntegrate, Solve (inc/solve), ..."
HELP "STEPS" "STEPS alg 'file'   shows each applied rule of alg (solution steps); STEPS alg '': off"
HELP "LIFT" "LIFT (f(A),..) TO (g(B),..)   the rules for f also hold for g (from groups to fields)"
HELP "OPT" "OPT A,B    the pattern variables A, B may be missing in a pattern (Rubi's a_.)"
HELP "DEFAULT" "DEFAULT + = 0   a missing operand of + has the value 0;  DEFAULT RIGHT ^ = 1"
HELP "RIGHT" "DEFAULT RIGHT ^ = 1   only the right operand of ^ may be missing"
HELP "COMM" "COMM +,*   patterns with + and * also match with swapped operands"

# ---- statements
HELP "INC" "INC 'file'   reads and executes a file (paths relative to the current folder)"
HELP "PRT" "PRT list     prints without a line break;  'text', term  prints with one"
HELP "PRTNUM" "PRTNUM 'format'   the C format of real numbers, e.g. PRTNUM '%.10g '"
HELP "OUT" "OUT 'file'   the output goes into the file;  OUT 'stdout'  back to the screen"
HELP "DATA" "DATA 'file'   opens a data file;  DATA x  reads the next number into the SYM x"
HELP "FOR" "FOR n = 1 TO 10 [STEP 2] DO block   a loop over a SYM"
HELP "WHILE" "WHILE (cond) block   a loop"
HELP "RETURN" "RETURN term   the result of a function defined by a block (FUNC f : .. ATT (..) {..})"
HELP "SYS" "SYS 'command'   runs a shell command"
HELP "EXE" "EXE f name   f is calculated by the C function name (old form of ATT)"
HELP "DEBUG" "DEBUG n   the debug level of the interpreter"
HELP "INFO" "INFO name   the kind and sorts of a name (older form of TYPEOF)"
HELP "QUIT" "QUIT   ends rewrite (also Ctrl-D, on Windows Ctrl-Z Enter)"

# ---- functions of the standard library (inc/all)
HELP "D" "D(f,x)   the derivative of f by x:  REWR D(sin(x)^2,x) : All"
HELP "Int" "Int(f,x)   the indefinite integral of f by x:"
HELP "Int" "  REWR Int(x^2,x) : Integrate          (a small rule set)"
HELP "Int" "  REWR Int(1/(1+x^2),x) : RubiIntegrate  (the translated Rubi rules)"
HELP "Integrate" "REWR Int(f,x) : Integrate   integrates with a small rule set (inc/integration)"
HELP "RubiIntegrate" "REWR Int(f,x) : RubiIntegrate   integrates with the translated Rubi rules"
HELP "All" "REWR t : All   simplifies t: numbers, powers, derivatives D, normal form"
HELP "normform" "normform(u)   the normal form of u: like terms collected, sums sorted"
HELP "I" "REWR I(a,b,f,x) : numerik,calc   the definite integral of f by x from a to b, numerically"
HELP "newton" "REWR newton(x0,f,D(f,x),x) : numerik,calc   a zero of f by Newton's method"
HELP "im" "im   the imaginary unit (im^2 = -1)"
HELP "pi" "pi   the number pi; exact in REWR (sin(pi/6) = 1/2), numerical in plain expressions"
