# inc/help (2026): the help texts for ?name (loaded by inc/all).
# HELP "name" "text" adds a line to the help of name; a line that begins
# with ? shows it:  ?REWR   ?Int   ? alone lists the names. inc/list,
# inc/linalg, inc/solve and inc/rvector have their own help lines.

HELP "?" "rewrite: term rewriting with rule sets, see README.md and examples/."
HELP "?" "  ?name          help on a keyword, function or name (?REWR, ?Int, ?sin)"
HELP "?" "  TYPEOF term    the sort of a term;  TYPEOF f  the variants of a function"
HELP "?" "  REWR t : All   simplifies t;  REWR Int(x*sin(x),x) : RubiIntegrate"
HELP "?" "  QUIT           ends rewrite"

# ---- declarations
HELP "SORT" "SORT name [,name ..]            declares a sort (a data type), e.g. SORT real"
HELP "SUBSORT" "SUBSORT a,b [ATT conv]          every a is also a b (integer < rational);"
HELP "SUBSORT" "                                 conv converts a value; without ATT, b has no values"
HELP "REALNUM" "REALNUM sort                     the sort of number literals like 1.5 (values: double)"
HELP "INTNUM" "INTNUM sort ATT read            the sort of whole number literals like 3 (inc/exact)"
HELP "ATT" "ATT sort show,cmp,cpy,del        the C functions for the values of a sort"
HELP "ATT" "FUNC f : ... ATT name            f is calculated by the C function name"
HELP "ATT" "FUNC f : ... ATT SYMBOLIC name   f is a C function on terms (symfn.c)"
HELP "ATT" "FUNC f : ... ATT RULES alg       f is defined by the rule set alg"
HELP "SYM" "SYM name [,..] : sort            a symbol: stands for itself or holds a numerical"
HELP "SYM" "                                 value of its sort (x = 3; x = nothing removes it)"
HELP "TERM" "TERM name [,..] : sort           a name for a stored term (a list, an expression)"
HELP "PAT" "PAT name [,..] : sort            a pattern variable: matches any term in a rule"
HELP "NUMPAT" "NUMPAT name [,..] : sort         a pattern variable that only matches numbers"
HELP "FUNC" "FUNC f : s1,s2 >> s [LA1..LA5|RA|RU] [ATT ...]"
HELP "FUNC" "                                 declares a function or operator: argument sorts,"
HELP "FUNC" "                                 result sort, precedence; s++ for any number of args"
HELP "OTHER" "OTHER f : sorts >> sort [ATT ..]  another variant of f for other argument sorts"
HELP "BRA" "BRA [ ] : sorts >> sort          a function written with brackets, e.g. [a,b]"
HELP "LA1" "LA1 .. LA5   left-associative operators, LA5 binds strongest (+ is LA2, * LA3)"
HELP "RA" "RA   a right-associative operator (^)"
HELP "RU" "RU   a right-unary operator (!)"
HELP "SHOW" "SHOW f ATT name   prints terms with f by the C print function name; SHOW f: plainly"
HELP "SYMBOLIC" "SYMBOLIC 'role' = 'symbol'   the C helpers use symbol for the role ('+', 'cos', 'list')"
HELP "HOLD" "ATT SYMBOLIC HOLD name   the C function gets its arguments unevaluated"
HELP "RULES" "ATT RULES alg,(..)   the function is defined by these rule sets"
HELP "HELP" "HELP 'name' 'text'   adds a line to the help of name, shown by ?name"
HELP "TYPEOF" "TYPEOF term   the sort of the term; for a name its kind (SYM, TERM, PAT) and value"
HELP "TYPEOF" "TYPEOF f      the variants of the function f with their argument and result sorts"
HELP "TYPEOF" "TYPEOF alg    a rule set: its rules (how many, a tree or an ordered list) or the"
HELP "TYPEOF" "              rule sets it consists of, the lists it is part of, the functions"
HELP "TYPEOF" "              it defines (ATT RULES):  TYPEOF All,  TYPEOF diff"
HELP "TYPEOF" "TYPEOF sort   a sort: values or not, wider and narrower sorts (SUBSORT), the"
HELP "TYPEOF" "              symbols, terms, pattern variables and functions of the sort"
HELP "TYPEOF" "?name shows the same after the help text"

# ---- rules
HELP "ALG" "ALG name   declares a rule set (an algebra); SPEC and ADDSPEC give it rules,"
HELP "ALG" "  REWR term : name  applies them; TYPEOF name shows what it holds"
HELP "SPEC" "SPEC alg : left = right     the rule set alg has (only) this rule"
HELP "SPEC" "SPEC alg : alg1, (alg2, ..) alg is a list of rule sets; (..) are applied repeatedly"
HELP "ADDSPEC" "ADDSPEC alg : [IF cond, ..] left = right   adds a rule (with conditions) to alg"
HELP "IF" "in a rule: IF (cond), NIN(x,a), .. left = right   the rule applies if all conditions hold"
HELP "IF" "as a statement: IF (cond) block [ELSE block]"
HELP "IN" "IN(a,b)    condition: the term a occurs in b"
HELP "NIN" "NIN(x,a,b) condition: x occurs in none of a, b"
HELP "LB" "LB(a,b)    condition: a is lower than or equal to b in the order of terms"
HELP "REWR" "REWR term : alg [,alg ..]   rewrites term with the rule sets and prints the result"
HELP "REWR" "t = REWR term : alg         stores the result in the TERM t"
HELP "REWR" "rule sets: All (simplification), Integrate, RubiIntegrate, Solve (inc/solve), ..."
HELP "ALIAS" "ALIAS 'name' = 'symbol'   the name is read as the symbol, e.g. ALIAS '×' = '*'"
HELP "ALIAS" "Unicode operators (≤ × ÷ ∧ → ...) are tokens of their own: a≤b is a ≤ b"
HELP "MAXSTEPS" "MAXSTEPS n   REWR stops after n rewrites (default 100000); MAXSTEPS: shows n"
HELP "MAXSTEPS" "rewrite --max-steps n   the same at the start"
HELP "MAXDEPTH" "MAXDEPTH n   REWR stops when the term is deeper than n levels (default 1000)"
HELP "MAXDEPTH" "             (a rule that keeps growing the term); MAXDEPTH: shows n"
HELP "MAXDEPTH" "rewrite --max-depth n   the same at the start"
HELP "AUTOSYM" "AUTOSYM real   a new name in a term is declared as SYM name : real (a note"
HELP "AUTOSYM" "               says so); on after inc/all. AUTOSYM: off, new names are errors"
HELP "STEPS" "STEPS alg 'file'   shows each applied rule of alg (solution steps); STEPS alg '': off"
HELP "LIFT" "LIFT (f(A),..) TO (g(B),..)   the rules for f also hold for g (from groups to fields)"
HELP "OPT" "OPT A,B    the pattern variables A, B may be missing in a pattern (Rubi's a_.)"
HELP "DEFAULT" "DEFAULT + = 0   a missing operand of + has the value 0;  DEFAULT RIGHT ^ = 1"
HELP "RIGHT" "DEFAULT RIGHT ^ = 1   only the right operand of ^ may be missing"
HELP "COMM" "COMM +,*   patterns with + and * also match with swapped operands"

# ---- statements
HELP "INC" "INC 'file'   reads and executes a file (paths relative to the current folder)"
HELP "PRT" "PRT list     prints without a line break;  'text', term  prints with one"
HELP "PRTNUM" "PRTNUM 'format'   the C format of real numbers, e.g. PRTNUM '%.10g '"
HELP "OUT" "OUT 'file'   the output goes into the file;  OUT 'stdout'  back to the screen"
HELP "DATA" "DATA 'file'   opens a data file;  DATA x  reads the next number into the SYM x"
HELP "FOR" "FOR n = 1 TO 10 [STEP 2] DO block   a loop over a SYM"
HELP "WHILE" "WHILE (cond) block   a loop"
HELP "RETURN" "RETURN term   the result of a function defined by a block (FUNC f : .. ATT (..) {..})"
HELP "SYS" "SYS 'command'   runs a shell command"
HELP "EXE" "EXE f name   f is calculated by the C function name (old form of ATT)"
HELP "DEBUG" "DEBUG n   the debug level of the interpreter"
HELP "INFO" "INFO name   the kind and sorts of a name (older form of TYPEOF)"
HELP "QUIT" "QUIT   ends rewrite (also Ctrl-D, on Windows Ctrl-Z Enter)"

# ---- functions of the standard library (inc/all)
HELP "D" "D(f,x)   the derivative of f by x, computed by the rules diff of All:"
HELP "D" "  f: the term to differentiate, x: the variable.  REWR D(sin(x)^2,x) : All"
HELP "D" "  gives 2*cos(x)*sin(x). Other symbols may depend on x: D(a*x,x) keeps D(a,x);"
HELP "D" "  deriv(f,x) takes them as constants (a partial derivative)"
HELP "deriv" "deriv(f,x)   the partial derivative of f by x: every term without x is a constant,"
HELP "deriv" "  computed at once (also outside REWR).  deriv(a*x^3,x) gives 3*a*x^2;"
HELP "deriv" "  REWR deriv(f,x) : All  simplifies the result; for a check of an integral:"
HELP "deriv" "  REWR cancel(deriv(Int(f,x),x)) : All  should give f back"
HELP "Dn" "Dn(f,x,n)   the n-th derivative of f by x:  REWR Dn(sin(x),x,3) : All gives -cos(x)"
HELP "Tay" "Tay(f,x,a,n)   the Taylor polynomial of f around the point x = a up to (x-a)^n:"
HELP "Tay" "  the sum of f^(k)(a)/k! (x-a)^k for k = 0..n"
HELP "Tay" "  f: the function (a term in x), x: the variable, a: the point (a number or"
HELP "Tay" "  term without x), n: the order (a whole number).  With the rule set All:"
HELP "Tay" "  REWR Tay(cos(x),x,0,6) : All  gives 1 - (1/2)*x^2 + (1/24)*x^4 - (1/720)*x^6"
HELP "Tay" "  REWR Tay(sin(x),x,pi/2,4) : All  powers of (x - (1/2)*pi)"
HELP "Tay" "  (taysum, with five arguments, is its internal helper; examples/15_series.rw)"
HELP "Sum" "Sum(k,a,b,u)   the sum of u for k = a, a+1, .., b:  REWR Sum(k,1,4,k^2) : All gives 30"
HELP "Sub" "Sub(u,x,a)   u with x replaced by a, by the rules Subst of All (+, *, ^, sin,"
HELP "Sub" "  cos, ln):  REWR Sub(x^2+1,x,a) : All gives 1 + a^2; subst does it for any term"
HELP "subst" "subst(u,x,a)   u with every x replaced by a, at once (a C function, for any"
HELP "subst" "  term):  subst(exp(x)*x,x,0) gives 0"
HELP "cancel" "cancel(u)   u as one fraction N/D, with the common factors of N and D cancelled:"
HELP "cancel" "  cancel((x^2-1)/(x-1)) gives 1 + x;  roots of numbers in the coefficients are"
HELP "cancel" "  reduced, so  REWR cancel(deriv(Int(1/(1+x^4),x),x)) : All  gives 1/(1+x^4);"
HELP "cancel" "  stays as it is if the common denominator would be too large"
HELP "expand" "expand(u)   u multiplied out:  expand((x+1)^3) gives x^3 + 3*x^2 + 3*x + 1"
HELP "collect" "collect(u)   like summands of u combined:  collect(x + 2*x + y) gives 3*x + y"
HELP "coeff" "coeff(p,x,n)   the coefficient of x^n in the polynomial p; coeff(p,x) of x^1:"
HELP "coeff" "  coeff(3*x^2+5*x+1,x,2) gives 3"
HELP "expon" "expon(p,x)   the degree of p in x:  expon(3*x^2+5*x+1,x) gives 2"
HELP "polyq" "polyq(p,x)   true if p is a polynomial in x; polyq(p,x,n): of degree n"
HELP "freeq" "freeq(u,x)   true if x does not occur in u (for conditions of rules)"
HELP "Int" "Int(f,x)   the indefinite integral of f by x:"
HELP "Int" "  REWR Int(x^2,x) : Integrate          (a small rule set)"
HELP "Int" "  REWR Int(1/(1+x^2),x) : RubiIntegrate  (the translated Rubi rules)"
HELP "Int" "Int(f,x,a,b)   the definite integral, also with a, b = infinity, -infinity:"
HELP "Int" "  Int(exp(-x^2),x,-infinity,infinity) gives pi^(1/2); for integrands that"
HELP "Int" "  are continuous on the real line (and heaviside, dirac), else it stays"
HELP "limit" "limit(u,x,infinity), limit(u,x,-infinity)   the limit if it is finite and known,"
HELP "limit" "  u: the term, x: the variable that goes to +-infinity (declare parameters with a"
HELP "limit" "  sign, SYM a : positive).  limit(x^2*exp(-x),x,infinity) = 0; else it stays"
HELP "laplace" "laplace(f,t,s)   the Laplace transform, Int(f*exp(-s*t),t,0,infinity):"
HELP "laplace" "  f: a function of the time t, s: the variable of the transform (SYM s : positive"
HELP "laplace" "  also allows the integral).  laplace(t^2,t,s) gives 2/s^3"
HELP "laplace" "  laplace(D(u(t),t),t,s) = s*laplace(u(t),t,s) - u(0)   (see examples/11_laplace.rw)"
HELP "invlaplace" "invlaplace(F,s,t)   the inverse Laplace transform of F(s), a function of t"
HELP "invlaplace" "  (partial fractions):  invlaplace(1/(s^2+3*s+2),s,t) gives exp(-t) - exp(-2*t)"
HELP "fourier" "fourier(f,t,w)   the Fourier transform, Int(f*exp(-im*w*t),t,-infinity,infinity):"
HELP "fourier" "  f: a function of t, w: the angular frequency."
HELP "fourier" "  fourier(exp(-a*abs(t)),t,w) = 2*a/(a^2+w^2)   (see examples/12_fourier.rw)"
HELP "invfourier" "invfourier(F,w,t)   the inverse, 1/(2 pi) Int(F*exp(im*w*t),w,-infinity,infinity):"
HELP "invfourier" "  F: a function of w, t: the variable of the result"
HELP "initial" "initial(u,t)   u at t = 0; initial(D(u(t),t),t) stays, give it by a rule"
HELP "infinity" "infinity (also ∞)   the bound of limits and integrals: limit(u,x,infinity)"
HELP "heaviside" "heaviside(x)   the unit step: 0 for x < 0, 1 for x > 0"
HELP "dirac" "dirac(x)   the delta distribution: Int(dirac(x-a)*f,x,-infinity,infinity) = f(a)"
HELP "knownpos" "knownpos(u), knownneg(u)   true if u > 0 (< 0) is known, e.g. for SYM a : positive"
HELP "Integrate" "REWR Int(f,x) : Integrate   integrates with a small rule set (inc/integration)"
HELP "RubiIntegrate" "REWR Int(f,x) : RubiIntegrate   integrates with the translated Rubi rules"
HELP "All" "REWR t : All   simplifies t: numbers, powers, derivatives D, Taylor polynomials,"
HELP "All" "  sums, substitution, normal form (TYPEOF All shows its rule sets)"
HELP "normform" "normform(u)   the normal form of u: like terms collected, products with a sum"
HELP "normform" "  multiplied out, positive summands first (a polynomial in one variable in"
HELP "normform" "  ascending powers); the last step of All"
HELP "I" "REWR I(a,b,f,x) : numerik,calc   the definite integral of f by x from a to b, numerically"
HELP "newton" "REWR newton(x0,f,D(f,x),x) : numerik,calc   a zero of f by Newton's method"
HELP "im" "im   the imaginary unit (im^2 = -1)"
HELP "pi" "pi   the number pi; exact in REWR (sin(pi/6) = 1/2), numerical in plain expressions"
