ALG Nat
SORT nat
ALG Bool
SORT bool
ALG Real
ALG integr
ALG diff1
ALG diff2
ALG more
SORT real

PAT A : real
PAT B : real
PAT C : real
PAT X : real
PAT Y : real
PAT Z : real
SYM x : real
SYM y : real
SYM z : real
SYM a : real
SYM b : real
SYM c : real
SYM e : real
SYM pi : real
# NUMPAT pi 3.1415

TERM q
TERM s
TERM h1
TERM h2
TERM h3

SYM m1 : real          # -1 
SYM 0 : real
SYM 1 : real
SYM 2 : real
SYM true : bool
SYM false : bool

FUNC ln    : real >> real
FUNC cos   : real >> real
FUNC sin   : real >> real
FUNC or    : real,real >> real LA1
FUNC and   : real,real >> real LA1
FUNC -     : real,real >> real LA2
FUNC +     : real,real >> real LA2
FUNC *     : real,real >> real LA3
FUNC /     : real,real >> real LA3    
FUNC ^     : real,real >> real LA4
FUNC Dt     : real,real >> real
FUNC S     : real,real >> real           # fuer solve z.B. S(x^2 (=0),x)
FUNC I     : real,real,real,real >> real

Nat = (nat;+,*)
Real = (real;+,*)
integr = (real;+,*)
more = (real;+,*)

SPEC 	      Real : 0+X   = X         # spezielle Konstanten
ADDSPEC     Real : X+0   = X
ADDSPEC     Real : X*0   = 0
ADDSPEC     Real : 0*X   = 0
ADDSPEC     Real : 1-1   = 0
ADDSPEC     Real : 1+m1  = 0
ADDSPEC     Real : m1+1  = 0
ADDSPEC     Real : m1*m1 = 1          # -1 * -1 = 1  wichtig : vor X*m1=m1*X
ADDSPEC     Real : 1*X   = X
ADDSPEC     Real : X*1   = X
ADDSPEC     Real : X^1   = X
ADDSPEC     Real : X^0   = 1
ADDSPEC     Real : 1^X   = 1
ADDSPEC     Real : 0^X   = 0
ADDSPEC     Real : ln e  = 1
ADDSPEC     Real : 2     = 1+1

ADDSPEC     Real : X/Y=X*Y^m1         # kein - und kein /
ADDSPEC     Real : X-Y=X+m1*Y

ADDSPEC     Real : X*m1 = m1*X        # alle -1 nach links

ADDSPEC     Real : X+(Y+Z)=X+Y+Z      # Assoziativgesetz
ADDSPEC     Real : X*(Y*Z)=X*Y*Z 

ADDSPEC     Real : X*(Y+Z)=X*Y+X*Z , (X+Y)*Z=X*Z+Y*Z  # Distributivgesetz
ADDSPEC     Real : X^Y^Z=X^(Y*Z)
ADDSPEC     Real : (A*B)^X=A^X*B^X
ADDSPEC     Real : X^(Y+Z)=X^Y*X^Z
ADDSPEC     Real : ln (X+Y)=ln X * ln Y

ADDSPEC     Real : S(X*Y,Z)= (S(X,Z)) or (S(Y,Z))

# ++++++++++++++++++++++++ DIFFERENTIALRECHNUNG ++++++++++++++++++++++++++

SPEC        diff1 : 0*X = 0,X*0=0,X+0=X,0+X=X
ADDSPEC     diff1 : Dt(X,X) = 1         # spezielle Konstanten
ADDSPEC     diff1 : Dt(e,X) = 0
ADDSPEC     diff1 : Dt(pi,X)= 0
ADDSPEC     diff1 : Dt(m1,X) = 0
ADDSPEC     diff1 : Dt(0,X) = 0
ADDSPEC     diff1 : Dt(1,X) = 0
ADDSPEC     diff1 : Dt(2,X) = 0

ADDSPEC     diff1 : Dt(ln X,Z) = X^m1 * Dt(X,Z)
ADDSPEC     diff1 : Dt(e^X,Z)  = e^X * Dt(X,Z)
ADDSPEC     diff1 : Dt(sin X,Z)= cos X * Dt(X,Z)
ADDSPEC     diff1 : Dt(cos X,Z)= m1 * sin X * Dt(X,Z)

ADDSPEC     diff1 : Dt(X*Y,Z)=Dt(X,Z)*Y+Dt(Y,Z)*X   # Allg. Differenziationsregeln
ADDSPEC     diff1 : Dt(X+Y,Z)=Dt(X,Z)+Dt(Y,Z)
ADDSPEC     diff1 : Dt(X^Y,Z)=X^Y*Dt(ln X * Y,Z)

# ++++++++++++++++++++++++ INTERALE ++++++++++++++++++++++++++++++++++++++

SPEC        integr : I(A,B,X+Y,Z) = I(A,B,X,Z)+I(A,B,Y,Z)
ADDSPEC     integr : NIN (Y,C) I(A,B,C*X,Y) = C*I(A,B,X,Y)

ADDSPEC     integr : I(A,A,X,Y) = 0
ADDSPEC     integr : NIN (Z,C) I(A,B,C,Z)   = C*(A+ m1*B)

ADDSPEC     integr : NIN (X,Y) I(A,B,Y^X,X) = (Y^A + m1*Y^B) * (ln Y)^m1
ADDSPEC     integr : NIN (X,Y) I(A,B,sin X,X) = m1 * (cos A + m1*cos B)
ADDSPEC     integr : NIN (X,Y) I(A,B,cos X,X) = sin A + m1 * sin B


ADDSPEC     integr : NIN (Z,C and Y) I(A,B,(X+C)^Y,X) = I(A+C,B+C,X^Y,X)
ADDSPEC     integr : NIN (Z,C and Y) I(A,B,(C+X)^Y,X) = I(A+C,B+C,X^Y,X)

ADDSPEC     integr :                 I(A,B,X^m1,X)       = ln A + m1*ln B

ADDSPEC     integr : NIN (X,Y)       I(A,B,X^Y,X)       = (Y+1)^m1*(A^(Y+1)+m1*B^(Y+1))

# +++++++++++ Algebra zum weiteren Vereinfachen und zusammenfassen ++++++++++++

SPEC        more : m1*m1 = 1          # -1 * -1 = 1  wichtig : vor X*m1=m1*X
ADDSPEC     more : X*m1=m1*X
ADDSPEC     more : 1+m1  = 0
ADDSPEC     more : m1+1  = 0

ADDSPEC     more : X*(Y*Z)=X*Y*Z,X+(Y+Z)=X+Y+Z  # Assoziativgesetz
ADDSPEC     more : X*(Y/Z)=X*Y/Z,X+(Y-Z)=X+Y-Z  # Assoziativgesetz

ADDSPEC     more : X^Y*X^Z=X^(Y+Z),X^Y*X=X^(Y+1),X*X^Y=X^(Y+1)
ADDSPEC     more : X*Y+Z*Y=Y*(X+Z),X*Y+X*Z=X*(Y+Z),X*Y+Y*Z=Y*(X+Z),X*Y+Z*X=X*(Y+Z)
ADDSPEC     more : X*Y*Z+A*Y=Y*(X*Z+A),X*Y*Z+Y*A=Y*(X*Z+A) # deckt nur weniges ab
ADDSPEC     more : A*Y+X*Y*Z=Y*(X*Z+A),Y*A+X*Y*Z=Y*(X*Z+A)
ADDSPEC     more : X*Y*Z+A*Y*B=Y*(X*Z+A*B)
ADDSPEC     more : X+Y*X=X*(1+Y),X+X*Y=X*(1+Y),X*Y+X=X*(1+Y),X*Y+Y=Y*(1+X)
ADDSPEC     more : X-Y*X=X*(Y-1),X-X*Y=X*(Y-1),X*Y-X=X*(Y-1),X*Y-Y=Y*(X-1)
ADDSPEC     more : X+X=2*X

ADDSPEC     more : X^m1=1/X,X^(m1*Y)=1/X^Y
ADDSPEC     more : m1*X+Y=Y-X , Y+m1*X=Y-X 
ADDSPEC     more : m1+Y=Y-1 , Y+m1=Y-1 

ADDSPEC     more : 1/X*Y=Y/X,X*1/Y=X/Y
ADDSPEC     more : X/Y/Z=X/(Y*Z)
ADDSPEC     more : X/X=1       # kritisch wegen Definitionsbereich !!
ADDSPEC     more : A*X/X=1
ADDSPEC     more : X*A/X=1
ADDSPEC     more : X/Y*Y=X
ADDSPEC     more : Y*X/Y=X

ADDSPEC     more : 0+X   = X         # spezielle Konstanten
ADDSPEC     more : X+0   = X
ADDSPEC     more : X*0   = 0
ADDSPEC     more : 0*X   = 0
ADDSPEC     more : 1*X   = X
ADDSPEC     more : X*1   = X
ADDSPEC     more : 1-1   = 0


