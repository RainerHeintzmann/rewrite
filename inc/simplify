# inc/simplify (2026), loaded by inc/all after inc/helpers:
# the rule list All ends with the normal form (normform, symfn.c): like
# terms collected, also inside subtracted sums (a + b - (a + b) is 0), sums
# sorted, positive terms first, quotients as A/B. Without it, D and deriv
# left results such as  2*x*cos(x) + x^2*sin(x) - (2*x*cos(x)).
# normalq(u) is true if normform would not change u, so the rule ends.
FUNC  normalq : real >> bool    ATT SYMBOLIC normalq
OTHER normalq : number >> bool  ATT SYMBOLIC normalq

ALG Final
SPEC Final : IF (not(normalq(_Xnu))) _Xnu = normform(_Xnu)

# exp(a)*exp(b) = exp(a+b): after the normal form, which puts the factors
# exp next to each other, then the normal form once more
ALG Expprod
SPEC    Expprod : exp _Xnu * exp _Ynu = exp(normform(_Xnu+_Ynu))
ADDSPEC Expprod : _Znu * exp _Xnu * exp _Ynu = _Znu * exp(normform(_Xnu+_Ynu))

SPEC All : Std,Doit,(Linear,Compl,diff,GrRi),AGroup,integr,(Subst,GrRi),Std,Combine,NoMi,Final,Expprod,Final
