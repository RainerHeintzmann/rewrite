# derivative: a function defined by rules (ATT RULES), with the rules Linear, diff
# of inc/alg; unlike D, every term without x counts as a constant
ALG DerivDef
ALG DerivConst
FUNC deriv     : real,real >> real        ATT RULES DerivDef,(DerivConst,Linear,diff)
SPEC DerivDef : deriv(X,Y) = D(X,Y)
SPEC DerivConst : IF NIN(Z,X) D(X,Z) = 0
