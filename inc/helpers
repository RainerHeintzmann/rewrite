# inc/helpers (2026)
# Symbolic helper functions (in C, symfn.c), mainly for the
# rule-based integration (inc/integration). The names follow Rubi's
# helper functions in lower case (FreeQ -> freeq).
# They get the terms themselves, not their numerical values.
# Needs inc/all (sorts real and bool).

# ---- Predicates (result true/false, for conditions) ----
FUNC freeq     : real,real >> bool        ATT SYMBOLIC freeq      # x does not occur in u
FUNC integerq  : real >> bool             ATT SYMBOLIC integerq   # u is an integer
FUNC integersq : real++ >> bool           ATT SYMBOLIC integersq  # all are integers
FUNC rationalq : real++ >> bool           ATT SYMBOLIC rationalq  # all are numbers
FUNC posq      : real >> bool             ATT SYMBOLIC posq       # u has a positive form
FUNC negq      : real >> bool             ATT SYMBOLIC negq       # u has a negative form
FUNC eqq       : real,real >> bool        ATT SYMBOLIC eqq        # u = v
FUNC neq       : real,real >> bool        ATT SYMBOLIC neq        # u not equal to v
FUNC igtq      : real,real >> bool        ATT SYMBOLIC igtq       # u integer and > n
FUNC iltq      : real,real >> bool        ATT SYMBOLIC iltq       # u integer and < n
FUNC igeq      : real,real >> bool        ATT SYMBOLIC igeq       # u integer and >= n
FUNC ileq      : real,real >> bool        ATT SYMBOLIC ileq       # u integer and <= n
FUNC oddq      : real >> bool             ATT SYMBOLIC oddq       # u odd integer
FUNC polyq     : real,real >> bool        ATT SYMBOLIC polyq      # polynomial in x
OTHER polyq    : real,real,real >> bool   ATT SYMBOLIC polyq      # polynomial of degree n
FUNC linearq   : real,real >> bool        ATT SYMBOLIC linearq    # polynomial of degree 1
FUNC sumq      : real >> bool             ATT SYMBOLIC sumq
FUNC nonsumq   : real >> bool             ATT SYMBOLIC nonsumq
FUNC gtq : real,real >> bool             ATT SYMBOLIC gtq    # Rubi: GtQ, false unless numbers
FUNC ltq : real,real >> bool             ATT SYMBOLIC ltq
FUNC geq : real,real >> bool             ATT SYMBOLIC geq
FUNC leq : real,real >> bool             ATT SYMBOLIC leq
FUNC productq  : real >> bool             ATT SYMBOLIC productq
FUNC powerq    : real >> bool             ATT SYMBOLIC powerq
FUNC fractionq : real++ >> bool           ATT SYMBOLIC fractionq     # no integers
FUNC halfintegerq : real++ >> bool        ATT SYMBOLIC halfintegerq  # half-integers
FUNC nicesqrtq : real >> bool             ATT SYMBOLIC nicesqrtq     # number > 0

