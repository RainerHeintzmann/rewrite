# inc/helpers (2026)
# Symbolische Hilfsfunktionen (in C, symfkt.c), vor allem fuer die
# regelbasierte Integration (inc/integration). Die Namen folgen Rubis
# Hilfsfunktionen in Kleinschreibung (FreeQ -> freeq).
# Sie bekommen die Terme selbst, nicht deren Zahlenwerte.
# Benoetigt inc/all (Sorten real und bool).

# ---- Praedikate (Ergebnis wahr/falsch, fuer Bedingungen) ----
FUNC freeq     : real,real >> bool        ATT SYMBOLIC freeq      # x kommt in u nicht vor
FUNC integerq  : real >> bool             ATT SYMBOLIC integerq   # u ist eine ganze Zahl
FUNC integersq : real++ >> bool           ATT SYMBOLIC integersq  # alle sind ganze Zahlen
FUNC rationalq : real++ >> bool           ATT SYMBOLIC rationalq  # alle sind Zahlen
FUNC posq      : real >> bool             ATT SYMBOLIC posq       # u hat positive Form
FUNC negq      : real >> bool             ATT SYMBOLIC negq       # u hat negative Form
FUNC eqq       : real,real >> bool        ATT SYMBOLIC eqq        # u = v
FUNC neq       : real,real >> bool        ATT SYMBOLIC neq        # u ungleich v
FUNC igtq      : real,real >> bool        ATT SYMBOLIC igtq       # u ganz und > n
FUNC iltq      : real,real >> bool        ATT SYMBOLIC iltq       # u ganz und < n
FUNC polyq     : real,real >> bool        ATT SYMBOLIC polyq      # Polynom in x
OTHER polyq    : real,real,real >> bool   ATT SYMBOLIC polyq      # Polynom vom Grad n
FUNC linearq   : real,real >> bool        ATT SYMBOLIC linearq    # Polynom vom Grad 1
FUNC sumq      : real >> bool             ATT SYMBOLIC sumq
FUNC nonsumq   : real >> bool             ATT SYMBOLIC nonsumq
FUNC gtq : real,real >> bool             ATT SYMBOLIC gtq    # Rubi: GtQ, falsch wenn keine Zahlen
FUNC ltq : real,real >> bool             ATT SYMBOLIC ltq
FUNC geq : real,real >> bool             ATT SYMBOLIC geq
FUNC leq : real,real >> bool             ATT SYMBOLIC leq
FUNC productq  : real >> bool             ATT SYMBOLIC productq
FUNC powerq    : real >> bool             ATT SYMBOLIC powerq
FUNC fractionq : real++ >> bool           ATT SYMBOLIC fractionq     # keine ganzen Zahlen
FUNC halfintegerq : real++ >> bool        ATT SYMBOLIC halfintegerq  # halbzahlig
FUNC nicesqrtq : real >> bool             ATT SYMBOLIC nicesqrtq     # Zahl > 0

