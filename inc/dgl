# solving differential equations
# input : P2 = f(x,P0) = P0'
# P4 = initial value ( x0) (normally : == 0)
# P1 = initial value ( == P0(x0)) (y0)
# P3 = initial polynomial (normally == x)
# example :
P2 = 1+P0^2
P1 = 0
P4 = 0

P3 = x
FUNC Picard : real,real >> real   # e.g. Picard(2,x)

P0 = Picard(_N- 1,_X)
ALG Pic

SPEC    Pic : Picard(0,_X)=P3
ADDSPEC Pic : IF (_N>0) Picard(_N,_X)= P1+I(P4,x,P2,x)
ADDSPEC Pic : IF (_N>1) (_X+_Y)^_N=(_X+_Y)*(_X+_Y)^(_N- 1)

ALG Pica
SPEC Pica : (Pic;Real;Mulord;integr)
