SORT rmatrix
ATT rmatrix  show_mat,cmp_mat,cpy_mat,del_mat

OTHER + : rmatrix,rmatrix >> rmatrix  ATT mat_add      # matrix addition
OTHER * : rmatrix,rmatrix >> rmatrix  ATT mat_mul      # matrix multiplication
OTHER * : real,rmatrix >> rmatrix     ATT real_mul_mat # real times matrix
OTHER * : rmatrix,real >> rmatrix     ATT mat_mul_real # real times matrix
OTHER * : rmatrix,rvector >> rvector  ATT mat_mul_vec  # matrix times vector
FUNC trans : rmatrix >> rmatrix ATT mat_trans

FUNC det  : rmatrix >> real
OTHER elem : rmatrix,real,real >> real ATT elem_mat        # matrix,row,column
OTHER [ : rmatrix,real,real >> real ATT elem_mat          # Matrix[row,column]
FUNC nullmat : real,real >> rmatrix ATT null_mat          # rows,columns
FUNC einsmat : real,real >> rmatrix ATT eins_mat          # rows,columns
FUNC chmat : rmatrix,real,real,real >> rmatrix ATT ch_mat # matrix,row,column,value

