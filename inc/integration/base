# inc/integration/base
# Basics for integration following Rubi (Rule-based integration, A. Rich).
# Needs inc/all. Loaded by inc/integration/all.
#
# Int(f,x)   indefinite integral (result without integration constant)
#
# Translation of the Rubi patterns:
#   x_         -> Xv
#   a_         -> Pa   (parameter, must be present)
#   a_.        -> Qa   (optional parameter, OPT; if missing, 0 is used for +,
#                       1 for * and for the exponent of ^)
#   FreeQ[{a,b},x]  -> NIN(Xv,Qa,Qb)
#   several conditions are separated by commas:  IF NIN(Xv,Pm), (Pm != -1)
# Factors and summands may appear in any order (COMM +,*).

# 2026: the rules are written for the sort number (inc/alg), so that they
# also apply to terms with the imaginary unit im; a term of reals keeps the
# real variants of the functions.
FUNC Int : real,real >> real
OTHER Int : number,number >> number
FUNC inthide      : real,real >> real ATT SYMBOLIC inthide       # Rubi IntHide = Int
OTHER inthide     : number,number >> number ATT SYMBOLIC inthide
FUNC unintegrable : real,real >> real                   # Rubi Unintegrable: stays as is, IntOut turns it into Int
OTHER unintegrable : number,number >> number

PAT Uv,Vv,Wv,Xv : number                  # arbitrary terms
PAT Pa,Pb,Pc,Pd,Pe,Pf,Pm,Pn : number      # Rubi a_ , b_ , ...
PAT Qa,Qb,Qc,Qd,Qe,Qf,Qm,Qn : number      # Rubi a_., b_., ...
NUMPAT Kc,Kd,Kf : real                       # numbers only

# ---------------- Normal form as in Mathematica ----------------
# x-y -> x+(-1)*y,  x/y -> x*y^(-1),  sqrt(x) -> x^0.5,  e^x -> exp(x),
# numeric factors to the front, multiply out products with sums.
# These rules come before OPT/COMM and are therefore not extended.
ALG IntNorm
SPEC    IntNorm : Uv-Vv   = Uv+(-1)*Vv
ADDSPEC IntNorm : -Uv     = (-1)*Uv
ADDSPEC IntNorm : Uv/Vv   = Uv*Vv^(-1)
ADDSPEC IntNorm : mi Uv   = Uv^(-1)
ADDSPEC IntNorm : sqrt Uv = Uv^(1/2)
ADDSPEC IntNorm : IF (abs(Kf - e) < 1e-9) Kf^Uv = exp(Uv)
ADDSPEC IntNorm : IF (Kc == 0) Uv^Kc = 1
ADDSPEC IntNorm : IF (Kc == 1) Uv^Kc = Uv
ADDSPEC IntNorm : IF (Kc == 1) Kc*Uv = Uv
ADDSPEC IntNorm : IF (Kc == 0) Kc*Uv = 0
ADDSPEC IntNorm : IF (Kc == 0) Kc+Uv = Uv
ADDSPEC IntNorm : IF (Kc == 0) Uv+Kc = Uv
ADDSPEC IntNorm : IF (is_int(Kc)) (Uv^Vv)^Kc = Uv^(Vv*Kc)   # not (x^2)^0.5 = x
ADDSPEC IntNorm : Uv*Uv = Uv^2
ADDSPEC IntNorm : Uv^Vv*Uv = Uv^(Vv+1)
ADDSPEC IntNorm : Uv*Uv^Vv = Uv^(Vv+1)
ADDSPEC IntNorm : Uv^Vv*Uv^Wv = Uv^(Vv+Wv)
# (order matters: combine two numbers first, otherwise
#  5*(-1*a) and -1*(5*a) alternate endlessly)
ADDSPEC IntNorm : Kc*(Kd*Uv) = (Kc*Kd)*Uv
ADDSPEC IntNorm : Uv*Kc = Kc*Uv
ADDSPEC IntNorm : (Kc*Uv)*Vv = Kc*(Uv*Vv)
ADDSPEC IntNorm : Uv*(Kc*Vv) = Kc*(Uv*Vv)
ADDSPEC IntNorm : Uv*(Vv+Wv) = Uv*Vv+Uv*Wv
ADDSPEC IntNorm : (Vv+Wv)*Uv = Vv*Uv+Wv*Uv

# ---------------- Conversion back for output ----------------
# negative numbers as minus sign and reciprocals as fraction, so that All
# prints the usual form
# Normal form for the automatically translated Rubi rules (rubi/all):
# like IntNorm, but without multiplying out (Mathematica does not multiply
# out products with sums by itself).
# 2026: e as a symbol without numeric value (like E in Mathematica); ln(eE) = 1
SYM eE : positive
# 2026: the imaginary unit im of inc/alg (Mathematica's I, Julia's im) stays
# a symbol in terms; the C helpers know im^2 = -1 (role "im").

ALG RubiNorm
SPEC    RubiNorm : Uv-Vv   = Uv+(-1)*Vv
ADDSPEC RubiNorm : -Uv     = (-1)*Uv
ADDSPEC RubiNorm : Uv/Vv   = Uv*Vv^(-1)
ADDSPEC RubiNorm : mi Uv   = Uv^(-1)
ADDSPEC RubiNorm : sqrt Uv = Uv^(1/2)
ADDSPEC RubiNorm : exp(Uv) = eE^Uv   # like Mathematica: E^u, so that F^u patterns match
ADDSPEC RubiNorm : IF (abs(Kf - e) < 1e-9) Kf^Uv = eE^Uv
ADDSPEC RubiNorm : ln(eE) = 1        # exact, for Rubi's Log[E]
ADDSPEC RubiNorm : IF (Kc == 0) Uv^Kc = 1
ADDSPEC RubiNorm : IF (Kc == 1) Uv^Kc = Uv
ADDSPEC RubiNorm : IF (Kc == 1) Kc*Uv = Uv
ADDSPEC RubiNorm : IF (Kc == 0) Kc*Uv = 0
ADDSPEC RubiNorm : IF (Kc == 0) Kc+Uv = Uv
ADDSPEC RubiNorm : IF (Kc == 0) Uv+Kc = Uv
ADDSPEC RubiNorm : IF (is_int(Kc)) (Uv^Vv)^Kc = Uv^(Vv*Kc)   # not (x^2)^0.5 = x
ADDSPEC RubiNorm : IF (is_int(Kc)) (Uv*Vv)^Kc = Uv^Kc*Vv^Kc   # like Mathematica: 1/(u v) = u^-1 v^-1
ADDSPEC RubiNorm : Uv*Uv = Uv^2
ADDSPEC RubiNorm : Uv^Vv*Uv = Uv^(Vv+1)
ADDSPEC RubiNorm : Uv*Uv^Vv = Uv^(Vv+1)
ADDSPEC RubiNorm : Uv^Vv*Uv^Wv = Uv^(Vv+Wv)
# (order matters: combine two numbers first, otherwise
#  5*(-1*a) and -1*(5*a) alternate endlessly)
ADDSPEC RubiNorm : Kc*(Kd*Uv) = (Kc*Kd)*Uv
ADDSPEC RubiNorm : Uv*Kc = Kc*Uv
ADDSPEC RubiNorm : (Kc*Uv)*Vv = Kc*(Uv*Vv)
ADDSPEC RubiNorm : Uv*(Kc*Vv) = Kc*(Uv*Vv)
# ---------------- Conversion back for output ----------------
# negative numbers as minus sign and reciprocals as fraction, so that All
# prints the usual form

# 2026: integration variables for substitutions (intsubst): Xnn stands for
# a non-negative expression like sqrt(a+b*x), Xre for an arbitrary one
SYM Xnn : nonneg
SYM Xre : real
PAT Un : nonneg
ADDSPEC RubiNorm : (Un^Vv)^Wv = Un^(Vv*Wv)   # only for nonneg (sqrt(x^2) = x)

ALG IntOut
SPEC    IntOut : IF (Kc < 0) Uv^Kc = mi(Uv^(-Kc))
ADDSPEC IntOut : IF (Kc == -1) Kc*Uv = -Uv
ADDSPEC IntOut : IF (Kc < 0), (Kc != -1) Kc*Uv = -((-Kc)*Uv)
ADDSPEC IntOut : unintegrable(Uv,Vv) = Int(Uv,Vv)
# 2026: convert arguments with pi/2 (from r4_0_unify) back: sin(pi/2+u) = cos(u) ...
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) sin(Kc+Uv) = cos(Uv)
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) sin(Uv+Kc) = cos(Uv)
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) cos(Kc+Uv) = -(sin(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) cos(Uv+Kc) = -(sin(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) tan(Kc+Uv) = -(cot(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) tan(Uv+Kc) = -(cot(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) cot(Kc+Uv) = -(tan(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) cot(Uv+Kc) = -(tan(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) sec(Kc+Uv) = -(csc(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) sec(Uv+Kc) = -(csc(Uv))
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) csc(Kc+Uv) = sec(Uv)
ADDSPEC IntOut : IF (abs(Kc - pi/2) < 1e-9) csc(Uv+Kc) = sec(Uv)
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) sin(Kc+Uv) = -(cos(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) sin(Uv+Kc) = -(cos(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) cos(Kc+Uv) = sin(Uv)
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) cos(Uv+Kc) = sin(Uv)
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) tan(Kc+Uv) = -(cot(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) tan(Uv+Kc) = -(cot(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) cot(Kc+Uv) = -(tan(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) cot(Uv+Kc) = -(tan(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) sec(Kc+Uv) = csc(Uv)
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) sec(Uv+Kc) = csc(Uv)
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) csc(Kc+Uv) = -(sec(Uv))
ADDSPEC IntOut : IF (abs(Kc + pi/2) < 1e-9) csc(Uv+Kc) = -(sec(Uv))
# shift by pi (twice pi/2): sin(u+pi) = -sin(u), ...
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) sin(Kc+Uv) = -(sin(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) sin(Uv+Kc) = -(sin(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) cos(Kc+Uv) = -(cos(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) cos(Uv+Kc) = -(cos(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) tan(Kc+Uv) = tan(Uv)
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) tan(Uv+Kc) = tan(Uv)
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) cot(Kc+Uv) = cot(Uv)
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) cot(Uv+Kc) = cot(Uv)
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) sec(Kc+Uv) = -(sec(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) sec(Uv+Kc) = -(sec(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) csc(Kc+Uv) = -(csc(Uv))
ADDSPEC IntOut : IF (abs(abs(Kc) - pi) < 1e-9) csc(Uv+Kc) = -(csc(Uv))
ADDSPEC IntOut : IF (abs(Kf - e) < 1e-9) Kf^Uv = exp(Uv)
ADDSPEC IntOut : eE^Uv = exp(Uv)
ADDSPEC IntOut : ln(eE) = 1
ADDSPEC IntOut : ln(eE^Uv) = Uv          # for real u
ADDSPEC IntOut : ln(exp(Uv)) = Uv

# ---------------- Settings for the Rubi rules ----------------
# (deleted again at the end of inc/integration/all)
OPT Qa,Qb,Qc,Qd,Qe,Qf,Qm,Qn
DEFAULT + = 0
DEFAULT * = 1
DEFAULT RIGHT ^ = 1
COMM +,*

# ---------------- Rubi 9.1 Integrand simplification rules (selection) -----
ALG IntRubi
# Int[u_, x_Symbol] := IntSum[u, x] /; SumQ[u]
SPEC    IntRubi : Int(Uv+Vv,Xv) = Int(Uv,Xv)+Int(Vv,Xv)
# Int[a_, x_Symbol] := a*x /; FreeQ[a, x]
ADDSPEC IntRubi : IF NIN(Xv,Pa) Int(Pa,Xv) = Pa*Xv
# Int[a_*u_, x_Symbol] := a*Int[u, x] /; FreeQ[a, x]
ADDSPEC IntRubi : IF NIN(Xv,Pa) Int(Pa*Uv,Xv) = Pa*Int(Uv,Xv)
