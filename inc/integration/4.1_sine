# inc/integration/4.1_sine
# Translation of Rubi 4.17.3 (github.com/RuleBasedIntegration/Rubi,
# commit 61e9c18), sections
#   4 Trig functions / 4.1 Sine / 4.1.1.1 (a+b sin)^n          (rules 5, 6)
#   4 Trig functions / 4.1 Sine / 4.1.10 (c+d x)^m (a+b sin)^n (rule 1)
# Copyright (c) 2018 Rule-Based-Integration Organization, MIT license,
# see inc/integration/LICENSE.Rubi. Translated 2026.
# Notation of the patterns: see inc/integration/base.
# Rubi writes cos(z) as sin(z+Pi/2). The cos rules here are the
# corresponding sin rules with this shift, written out.

# Int[sin[c_. + d_.*x_], x_Symbol] := -Cos[c + d*x]/d /; FreeQ[{c, d}, x]
ADDSPEC IntRubi : IF NIN(_Xv,_Qc,_Qd) Int(sin(_Qc+_Qd*_Xv),_Xv) = -cos(_Qc+_Qd*_Xv)/_Qd
# Int[sin[c_. + Pi/2 + d_.*x_], x_Symbol] := Sin[c + d*x]/d /; FreeQ[{c, d}, x]
ADDSPEC IntRubi : IF NIN(_Xv,_Qc,_Qd) Int(cos(_Qc+_Qd*_Xv),_Xv) = sin(_Qc+_Qd*_Xv)/_Qd

# Int[(c_. + d_.*x_)^m_.*sin[e_. + f_.*x_], x_Symbol] :=
#    -(c + d*x)^m*Cos[e + f*x]/f + d*m/f*Int[(c + d*x)^(m - 1)*Cos[e + f*x], x]
#    /; FreeQ[{c, d, e, f}, x] && GtQ[m, 0]
ADDSPEC IntRubi : IF NIN(_Xv,_Qc,_Qd,_Qe,_Qf), (_Qm > 0) \
                  Int((_Qc+_Qd*_Xv)^_Qm*sin(_Qe+_Qf*_Xv),_Xv) = \
                  -(_Qc+_Qd*_Xv)^_Qm*cos(_Qe+_Qf*_Xv)/_Qf \
                  + _Qd*_Qm/_Qf*Int((_Qc+_Qd*_Xv)^(_Qm-1)*cos(_Qe+_Qf*_Xv),_Xv)

# the same rule with e -> e+Pi/2 (cos):
#    (c + d*x)^m*Sin[e + f*x]/f - d*m/f*Int[(c + d*x)^(m - 1)*Sin[e + f*x], x]
ADDSPEC IntRubi : IF NIN(_Xv,_Qc,_Qd,_Qe,_Qf), (_Qm > 0) \
                  Int((_Qc+_Qd*_Xv)^_Qm*cos(_Qe+_Qf*_Xv),_Xv) = \
                  (_Qc+_Qd*_Xv)^_Qm*sin(_Qe+_Qf*_Xv)/_Qf \
                  - _Qd*_Qm/_Qf*Int((_Qc+_Qd*_Xv)^(_Qm-1)*sin(_Qe+_Qf*_Xv),_Xv)
