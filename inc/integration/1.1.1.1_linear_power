# Int[(a_. + b_.*x_)^m_, x_Symbol] := (a + b*x)^(m + 1)/(b*(m + 1)) /; FreeQ[{a, b, m}, x] && NeQ[m, -1]
ADDSPEC IntRubi : IF NIN(_Xv,_Qa,_Qb,_Pm), (_Pm != -1) Int((_Qa+_Qb*_Xv)^_Pm,_Xv) = (_Qa+_Qb*_Xv)^(_Pm+1)/(_Qb*(_Pm+1))
