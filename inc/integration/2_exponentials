# F^(g*(e+f*x)) wird fuer F = E als exp(e+f*x) geschrieben (g, n, b = 1),
# fuer eine Zahl F als Kf^(e+f*x).

# Int[(F_^(c_.*(a_. + b_.*x_)))^n_., x_Symbol] := (F^(c*(a + b*x)))^n/(b*c*n*Log[F]) /; FreeQ[{F, a, b, c, n}, x]
ADDSPEC IntRubi : IF NIN(Xv,Qa,Qb) Int(exp(Qa+Qb*Xv),Xv) = exp(Qa+Qb*Xv)/Qb
ADDSPEC IntRubi : IF NIN(Xv,Qa,Qb) Int(Kf^(Qa+Qb*Xv),Xv) = Kf^(Qa+Qb*Xv)/(Qb*ln(Kf))

# Int[(c_. + d_.*x_)^m_.*(b_.*F_^(g_.*(e_. + f_.*x_)))^n_., x_Symbol] :=
#    (c + d*x)^m*(b*F^(g*(e + f*x)))^n/(f*g*n*Log[F])
#    - d*m/(f*g*n*Log[F])*Int[(c + d*x)^(m - 1)*(b*F^(g*(e + f*x)))^n, x]
#    /; FreeQ[{F, b, c, d, e, f, g, n}, x] && GtQ[m, 0] && IntegerQ[2*m]
ADDSPEC IntRubi : IF NIN(Xv,Qc,Qd,Qe,Qf), (Qm > 0), (is_int(2*Qm)) \
                  Int((Qc+Qd*Xv)^Qm*exp(Qe+Qf*Xv),Xv) = \
                  (Qc+Qd*Xv)^Qm*exp(Qe+Qf*Xv)/Qf \
                  - Qd*Qm/Qf*Int((Qc+Qd*Xv)^(Qm-1)*exp(Qe+Qf*Xv),Xv)
