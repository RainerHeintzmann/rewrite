# F^(c*(a+b*x)) wird als exp(lin(a,b,x)) (F = e) oder als Kf^lin(a,b,x)
# (Zahl als Basis) geschrieben. c und n aus Rubi sind in lin enthalten
# bzw. hier 1.

# Int[(F_^(c_.*(a_. + b_.*x_)))^n_., x_Symbol] := (F^(c*(a + b*x)))^n/(b*c*n*Log[F]) /; FreeQ[{F, a, b, c, n}, x]
ADDSPEC IntRubi : IntL(exp(lin(Ka,Kb,Xv)),Xv) = exp(lin(Ka,Kb,Xv))*mi(Kb)
ADDSPEC IntRubi : IntL(Kf^lin(Ka,Kb,Xv),Xv)   = Kf^lin(Ka,Kb,Xv)*mi(Kb*ln(Kf))

# Int[(c_. + d_.*x_)^m_.*(b_.*F_^(g_.*(e_. + f_.*x_)))^n_., x_Symbol] :=
#    (c + d*x)^m*(b*F^(g*(e + f*x)))^n/(f*g*n*Log[F])
#    - d*m/(f*g*n*Log[F])*Int[(c + d*x)^(m - 1)*(b*F^(g*(e + f*x)))^n, x]
#    /; FreeQ[{F, b, c, d, e, f, g, n}, x] && GtQ[m, 0] && IntegerQ[2*m]
# Hier F = e, b = g = n = 1. Varianten fuer beide Reihenfolgen der Faktoren
# und fuer m = 1 (ohne Potenz).
ADDSPEC IntRubi : IF ((Km > 0) && is_int(2*Km)) IntL(lin(Kc,Kd,Xv)^Km*exp(lin(Ke,Kf,Xv)),Xv) = \
                  lin(Kc,Kd,Xv)^Km*exp(lin(Ke,Kf,Xv))*mi(Kf) \
                  - Kd*Km*mi(Kf)*IntL(lin(Kc,Kd,Xv)^(Km-1)*exp(lin(Ke,Kf,Xv)),Xv)
ADDSPEC IntRubi : IF ((Km > 0) && is_int(2*Km)) IntL(exp(lin(Ke,Kf,Xv))*lin(Kc,Kd,Xv)^Km,Xv) = \
                  lin(Kc,Kd,Xv)^Km*exp(lin(Ke,Kf,Xv))*mi(Kf) \
                  - Kd*Km*mi(Kf)*IntL(lin(Kc,Kd,Xv)^(Km-1)*exp(lin(Ke,Kf,Xv)),Xv)
ADDSPEC IntRubi : IntL(lin(Kc,Kd,Xv)*exp(lin(Ke,Kf,Xv)),Xv) = \
                  lin(Kc,Kd,Xv)*exp(lin(Ke,Kf,Xv))*mi(Kf) \
                  - Kd*mi(Kf)*IntL(exp(lin(Ke,Kf,Xv)),Xv)
ADDSPEC IntRubi : IntL(exp(lin(Ke,Kf,Xv))*lin(Kc,Kd,Xv),Xv) = \
                  lin(Kc,Kd,Xv)*exp(lin(Ke,Kf,Xv))*mi(Kf) \
                  - Kd*mi(Kf)*IntL(exp(lin(Ke,Kf,Xv)),Xv)
