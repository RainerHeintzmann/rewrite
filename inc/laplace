# inc/laplace (2026): the Laplace transform and its inverse.
# Loaded by inc/all (after inc/limits).
#
#   laplace(f, t, s)      F(s) = Int(f(t)*exp(-s*t), t, 0, infinity)
#   invlaplace(F, s, t)   f(t) with laplace(f, t, s) = F (for t > 0)
#   initial(u, t)         u at t = 0; initial(D(y(t),t), t) stays, so
#                         that the initial values can be given by rules
#
# laplace uses, in this order: linearity, a table (constants, powers of t,
# exp, sin, cos, sinh, cosh, heaviside, dirac), the theorems (shift by
# exp(a*t), multiplication by t, delay by heaviside(t-c), derivatives
# D(y(t),t)), and finally the integral (inc/limits), which needs s > 0
# (SYM s : positive). invlaplace: linearity, the table backwards, the delay
# exp(-c*s), a linear numerator over a quadratic (damped oscillations), and
# partial fractions of rational functions with exact coefficients. A part
# that is not known stays as laplace(...) or invlaplace(...).

ALG LaplaceT
ALG LaplaceBack
ALG InvLaplaceT
ALG Initial
ALG DerivQ
ALG InvQuad
FUNC  laplace    : real,real,real >> real         ATT RULES LaplaceT,LaplaceBack,Initial,(DerivConst,Linear,diff),All
OTHER laplace    : number,number,number >> number ATT RULES LaplaceT,LaplaceBack,Initial,(DerivConst,Linear,diff),All
FUNC  invlaplace : real,real,real >> real         ATT RULES InvLaplaceT,All
OTHER invlaplace : number,number,number >> number ATT RULES InvLaplaceT,All
FUNC  initial    : real,real >> real              ATT RULES Initial
OTHER initial    : number,number >> number        ATT RULES Initial
FUNC  derivq     : real >> bool                   ATT RULES DerivQ     # u is D(..)
OTHER derivq     : number >> bool                 ATT RULES DerivQ
FUNC  lapint     : real,real,real,real >> real         # internal: the integral, f, t, s
OTHER lapint     : number,number,number,number >> number
# invquad(A,B,a,b,c,t): the inverse of (A s + B)/(a s^2 + b s + c), 4 a c > b^2
FUNC  invquad : real,real,real,real,real,real >> real         ATT RULES InvQuad
OTHER invquad : number,number,number,number,number,number >> number ATT RULES InvQuad

COMM +,*

# ---- initial values
PAT _Iu,_It : number
PAT _Ju,_Ja,_Jb : number
SPEC    DerivQ : derivq(D(_Ja,_Jb)) = true
ADDSPEC DerivQ : derivq(_Ju) = false
SPEC    Initial : IF (not(derivq(_Iu))) initial(_Iu,_It) = subst(_Iu,_It,0)

# ---- the transform
PAT _Lf,_Lg,_Lt,_Ls,_Lc,_Le,_Lw,_Li : number
NUMPAT _Ln : number

# linearity
SPEC    LaplaceT : IF (freeq(_Lf,_Lt)) laplace(_Lf,_Lt,_Ls) = _Lf/_Ls
ADDSPEC LaplaceT : laplace(_Lf+_Lg,_Lt,_Ls) = laplace(_Lf,_Lt,_Ls)+laplace(_Lg,_Lt,_Ls)
ADDSPEC LaplaceT : laplace(_Lf-_Lg,_Lt,_Ls) = laplace(_Lf,_Lt,_Ls)-laplace(_Lg,_Lt,_Ls)
ADDSPEC LaplaceT : laplace(-_Lf,_Lt,_Ls) = -laplace(_Lf,_Lt,_Ls)
ADDSPEC LaplaceT : IF (freeq(_Lc,_Lt)) laplace(_Lc*_Lf,_Lt,_Ls) = _Lc*laplace(_Lf,_Lt,_Ls)
ADDSPEC LaplaceT : IF (freeq(_Lc,_Lt)) laplace(_Lf/_Lc,_Lt,_Ls) = laplace(_Lf,_Lt,_Ls)/_Lc
# the table
ADDSPEC LaplaceT : laplace(_Lt,_Lt,_Ls) = 1/_Ls^2
ADDSPEC LaplaceT : IF (_Ln > -1) laplace(_Lt^_Ln,_Lt,_Ls) = Gamma(_Ln+1)/_Ls^(_Ln+1)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)) \
                   laplace(exp(_Le),_Lt,_Ls) = exp(coeff(_Le,_Lt,0))/(_Ls-coeff(_Le,_Lt))
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (eqq(coeff(_Le,_Lt,0),0)) \
                   laplace(sin(_Le),_Lt,_Ls) = coeff(_Le,_Lt)/(_Ls^2+coeff(_Le,_Lt)^2)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (eqq(coeff(_Le,_Lt,0),0)) \
                   laplace(cos(_Le),_Lt,_Ls) = _Ls/(_Ls^2+coeff(_Le,_Lt)^2)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (eqq(coeff(_Le,_Lt,0),0)) \
                   laplace(sinh(_Le),_Lt,_Ls) = coeff(_Le,_Lt)/(_Ls^2-coeff(_Le,_Lt)^2)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (eqq(coeff(_Le,_Lt,0),0)) \
                   laplace(cosh(_Le),_Lt,_Ls) = _Ls/(_Ls^2-coeff(_Le,_Lt)^2)
# sin(k t + m) = sin(k t) cos(m) + cos(k t) sin(m)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)) \
                   laplace(sin(_Le),_Lt,_Ls) = cos(coeff(_Le,_Lt,0))*laplace(sin(coeff(_Le,_Lt)*_Lt),_Lt,_Ls) \
                                             + sin(coeff(_Le,_Lt,0))*laplace(cos(coeff(_Le,_Lt)*_Lt),_Lt,_Ls)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)) \
                   laplace(cos(_Le),_Lt,_Ls) = cos(coeff(_Le,_Lt,0))*laplace(cos(coeff(_Le,_Lt)*_Lt),_Lt,_Ls) \
                                             - sin(coeff(_Le,_Lt,0))*laplace(sin(coeff(_Le,_Lt)*_Lt),_Lt,_Ls)
# step and delta at c = -m/k >= 0 (heaviside(k t + m), k > 0)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (knownpos(coeff(_Le,_Lt))), (knownneg(coeff(_Le,_Lt,0))) \
                   laplace(heaviside(_Le),_Lt,_Ls) = exp(coeff(_Le,_Lt,0)/coeff(_Le,_Lt)*_Ls)/_Ls
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (knownpos(coeff(_Le,_Lt))), (not(knownneg(coeff(_Le,_Lt,0)))) \
                   laplace(heaviside(_Le),_Lt,_Ls) = 1/_Ls
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (knownpos(coeff(_Le,_Lt))), (knownneg(coeff(_Le,_Lt,0))) \
                   laplace(dirac(_Le),_Lt,_Ls) = exp(coeff(_Le,_Lt,0)/coeff(_Le,_Lt)*_Ls)/coeff(_Le,_Lt)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (eqq(coeff(_Le,_Lt,0),0)) \
                   laplace(dirac(_Le),_Lt,_Ls) = 1/abs(coeff(_Le,_Lt))
# the theorems
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)) \
                   laplace(exp(_Le)*_Lf,_Lt,_Ls) = exp(coeff(_Le,_Lt,0))*subst(laplace(_Lf,_Lt,_Ls),_Ls,_Ls-coeff(_Le,_Lt))
ADDSPEC LaplaceT : laplace(_Lt*_Lf,_Lt,_Ls) = -D(laplace(_Lf,_Lt,_Ls),_Ls)
ADDSPEC LaplaceT : IF (igeq(_Ln,2)) laplace(_Lt^_Ln*_Lf,_Lt,_Ls) = -D(laplace(_Lt^(_Ln-1)*_Lf,_Lt,_Ls),_Ls)
ADDSPEC LaplaceT : IF (linearq(_Le,_Lt)), (knownpos(coeff(_Le,_Lt))), (knownneg(coeff(_Le,_Lt,0))) \
                   laplace(heaviside(_Le)*_Lf,_Lt,_Ls) = exp(coeff(_Le,_Lt,0)/coeff(_Le,_Lt)*_Ls) \
                       *laplace(subst(_Lf,_Lt,_Lt-coeff(_Le,_Lt,0)/coeff(_Le,_Lt)),_Lt,_Ls)
ADDSPEC LaplaceT : laplace(D(_Lf,_Lt),_Lt,_Ls) = _Ls*laplace(_Lf,_Lt,_Ls)-initial(_Lf,_Lt)
# the integral, for s > 0; lapint gives the transform back if it stays
ADDSPEC LaplaceT : IF (knownpos(_Ls)), (entireq(_Lf,_Lt)) \
                   laplace(_Lf,_Lt,_Ls) = lapint(Int(_Lf*exp(-_Ls*_Lt),_Lt,0,infinity),_Lf,_Lt,_Ls)
ADDSPEC LaplaceT : IF (freeq(_Li,_Lt)) lapint(_Li,_Lf,_Lt,_Ls) = _Li

# ---- the inverse transform
PAT _Mf,_Mg,_Ms,_Mt,_Mk,_Mh,_Mq,_Me : number
NUMPAT _Mn : number

# linearity
SPEC    InvLaplaceT : invlaplace(_Mf+_Mg,_Ms,_Mt) = invlaplace(_Mf,_Ms,_Mt)+invlaplace(_Mg,_Ms,_Mt)
ADDSPEC InvLaplaceT : invlaplace(_Mf-_Mg,_Ms,_Mt) = invlaplace(_Mf,_Ms,_Mt)-invlaplace(_Mg,_Ms,_Mt)
ADDSPEC InvLaplaceT : invlaplace(-_Mf,_Ms,_Mt) = -invlaplace(_Mf,_Ms,_Mt)
ADDSPEC InvLaplaceT : IF (freeq(_Mf,_Ms)) invlaplace(_Mf,_Ms,_Mt) = _Mf*dirac(_Mt)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(_Mk*_Mf,_Ms,_Mt) = _Mk*invlaplace(_Mf,_Ms,_Mt)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(_Mf/_Mk,_Ms,_Mt) = invlaplace(_Mf,_Ms,_Mt)/_Mk
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)), (neq(_Mk,1)) invlaplace(_Mk/_Mf,_Ms,_Mt) = _Mk*invlaplace(1/_Mf,_Ms,_Mt)
# the delay: exp(-c s) F(s) -> heaviside(t-c) f(t-c)
ADDSPEC InvLaplaceT : IF (linearq(_Me,_Ms)), (eqq(coeff(_Me,_Ms,0),0)), (knownneg(coeff(_Me,_Ms))) \
                      invlaplace(exp(_Me)*_Mf,_Ms,_Mt) = heaviside(_Mt+coeff(_Me,_Ms)) \
                          *subst(invlaplace(_Mf,_Ms,_Mt),_Mt,_Mt+coeff(_Me,_Ms))
ADDSPEC InvLaplaceT : IF (linearq(_Me,_Ms)), (eqq(coeff(_Me,_Ms,0),0)), (knownneg(coeff(_Me,_Ms))) \
                      invlaplace(exp(_Me)/_Mf,_Ms,_Mt) = heaviside(_Mt+coeff(_Me,_Ms)) \
                          *subst(invlaplace(1/_Mf,_Ms,_Mt),_Mt,_Mt+coeff(_Me,_Ms))
# (k s + m)^-n -> t^(n-1) exp(-m t/k) / (Gamma(n) k^n) for n > 0
ADDSPEC InvLaplaceT : IF (linearq(_Mh,_Ms)), (_Mn < 0) invlaplace(_Mh^_Mn,_Ms,_Mt) = \
                      _Mt^(-_Mn-1)*exp(-coeff(_Mh,_Ms,0)/coeff(_Mh,_Ms)*_Mt)/(Gamma(-_Mn)*coeff(_Mh,_Ms)^(-_Mn))
ADDSPEC InvLaplaceT : IF (linearq(_Mh,_Ms)) invlaplace(mi(_Mh),_Ms,_Mt) = \
                      exp(-coeff(_Mh,_Ms,0)/coeff(_Mh,_Ms)*_Mt)/coeff(_Mh,_Ms)
ADDSPEC InvLaplaceT : IF (linearq(_Mh,_Ms)) invlaplace(1/_Mh,_Ms,_Mt) = \
                      exp(-coeff(_Mh,_Ms,0)/coeff(_Mh,_Ms)*_Mt)/coeff(_Mh,_Ms)
ADDSPEC InvLaplaceT : IF (linearq(_Mh,_Ms)), (_Mn > 0) invlaplace(1/_Mh^_Mn,_Ms,_Mt) = \
                      _Mt^(_Mn-1)*exp(-coeff(_Mh,_Ms,0)/coeff(_Mh,_Ms)*_Mt)/(Gamma(_Mn)*coeff(_Mh,_Ms)^_Mn)
# s^2 + k^2 with a symbol k: sine and cosine
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(1/(_Ms^2+_Mk^2),_Ms,_Mt) = sin(_Mk*_Mt)/_Mk
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(_Ms/(_Ms^2+_Mk^2),_Ms,_Mt) = cos(_Mk*_Mt)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace((_Ms^2+_Mk^2)^-1,_Ms,_Mt) = sin(_Mk*_Mt)/_Mk
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(_Ms*(_Ms^2+_Mk^2)^-1,_Ms,_Mt) = cos(_Mk*_Mt)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(1/(_Ms^2-_Mk^2),_Ms,_Mt) = sinh(_Mk*_Mt)/_Mk
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)) invlaplace(_Ms/(_Ms^2-_Mk^2),_Ms,_Mt) = cosh(_Mk*_Mt)
# the resonance: (s^2 + c)^-2 with c = k^2 > 0
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)), (knownpos(_Mk)) invlaplace((_Ms^2+_Mk)^-2,_Ms,_Mt) = \
                      (sin(sqrt(_Mk)*_Mt)-sqrt(_Mk)*_Mt*cos(sqrt(_Mk)*_Mt))/(2*sqrt(_Mk)^3)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)), (knownpos(_Mk)) invlaplace(1/(_Ms^2+_Mk)^2,_Ms,_Mt) = \
                      (sin(sqrt(_Mk)*_Mt)-sqrt(_Mk)*_Mt*cos(sqrt(_Mk)*_Mt))/(2*sqrt(_Mk)^3)
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)), (knownpos(_Mk)) invlaplace(_Ms*(_Ms^2+_Mk)^-2,_Ms,_Mt) = \
                      _Mt*sin(sqrt(_Mk)*_Mt)/(2*sqrt(_Mk))
ADDSPEC InvLaplaceT : IF (freeq(_Mk,_Ms)), (knownpos(_Mk)) invlaplace(_Ms/(_Ms^2+_Mk)^2,_Ms,_Mt) = \
                      _Mt*sin(sqrt(_Mk)*_Mt)/(2*sqrt(_Mk))
# a linear numerator over a quadratic without real roots: complete the square,
# (A s + B)/(a (s-p)^2 + a w^2) -> exp(p t) (A cos(w t) + (B + A p)/w sin(w t))/a
ADDSPEC InvLaplaceT : IF (polyq(_Mq,_Ms,2)), (polyq(_Mf,_Ms)), (ileq(expon(_Mf,_Ms),1)), \
                         (knownpos(normform(4*coeff(_Mq,_Ms,2)*coeff(_Mq,_Ms,0)-coeff(_Mq,_Ms,1)^2))) \
                      invlaplace(_Mf/_Mq,_Ms,_Mt) = invquad(coeff(_Mf,_Ms,1),coeff(_Mf,_Ms,0), \
                          coeff(_Mq,_Ms,2),coeff(_Mq,_Ms,1),coeff(_Mq,_Ms,0),_Mt)
ADDSPEC InvLaplaceT : IF (polyq(_Mq,_Ms,2)), (polyq(_Mf,_Ms)), (ileq(expon(_Mf,_Ms),1)), \
                         (knownpos(normform(4*coeff(_Mq,_Ms,2)*coeff(_Mq,_Ms,0)-coeff(_Mq,_Ms,1)^2))) \
                      invlaplace(_Mf*_Mq^-1,_Ms,_Mt) = invquad(coeff(_Mf,_Ms,1),coeff(_Mf,_Ms,0), \
                          coeff(_Mq,_Ms,2),coeff(_Mq,_Ms,1),coeff(_Mq,_Ms,0),_Mt)
ADDSPEC InvLaplaceT : IF (polyq(_Mq,_Ms,2)), \
                         (knownpos(normform(4*coeff(_Mq,_Ms,2)*coeff(_Mq,_Ms,0)-coeff(_Mq,_Ms,1)^2))) \
                      invlaplace(_Mq^-1,_Ms,_Mt) = invquad(0,1,coeff(_Mq,_Ms,2),coeff(_Mq,_Ms,1),coeff(_Mq,_Ms,0),_Mt)
ADDSPEC InvLaplaceT : IF (polyq(_Mq,_Ms,2)), \
                         (knownpos(normform(4*coeff(_Mq,_Ms,2)*coeff(_Mq,_Ms,0)-coeff(_Mq,_Ms,1)^2))) \
                      invlaplace(1/_Mq,_Ms,_Mt) = invquad(0,1,coeff(_Mq,_Ms,2),coeff(_Mq,_Ms,1),coeff(_Mq,_Ms,0),_Mt)
# other rational functions: partial fractions (exact coefficients)
ADDSPEC InvLaplaceT : IF (rationalfunctionq(_Mf,_Ms)), (sumq(expandintegrand(_Mf,_Ms))) \
                      invlaplace(_Mf,_Ms,_Mt) = invlaplace(expandintegrand(_Mf,_Ms),_Ms,_Mt)

COMM

# (A s + B)/(a s^2 + b s + c) = (A/a (s-p) + B/a + A/a p)/((s-p)^2 + w^2)
# with p = -b/(2a), w^2 = c/a - p^2: exp(p t) (A/a cos(w t) + (B/a + A/a p)/w sin(w t))
PAT _Ha,_Hb,_Hc,_Hd,_He,_Ht : number
SPEC InvQuad : invquad(_Ha,_Hb,_Hc,_Hd,_He,_Ht) = \
    exp(-_Hd/(2*_Hc)*_Ht)*(_Ha/_Hc*cos(sqrt(_He/_Hc-_Hd^2/(4*_Hc^2))*_Ht) \
      + (_Hb/_Hc-_Ha*_Hd/(2*_Hc^2))/sqrt(_He/_Hc-_Hd^2/(4*_Hc^2))*sin(sqrt(_He/_Hc-_Hd^2/(4*_Hc^2))*_Ht))

# an ordinary rule (in a rule list it would count as a cycle): the
# transform stays if the integral stayed
SPEC LaplaceBack : lapint(_Li,_Lf,_Lt,_Ls) = laplace(_Lf,_Lt,_Ls)
