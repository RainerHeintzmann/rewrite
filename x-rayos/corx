# File for Correlating the datas
SYM size,int,a,b,n,maxb,factorial : real
SYM yval,xval : rvector

size=200
maxb=20
DATA "x-rayos/rh10295q.ux"
OUT "x-rayos/rh10295q"


xval=zerovec(size)
yval=zerovec(size)

int=0

FOR n= 0 TO size-1 DO {
DATA a
DATA b
xval=chvec(xval,n,a)
yval=chvec(yval,n,b)
}

factorial=(elem(xval,size-1)-elem(xval,0))/size

FOR n= 0 TO size-1 DO {
n*factorial+elem(xval,0),elem(yval,n)
}

OUT "stdout"

