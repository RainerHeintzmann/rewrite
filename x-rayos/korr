# File for Correlating the datas
CONST size,int,a,b,n,maxb,factorial : real
CONST yval,xval : rvector

size=380
maxb=20
DATA "x-rayos/rh10295w.ux"
OUT "korr-w"


xval=zerovec(size)
yval=zerovec(size)

int=0

FOR n= 0 TO size-1 DO {
DATA a
DATA b
xval=chvec(xval,n,a)
yval=chvec(yval,n,b)
}

factorial=part(yval,maxb,size-maxb)*(2*part(yval,maxb,size-maxb))

FOR b=1 TO maxb-1 DO {
b*(elem(xval,size-1)-elem(xval,0))/size,part(yval,maxb,size-maxb)*(part(yval,maxb-b,size-maxb-b)+part(yval,maxb+b,size-maxb+b))/factorial
}
OUT "stdout"

