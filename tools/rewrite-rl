#!/bin/sh
# rewrite with line editing, a history and TAB completion via rlwrap:
#  - TAB completes keywords and library names (TYP TAB -> TYPEOF), and as in
#    Julia's REPL the LaTeX-like names: \alpha TAB gives α, \al TAB lists them;
#  - the arrow keys browse the earlier lines that begin with what is typed
#    (tools/rewrite.inputrc); the history is kept in ~/.rewrite_history,
#    every line is saved at once.
# In the project folder:  tools/rewrite-rl  (or with files: tools/rewrite-rl my.rw);
# after make install:     rewrite-rl
# Needs rlwrap: in MSYS2  pacman -S rlwrap,  on Linux e.g.  apt install rlwrap
# -b: the word separators without the backslash, so \alpha is one word;
# -f: the words to complete (keywords, library names, \alpha ...), written
#     by tools/gen_words.py; rlwrap completes only with such a list;
# -z: the filter tools/latex.rlwrap replaces a complete \alpha by α and
#     saves every line in the history file;
#     it also colours the prompt, the entered lines and the output;
# -A, -pGreen: the prompt is coloured (also when rlwrap redraws it);
# -a: readline from the start (arrow keys typed while the library loads);
# -i: rewrite stays interactive (under rlwrap its input is no terminal).
here=$(cd "$(dirname "$0")" && pwd)
if [ -f "$here/../share/rewrite/tools/rewrite_words.txt" ]; then
	exe="$here/rewrite"			# installed: bin/rewrite, share/rewrite/tools
	tools="$here/../share/rewrite/tools"
else
	exe="$here/../rewrite.exe"		# the project folder: rewrite(.exe), tools/
	[ -f "$exe" ] || exe="$here/../rewrite"
	tools="$here"
fi
export REWRITE_HISTORY="$HOME/.rewrite_history"
export INPUTRC="$tools/rewrite.inputrc"
# no Windows pseudo console for rewrite: it would ask the terminal for the
# cursor position at the start, and the answer (ESC[1;1R) would end up in the
# input line as "R"; rewrite reads and writes through rlwrap anyway
export MSYS="${MSYS:+$MSYS }disable_pcon"
exec rlwrap -a -A -pGreen -b '(){}[],+-*/=&^%$#@";|?' -f "$tools/rewrite_words.txt" \
     -z "$tools/latex.rlwrap" -H "$REWRITE_HISTORY" "$exe" -i "$@"
