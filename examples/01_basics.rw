# 01_basics.rw: numbers, symbols, terms and sorts
# Run it from the project folder:  rewrite examples/01_basics.rw
INC "inc/all"

"---- a plain expression is calculated"
2^10 + sqrt(16)
sin(pi/2)
1/3 + 1/6

"---- a symbol stands for itself until it gets a value"
SYM r : real
2*pi*r
r = 2
2*pi*r
r = nothing
2*pi*r

"---- a TERM stores a whole expression"
TERM area : real
area = pi*r^2
REWR D(area, r) : All

"---- the sort of a term"
TYPEOF r
TYPEOF 1/2
TYPEOF area
