# 15_series.rw: Taylor polynomials Tay(u, x, a, n) = the sum of
# u^(k)(a)/k! (x-a)^k for k = 0..n, and how good they are
INC "inc/all"

"---- around 0"
REWR Tay(cos(x), x, 0, 8) : All
REWR Tay(exp(x), x, 0, 5) : All
REWR Tay(ln(1+x), x, 0, 5) : All
REWR Tay(tan(x), x, 0, 7) : All
REWR Tay(sqrt(1+x), x, 0, 3) : All      # the binomial series
REWR Tay(exp(-x^2), x, 0, 6) : All      # = Tay(exp(t)) with t = -x^2

"---- around another point, and a product"
REWR Tay(sin(x), x, pi/2, 4) : All
REWR Tay(exp(x)*sin(x), x, 0, 5) : All

"---- the error: exp(1) and the Taylor polynomial of order 6 at x = 1"
TERM p6 : real
p6 = REWR Tay(exp(x), x, 0, 6) : All
PRTNUM "%.10g "
subst(p6, x, 1), exp(1), exp(1) - subst(p6, x, 1)    # 1/7! + 1/8! + ... = 0.000226
PRTNUM "%g "

"---- a Taylor polynomial is a polynomial: its derivative is again one"
REWR deriv(Tay(sin(x), x, 0, 7), x) : All
